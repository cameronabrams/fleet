#!/usr/bin/env python3
"""fleetspawn - bring ONE new session into the fleet: pane, labels, launch.

Prints the plan and does nothing unless given --go. The judgement -- whether the
session should exist, what its role is, what its brief says -- belongs to the
`fleet-bootstrap` skill and to the human. This does only the mechanical part,
which is the part that is easy to get subtly wrong (pane-base-index, labels that
a later restore reads, a launch into the wrong directory).

  fleetspawn NAME DIR --beside PANE                  split beside an existing pane
  fleetspawn NAME DIR --window TITLE                 open a new tmux window
  fleetspawn ... --go                                actually do it
  fleetspawn ... --no-color                          leave /color to be typed by hand
  fleetspawn --check NAME DIR                        verify a spawned session is live
                                                     (exit 3: still at the trust prompt)
  fleetspawn NAME DIR ... --resume UUID              bring a PARKED session back

A name in [retired] is refused. A name in [parked] is refused unless --resume
gives its recorded uuid; afterwards the configuration owner removes the entry.

The brief defaults to <config>/briefs/NAME.md and must exist: a session launched
with no brief has no role, and a role reconstructed later is an inference.

**Nobody should be copying a template and filling it in.** A session's role and
scope are said out loud when someone asks for the session; `--brief-stdin` writes
that down in one command, which is transcription rather than authorship:

    fleetspawn alpha ~/Git/x --window x --color blue --brief-stdin --go <<'MD'
    # alpha -- repo session for x
    ...
    MD

Once the session is live it types `/color <declared>` into its pane -- waiting for
the pane to go idle first, and confirming the color reached the session's own
transcript record. A color that does not apply is reported with the line to type;
it never fails the spawn, because the session is up and only its label is wrong,
and a retry would respawn a live session.

It NEVER answers Claude Code's folder-trust prompt. Trusting a directory grants
an agent read, edit and execute there; that is the human's decision, and on
2026-09-12 the coordinator answered it for a new session before reading that it
should not. If the prompt appears, this stops and says which pane to look at.
"""
import argparse, json, os, shlex, shutil, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet import version_flag
from fleet import panes
from fleet import versions
from fleet.panes import LABELS, agent_label, TRUST_MARKERS
from fleet.procs import claude_procs, named
from fleet.transcripts import agent_color, registry_uuid, session_name, uuid_from_descendants
CFG = fc.load()
STATE = fc.state_dir(CFG)
APP = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BRIEF_EXAMPLE = os.path.join(APP, "examples", "brief.example.md")

# Imported, not restated. This file kept its own identical copy of the tuple, and
# a marker with two homes is a marker that drifts: the two in fleet/panes.py
# already carry different last-checked versions because each was re-checked
# separately after moving. The full captured prompt is a fixture in
# tests/test_fleetspawn.py (claude 2.1.270, 2026-09-13).
# A large resumed session asks whether to resume from a summary (lossy) or in
# full (costly). That choice is the human's (fleet-upgrade skill, section 3).
RESUME_MARKER = "Resume from summary"
# A new session spends its first turns reading its brief, so it is live long
# before it is typeable. These bound the two waits that follow.
COLOR_IDLE_WAIT = 300      # for the first turn to finish and the pane to go idle
COLOR_CONFIRM_WAIT = 20    # for the agent-color record to reach the transcript

def screen_state(screen):
    """'trust' if the folder-trust prompt is showing, 'resume' if the resume-mode
    prompt is, 'banner' if the version banner is (drawn only once a session is
    running), else 'unknown'."""
    if any(m in screen for m in TRUST_MARKERS):
        return "trust"
    if RESUME_MARKER in screen:
        return "resume"
    return "banner" if "Claude Code v" in screen else "unknown"

def running_agents():
    """{name: cwd} from `claude agents --json`, or None if it could not be read.

    The structured source, and the authority on which sessions are actually up --
    the same one `fleet.panes.reconcile` trusts over a parse of a moving TUI. None
    means "could not ask", which is not "nothing is running": the caller falls
    back to the banner rather than concluding anything from it.
    """
    try:
        r = subprocess.run(["claude", "agents", "--json"],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return None
        items = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if isinstance(items, dict):
        items = items.get("agents", [])
    return {a["name"]: a.get("cwd") for a in items if a.get("name")}

# Which tmux server this tool builds on. `fleetrestore` has had this since it
# grew an end-to-end test; `fleetspawn` had not, which is why exercising it by
# hand meant spawning real sessions onto the live fleet -- two of them, on
# 2026-10-20, which then appeared to every other tool as members of a fleet they
# do not belong to. A tool that creates panes and launches sessions needs
# somewhere other than the fleet to be tried out.
SOCKET = None


def tmux(*a):
    argv = ["tmux"] + (["-L", SOCKET] if SOCKET else []) + list(a)
    # `$TMUX` is set inside any pane, so a run from a pane on ANOTHER server would
    # silently build there. Clearing it makes tmux use the socket a plain shell
    # would, which is where the fleet lives; TMUX_TMPDIR still selects a directory.
    env = dict(os.environ)
    env.pop("TMUX", None)
    r = subprocess.run(argv, capture_output=True, text=True, env=env)
    return r.returncode, r.stdout.strip(), r.stderr.strip()

def preflight(a, brief):
    problems = []
    if not os.path.isdir(a.dir):
        problems.append(f"directory does not exist: {a.dir} (create it, and git init if it is a repo)")
    # `--brief-stdin` has already written it, or said it would. Blocking on a
    # file this same run is about to create is the `--color` contradiction again:
    # "would write 12 lines of brief" three rows above "BLOCKED: no brief".
    if not os.path.isfile(brief) and not getattr(a, "brief_stdin", False):
        problems.append(f"no brief at {brief} -- pass --brief-stdin and write one "
                        f"from what the session is for, or --brief-from-example")
    if not fc.colors(fc.load()).get(a.name) and not getattr(a, "color", None):
        # `and not a.color`: with `--color` given, the run above has already said
        # it would declare one, and a BLOCKED line three rows later saying there
        # is none reads as the flag having been ignored. It is the first thing a
        # new fleet hits -- `fleetinit` empties `[colors]`, so the very first
        # spawn always lands here -- and a contradiction at that moment is a
        # contradiction with nothing else on screen to weigh it against.
        #
        # Still refused when `--color` is absent: a color is how a human tells
        # two panes apart at a glance, and a fleet that silently grows an
        # undeclared session has lost that.
        problems.append(f'no color declared -- add  {a.name} = "<color>"  under [colors] '
                        f"in fleet.toml ({', '.join(fc.COLORS)}), "
                        f"or pass --color <color>")
    rc, _, _ = tmux("has-session")
    if rc != 0:
        problems.append("no tmux server running")
    # By the name each session answers to now, which /rename changes and argv does not.
    clash = [(p, c) for p, c, v in claude_procs() if session_name(p, c, v)[0] == a.name]
    if clash:
        problems.append(f"a claude named {a.name!r} is already running: "
                        + ", ".join(f"pid {p} in {c}" for p, c in clash))
    rc, labels, _ = tmux("list-panes", "-a", "-F", LABELS)
    taken = {agent_label(l.split("\t")[0]) for l in labels.splitlines()}
    if a.name in taken:
        problems.append(f"a pane is already labeled @agent={a.name}")
    stopped = fc.stopped(CFG)
    rec = stopped.get(a.name)
    if rec and rec["state"] == "retired":
        problems.append(f"{a.name} is retired since {rec['since']} -- to reuse the name for a "
                        f"new session, remove [retired.{a.name}] from fleet.toml first")
    elif rec and not getattr(a, "resume", None):
        problems.append(f"{a.name} is parked since {rec['since']} -- bring it back with "
                        f"--resume {rec['uuid']}")
    elif rec and a.resume != rec["uuid"]:
        problems.append(f"{a.name} is parked with transcript {rec['uuid']}, not {a.resume}")
    owner = fc.stopped_uuids(CFG).get(getattr(a, "resume", None) or "")
    if owner and owner[0] != a.name:
        problems.append(f"transcript {a.resume} belongs to [{owner[1]}.{owner[0]}]")
    if a.beside:
        rc, _, _ = tmux("display-message", "-p", "-t", a.beside, "#{pane_id}")
        if rc != 0:
            problems.append(f"no such pane: {a.beside}")
    return problems

def claude_cmd():
    """(command, why) -- the binary to launch, and what that choice was.

    The fleet runs the newest release that has SOAKED, not the newest release, so
    a launch names that version explicitly instead of taking whatever the
    installer's symlink points at. An unpark was the fleet's main uncontrolled
    route onto a fresh binary (2026-10-16); pinning brings it under the same
    policy as a roll.

    **Falls back to bare `claude` and says so.** A named version can be absent --
    pruned, or a fresh machine, or an npm install with no version store at all --
    and a session that refuses to start because a pinned release is missing is a
    far worse outcome than one that starts on a fresh binary.
    """
    version, path = versions.target()
    if path and os.path.exists(path):
        return shlex.quote(path), "pinned to %s, the newest soaked release" % version
    if version:
        return "claude", ("target %s is gone from the version store; "
                          "falling back to whatever `claude` resolves to" % version)
    return "claude", ("nothing has soaked yet (or there is no version store); "
                      "falling back to whatever `claude` resolves to")


def launch_cmd(a, brief):
    spawn = CFG.get("spawn", {})
    env = fc.launch_env(CFG)
    claude, _why = claude_cmd()
    if getattr(a, "resume", None):
        # A resumed session continues its own conversation; no first prompt.
        return " ".join(x for x in (env, claude, "--name", shlex.quote(a.name),
                                    "--resume", shlex.quote(a.resume)) if x)
    prompt = spawn.get("first_prompt",
                       "You are a new fleet session named {name}. "
                       "Read {brief} and follow it.").format(name=a.name, brief=brief)
    return " ".join(x for x in (env, claude, "--name", shlex.quote(a.name),
                                shlex.quote(prompt)) if x)

def wait_for(pane, name, directory, timeout):
    """Poll until the session is live in the right directory, or the trust prompt
    shows. Returns ('live', pid) | ('trust', None) | ('timeout', None)."""
    t_end = time.time() + timeout
    while time.time() < t_end:
        _, screen, _ = tmux("capture-pane", "-p", "-t", pane)
        state = screen_state(screen)
        if state in ("trust", "resume"):
            return state, None
        # Asked only once the screen-only states are ruled out: those are the two
        # things `claude agents` cannot see, and they end the wait either way.
        agents = running_agents()
        # The process exists BEFORE the trust prompt renders, and the echoed launch
        # line already contains the name -- so neither is evidence of startup.
        # Two things are:
        #
        #   the banner   drawn only once a session is running -- but drawn ONCE,
        #                and scrolled away by the session's own first output. It
        #                was the only signal until 2026-10-07, which made every
        #                `--resume` time out: replaying a conversation fills the
        #                pane before the first poll. A signal destroyed by the
        #                event it reports cannot be waited for.
        #   claude agents  the structured source, which keeps saying so.
        #
        # Either will do. The banner is kept because it still means what it meant,
        # and because it is the fallback when `claude agents` cannot be read --
        # dropping it would trade one unreachable readiness state for another.
        # Membership only. The DIRECTORY is decided by the process loop below, and
        # checking it here as well was redundant -- no case could distinguish the
        # two, which is how it was caught. It was also the unsafe redundancy: an
        # extra condition can only withhold readiness, and withholding readiness
        # from a session that is up is the failure this whole change is about.
        if state == "banner" or (agents is not None and name in agents):
            for p, c, v in claude_procs():
                if named(v, name) and os.path.realpath(c) == os.path.realpath(directory):
                    return "live", p
        time.sleep(2)
    return "timeout", None

def wait_idle(pane, name, timeout):
    """Poll until `pane` is safe to type into. None when it is, else why it is not.

    `panes.screen_state` is the same reader `fleetnudge` uses, so idle means the
    same thing to both: not mid-turn, no dialog, and an empty input line. This
    module's own `screen_state` answers a different question (did it START) and
    the two must not be confused -- a session can be past the banner and still
    thirty seconds from being typeable.
    """
    t_end = time.time() + timeout
    state = "no-pane"
    while time.time() < t_end:
        state = panes.screen_state(tmux(*panes.CAPTURE, "-t", pane)[1])
        if state == "idle":
            return None
        if state == "trust":
            break          # waiting cannot clear it; it is the human's to answer
        time.sleep(2)
    return panes.state_problem(state, name, pane) or f"pane {pane} never went idle"

def session_uuid(pid):
    """The transcript of the session at `pid`, from its own registry entry, else
    from a descendant's scratchpad path.

    The registry first, and the order is the whole point. `uuid_from_descendants`
    needs a live CHILD process, which a session has only while it is mid-tool-call
    -- precisely what we have just finished waiting for it not to be. Measured on
    14 live sessions (2026-10-13): the registry answered for 14, the descendant
    walk for 1, and that one was the only session doing work. The walk stays as
    the fallback because it reads a path HANDED to the session, which is evidence
    of a different kind, and it is what answered here before the registry was
    known about.
    """
    return registry_uuid(pid) or uuid_from_descendants(pid)

def apply_color(pane, name, pid, color, idle_wait, confirm_wait=COLOR_CONFIRM_WAIT):
    """Type `/color COLOR` into a newly spawned session. None on success, else why not.

    claude has no `--color` flag, so the color can only be typed, and typed blind
    it is unsafe: keys sent while a session works its first prompt arrive
    corrupted or land as prompt text (observed 2026-09-07). That hazard is why
    this tool used to print the line instead of typing it. It is now solved rather
    than avoided -- `panes.type_line` reads the input line back and confirms it
    holds exactly the intended text before Enter, and clears it if it does not.

    **Success is the session's own agent-color record**, the one `fleetsnap`
    reads. Not the keystrokes going out: sending keys cannot fail, and a check
    that cannot fail is not evidence of anything.
    """
    uuid = session_uuid(pid)
    if uuid and agent_color(uuid) == color:
        return None                   # a resumed session carries its color forward
    problem = wait_idle(pane, name, idle_wait)
    if problem:
        return problem
    problem = panes.type_line(tmux, pane, f"/color {color}")
    if problem:
        return problem
    tmux("send-keys", "-t", pane, "C-m")
    uuid = uuid or session_uuid(pid)
    if not uuid:
        return f"typed it, but found no transcript for pid {pid} to confirm it from"
    t_end = time.time() + confirm_wait
    while time.time() < t_end:
        if agent_color(uuid) == color:
            return None
        time.sleep(1)
    return (f"typed it, but transcript {uuid[:8]} still records "
            f"{agent_color(uuid) or 'no color'} after {confirm_wait}s")

def declare_color(a):
    """Put `NAME = "<color>"` under [colors] if it is not there already.

    This is the refusal `fleetspawn` hands back most often, and the fix was a hand
    edit of the one file every tool parses at startup. The human still chooses the
    color -- they typed it on this command line; the tool only writes it where the
    declaration lives.

    **Appended and verified, never rewritten.** `fleet.config.declare` refuses a
    file that does not already parse, refuses unless exactly one line is exactly
    `[colors]`, refuses to change a declaration that is already there, and proves
    the result parses in a temp file before it replaces anything.
    """
    if a.color not in fc.COLORS:
        sys.exit("\n  REFUSED: %r is not a color /color accepts (%s)\n"
                 % (a.color, ", ".join(fc.COLORS)))
    path = os.path.join(fc.config_dir(), "fleet.toml")
    if not a.go:
        have = fc.colors(fc.load()).get(a.name)
        print("  color  would declare %s = %r under [colors]%s"
              % (a.name, a.color,
                 "" if not have else "  (already %r)" % have))
        return
    ok, why = fc.declare(path, "colors", a.name, a.color)
    print("  color  %s" % why)
    if not ok:
        sys.exit("\n  the color was not declared, so the spawn would fail preflight.\n"
                 "  Fix it by hand and re-run.\n")


def write_brief(a, brief):
    """Write the brief from stdin, before preflight. Returns None, or exits.

    **The human should never copy a template and fill it in.** A session's brief
    is its identity -- role, scope, territory, who it answers to -- and all of
    that is said out loud when someone asks for a session. An agent that hears
    "spin up a repo session for X that owns the parser and reports bugs to Y" has
    been given the brief; writing it down is transcription, not authorship, and
    handing back a markdown template instead is asking the human to do the one
    part of this that was already done.

    Out-of-context on purpose. What was said interactively lives in a transcript,
    and transcripts compact; the brief is the copy that survives a restart, a
    `/clear` and a power cycle, which is why `fleetsnap` lists it first among a
    session's durable files.

    Three refusals, and each is a failure that is quieter than the refusal:

    * **nothing on stdin** -- a session whose brief says nothing is told its role
      is nothing, and `[spawn].first_prompt` still sends it there to look.
    * **the shipped example, verbatim** -- a session told that its role is to
      fill itself in. That fails as a session which behaves plausibly and owns
      nothing in particular, where a missing brief fails at preflight.
    * **a brief already there** -- somebody's work, and never this tool's to
      overwrite.
    """
    if os.path.exists(brief):
        sys.exit("\n  brief already exists: %s\n  Not overwritten -- edit it, or "
                 "remove it first.\n" % brief)
    text = sys.stdin.read()
    if not text.strip():
        sys.exit("\n  nothing on stdin. A brief that says nothing is a session "
                 "told its role is nothing.\n")
    try:
        with open(BRIEF_EXAMPLE) as f:
            if text.strip() == f.read().strip():
                sys.exit("\n  that is the shipped example, unchanged. The brief is "
                         "the session's\n  role, scope and territory -- write what "
                         "this one is actually for.\n")
    except OSError:
        pass                      # the example is missing; not a reason to refuse
    lines = len(text.splitlines())
    if not a.go:
        print("  would write %d line(s) of brief -> %s" % (lines, brief))
        return
    try:
        os.makedirs(os.path.dirname(brief), exist_ok=True)
        with open(brief, "w") as f:
            f.write(text if text.endswith("\n") else text + "\n")
    except OSError as e:
        sys.exit("\n  could not write %s: %s\n" % (brief, e.strerror or e))
    print("  wrote %s (%d lines)" % (brief, lines))


def do_brief_from_example(a, brief):
    """Copy the brief template into place and STOP.

    Scaffolding the FILE is a kindness; writing its content is the thing the
    refusal exists to force. `[spawn].first_prompt` tells a session to read its
    brief and follow it, so a template brief is a session told that its role is
    "fill me in" -- and that fails QUIETLY, as a session which behaves plausibly
    and owns nothing in particular, where a missing brief fails at preflight.
    """
    if os.path.exists(brief):
        print("\n  brief already exists: %s\n  Not overwritten.\n" % brief)
        return 2
    if not a.go:
        print("\n  would copy %s\n            -> %s\n\n  plan only -- re-run with --go\n"
              % (BRIEF_EXAMPLE, brief))
        return 0
    try:
        os.makedirs(os.path.dirname(brief), exist_ok=True)
        shutil.copyfile(BRIEF_EXAMPLE, brief)
    except OSError as e:
        print("\n  could not copy the template: %s\n" % (e.strerror or e))
        return 4
    print("\n  copied %s\n      -> %s" % (BRIEF_EXAMPLE, brief))
    print("\n  NOT SPAWNED. Edit that file first -- it is a template, and a session")
    print("  launched against it is told its role is to fill itself in. Then:")
    print("    fleetspawn %s %s --window <title> --go\n" % (a.name, a.dir))
    return 0


def adoption_kind(resume):
    """(from, note) for the adoption line: an unpark and a fresh spawn are
    different events and the log has to tell them apart.

    A function rather than two conditionals at the call site, so there is
    something a test can call. The first version of that test re-evaluated the
    expression itself and would have passed against any behavior at all.

    `from=parked` is honest rather than lazy: a parked session is not running, so
    nothing here can know which binary it was on before.
    """
    return ("parked", "unpark") if resume else ("new", "spawn")


def check(a):
    hits = [(p, c, v) for p, c, v in claude_procs() if session_name(p, c, v)[0] == a.name]
    if not hits:
        print(f"  NOT RUNNING: no claude process named {a.name!r}")
        return 1
    rc = 0
    for p, c, v in hits:
        ok = os.path.realpath(c) == os.path.realpath(a.dir)
        print(f"  pid {p}  cwd {c}  {'ok' if ok else 'WRONG DIRECTORY, expected ' + a.dir}")
        rc |= 0 if ok else 1
    if len(hits) > 1:
        print(f"  {len(hits)} processes answer to {a.name!r}: peers will be refused by name")
        rc = 1
    # Tab-separated, not space: an empty label collapses two space separators into
    # one, so a pane with no @agent would put the NEXT field at position 1 and the
    # fallback label would read as the agent name. The same collapse made a hand-
    # written preview of the @agent re-stamp report "0 panes to stamp" on a fleet
    # where all fourteen needed it (2026-10-01).
    _, rows, _ = tmux("list-panes", "-a", "-F", "#{pane_id}\t" + LABELS)
    row = next((r for r in rows.splitlines()
                if agent_label((r.split("\t") + [""])[1]) == a.name), None)
    print(f"  pane labels: {row or 'NONE -- no pane carries @agent=' + a.name}")
    # A process named right, in the right directory, exists BEFORE the trust prompt
    # is answered, so everything above passes a session that has not started.
    # Observed 2026-09-13: --check exited 0 on a session sitting at the prompt.
    if row:
        _, screen, _ = tmux("capture-pane", "-p", "-t", row.split()[0])
        if screen_state(screen) == "trust":
            print(f"  TRUST-PENDING: pane {row.split()[0]} shows the folder-trust prompt.")
            print("  That is the human's to answer; re-run --check afterwards.")
            return 3
    print("  next: ListAgents should list it by name; then fleetsnap")
    return rc

def main():
    version_flag()
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("name")
    ap.add_argument("dir")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--beside", metavar="PANE", help="split this pane, e.g. %%9")
    g.add_argument("--window", metavar="TITLE", help="open a new window with this name")
    ap.add_argument("--split", choices=("v", "h"), default="v",
                    help="with --beside: v = below (default), h = to the right")
    ap.add_argument("--brief", help="default: <config>/briefs/NAME.md")
    ap.add_argument("--brief-stdin", action="store_true",
                    help="read the brief from stdin and write it before spawning, "
                         "so nobody has to copy a template and fill it in")
    ap.add_argument("--color", metavar="C",
                    help="declare this color for NAME under [colors] if it is not "
                         "declared yet (appended, never rewritten)")
    ap.add_argument("--create-dir", action="store_true",
                    help="create DIR if it does not exist. The folder-trust prompt "
                         "still stops the spawn, so the grant stays the human's.")
    ap.add_argument("--brief-from-example", action="store_true",
                    help="copy the brief template into place and STOP. It does not "
                         "spawn: a template brief is a role nobody has written.")
    ap.add_argument("--wait", type=int, default=60, help="seconds to wait for startup")
    ap.add_argument("--color-wait", type=int, default=COLOR_IDLE_WAIT, metavar="S",
                    help="seconds to wait for the new session to go idle before typing /color")
    ap.add_argument("--no-color", action="store_true",
                    help="do not type /color; print the line to type by hand instead")
    ap.add_argument("--socket", metavar="NAME",
                    help="build on the tmux server at this socket (tmux -L NAME) "
                         "instead of the default one -- the way to try this tool "
                         "out without spawning into the live fleet")
    ap.add_argument("--go", action="store_true")
    ap.add_argument("--check", action="store_true", help="verify only; change nothing")
    ap.add_argument("--resume", metavar="UUID", help="resume a parked session's transcript")
    a = ap.parse_args()
    global SOCKET
    SOCKET = a.socket
    a.dir = os.path.realpath(os.path.expanduser(a.dir))
    if a.check:
        sys.exit(check(a))
    if not (a.beside or a.window):
        ap.error("one of --beside/--window is required")
    brief = os.path.expanduser(a.brief or os.path.join(fc.config_dir(), "briefs", f"{a.name}.md"))

    # Scaffolding runs BEFORE preflight, so preflight judges what will exist
    # rather than what did. Each step is reported; none is silent.
    if a.create_dir and not os.path.isdir(a.dir):
        if a.go:
            try:
                os.makedirs(a.dir, exist_ok=True)
                print(f"  created {a.dir}")
            except OSError as e:
                sys.exit(f"\n  could not create {a.dir}: {e.strerror or e}\n")
        else:
            print(f"  would create {a.dir}")
    if a.brief_from_example:
        sys.exit(do_brief_from_example(a, brief))
    if a.brief_stdin:
        write_brief(a, brief)
    if a.color:
        declare_color(a)

    problems = preflight(a, brief)
    print(f"\n  spawn {a.name}  in {a.dir}")
    print(f"  brief {brief}")
    # Re-read, because --color may have just declared it. The module-level CFG is
    # the state of the file at import, and this line is printed after the
    # scaffolding has run -- the same staleness that had a watched board listing a
    # session as parked 22 hours after it was unparked (f5c7201).
    declared = fc.colors(fc.load()).get(a.name)
    # `--color` is reported as PENDING, not as absent. In a preview nothing has
    # been written yet, so the configuration honestly says there is no color --
    # and printing "NOT DECLARED" two lines under "would declare alpha = 'blue'"
    # reads as the flag having been ignored. The first spawn of a new fleet always
    # hits this, because `fleetinit` ships `[colors]` empty.
    shown = declared or (f"{a.color} (pending --go)" if getattr(a, "color", None)
                         else "NOT DECLARED")
    print(f"  color {shown}"
          + ("" if not (declared or getattr(a, "color", None)) else
             "  (left to be typed by hand)" if a.no_color else
             f"  (typed into the pane once idle, up to {a.color_wait}s)"))
    print(f"  place {'split ' + a.split + ' beside ' + a.beside if a.beside else 'new window ' + a.window}")
    print(f"  cmd   {launch_cmd(a, brief)}")
    print(f"  claude {claude_cmd()[1]}\n")
    if problems:
        for p in problems:
            print(f"  BLOCKED: {p}")
        sys.exit(2)
    if not a.go:
        print("  plan only -- re-run with --go\n")
        return

    if a.beside:
        rc, pane, err = tmux("split-window", f"-{a.split}", "-d", "-t", a.beside,
                             "-c", a.dir, "-P", "-F", "#{pane_id}")
    else:
        rc, pane, err = tmux("new-window", "-d", "-n", a.window, "-c", a.dir,
                             "-P", "-F", "#{pane_id}")
        if rc == 0:
            tmux("set-window-option", "-t", pane, "automatic-rename", "off")
    if rc != 0:
        sys.exit(f"  tmux failed: {err}")
    # `@fleet` alongside `@agent`, so another fleet's tools on this machine can
    # tell this pane is not theirs -- and ours can tell theirs. Set at creation
    # because that is the only moment the spawning configuration is known for
    # certain; a pane labeled later is labeled from a guess.
    ours = fc.fleet_name(fc.load())
    opts = [("@agent", a.name), ("@muted", "0")]
    if ours:
        opts.append(("@fleet", ours))
    for opt, val in opts:
        tmux("set-option", "-p", "-t", pane, opt, val)
    if not ours:
        print("  note: this fleet has no name ([fleet].name or [mail].fleet), so the")
        print("        pane carries no @fleet and another fleet's tools cannot tell")
        print("        it apart from their own.")
    tmux("select-pane", "-t", pane, "-T", a.name)
    tmux("send-keys", "-t", pane, launch_cmd(a, brief), "C-m")
    print(f"  created pane {pane}, launched; waiting up to {a.wait}s ...")

    state, pid = wait_for(pane, a.name, a.dir, a.wait)
    if state == "trust":
        print(f"\n  STOPPED at the folder-trust prompt in pane {pane}.")
        print(f"  That is the human's decision, not the agent's. Answer it in the pane,")
        print(f"  then run:  fleetspawn --check {shlex.quote(a.name)} {shlex.quote(a.dir)}\n")
        sys.exit(3)
    if state == "resume":
        print(f"\n  STOPPED at the resume-mode prompt in pane {pane}: summary (lossy) or full")
        print(f"  (costly) is the human's choice. Answer it, then run:")
        print(f"  fleetspawn --check {shlex.quote(a.name)} {shlex.quote(a.dir)}\n")
        sys.exit(5)
    if state == "timeout":
        print(f"\n  TIMED OUT: no live claude named {a.name!r} in {a.dir} after {a.wait}s.")
        # What was actually checked, so a false timeout is legible as one. This
        # message fired on seven successful resumes before 2026-10-07 and said
        # only that nothing was found, which reads as "it did not start".
        ag = running_agents()
        if ag is None:
            print("  (`claude agents` could not be read, so only the startup banner")
            print("   was available as evidence, and that scrolls away.)")
        elif a.name in ag:
            print(f"  BUT `claude agents` lists {a.name!r} in {ag[a.name]} -- if that is")
            print(f"  the directory you asked for, it IS up and this message is wrong.")
            print(f"  Confirm with:  fleetspawn --check {shlex.quote(a.name)} {shlex.quote(a.dir)}")
        print(f"  Look at pane {pane}; do not relaunch until you know why.\n")
        sys.exit(4)
    print(f"  live: pid {pid} in {a.dir}")

    # Every launch here puts a session onto whatever `claude` resolves to -- there
    # is no version argument and none is wanted; a park/unpark is a human act with
    # its own reasons and making it wait on a soak would be the wrong trade. But it
    # IS an adoption, and until 2026-10-16 it was an invisible one: the fleet's
    # whole version spread came from unparks, and the log meant to show adoptions
    # recorded `rolled=none` in the minute before one happened.
    #
    # Read from the running process, not from `installed()`: between composing the
    # command and the session coming up, the answer can have changed, and the
    # question is which binary this session is on.
    ran = versions.of_pid(pid)
    frm, note = adoption_kind(a.resume)
    # `to` used to be a pure readout. With a pinned launch it is also a CHOICE,
    # so the two can disagree -- a stale pane, a fallback, a binary swapped under
    # the launch -- and a log that recorded only one of them could not show it.
    want = versions.target()[0]
    if want and ran and ran != want:
        note += " MISMATCH (meant %s)" % want
    # `kind=` explicitly, so nothing downstream has to infer it from the note.
    # A daily cap on the auto-roll reads this log, and a spawn is not a roll:
    # counting one would block the roll on any day a session was created.
    problem = versions.record_adoption(STATE, a.name, ran, frm, note,
                                       kind="unpark" if a.resume else "spawn")
    if problem:
        # Said, not swallowed, and it does not fail the spawn: the session is up.
        print(f"  adoption not logged: {problem}")
    else:
        print(f"  adoption logged: {a.name} on {ran or '?'}")

    # Re-read, and tolerate its absence. `--color` may have declared it minutes
    # ago, after the module-level CFG was loaded -- and this line runs AFTER the
    # pane is made and the session launched, so a KeyError here kills the tool
    # with a live session already up. Found by a test asserting no color is read
    # from the import-time configuration; the end-to-end run before it passed
    # only because an earlier run had left the declaration in place.
    color = fc.colors(fc.load()).get(a.name)
    if not color:
        print(f"  color: not declared for {a.name}; the session is up and unlabeled.")
        print(f"         Declare it, then type /color yourself in pane {pane}.")
        print("  next: ListAgents to confirm the name; then fleetsnap (it checks the color)\n")
        return
    if a.no_color:
        print(f"  color: not typed (--no-color). Type  /color {color}  in pane {pane} once idle.")
    else:
        print(f"  color: waiting for {a.name} to go idle, then typing /color {color} ...")
        problem = apply_color(pane, a.name, pid, color, a.color_wait)
        if problem:
            # The session is up and correct; only its color is not. The spawn is
            # not failed over a label -- a retry would respawn a live session,
            # which is a worse outcome than a pane that is the wrong color.
            print(f"  COLOR NOT APPLIED: {problem}")
            print(f"  everything else is fine -- type  /color {color}  in pane {pane} yourself")
        else:
            print(f"  color: {color}, confirmed in the session's own transcript record")
    print("  next: ListAgents to confirm the name; then fleetsnap (it checks the color)\n")

if __name__ == "__main__":
    main()
