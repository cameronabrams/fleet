#!/usr/bin/env python3
"""fleetsnap - snapshot enough state to rebuild the agent fleet after a power cycle.

Must run while the fleet is HEALTHY. The pane -> transcript mapping only exists in
live process arguments; once tmux dies it is unrecoverable. Writes:

    ~/.local/state/fleet/manifest.json   machine-readable
    ~/.local/state/fleet/manifest.md     human-readable, for when nothing is running
"""
import json, os, re, shutil, subprocess, glob, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet.agents import list_agents
from fleet.procs import proc_cwd
from fleet.transcripts import agent_color, newest_transcript, resume_handle, session_name
CFG = fc.load()

STATE = fc.state_dir(CFG)

def sh(*a, **kw):
    return subprocess.run(a, capture_output=True, text=True, **kw).stdout

def rotate(path, keep=10):
    """Keep history of the file the whole recovery path depends on.

    Every other file in STATE has .bak copies; manifest.json had none, so it was
    the one file a bad snapshot could destroy. 2026-09-09: a re-snap taken over
    window names that automatic-rename had already overwritten wiped the only
    copy holding the real ones. Recovered from a session transcript, by luck."""
    if not os.path.exists(path):
        return None
    dest = f"{path}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.copy2(path, dest)
    for old in sorted(glob.glob(f"{path}.bak-*"))[:-keep]:
        try:
            os.remove(old)
        except OSError:
            pass
    return dest


def prior_snapshot():
    """The manifest we are about to overwrite — consulted, not trusted."""
    try:
        with open(f"{STATE}/manifest.json") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def window_meta():
    """Name, layout, and whether tmux is free to rewrite the name.

    automatic-rename ON means the name you are reading is the running command,
    not a name anyone chose. Recording it as a window name is what makes the
    loss permanent, since the next restore rebuilds windows called 'claude'."""
    out = {}
    txt = sh("tmux", "list-windows", "-a", "-F",
             "#{session_name}\t#{window_index}\t#{window_name}\t"
             "#{?automatic-rename,1,0}\t#{window_layout}")
    for row in txt.strip().splitlines():
        p = row.split("\t")
        if len(p) == 5:
            out[f"{p[0]}:{p[1]}"] = {"name": p[2], "auto": p[3] == "1", "layout": p[4]}
    return out


def keep_real_window_names(meta, prior, only):
    """Never let an auto-generated name overwrite a real one in the record.

    Where tmux is auto-naming and the previous manifest holds a deliberate name,
    the previous name is the better record and is carried forward. The warning
    fires either way: the fix belongs in tmux, not in the manifest.

    `only` is the set of windows that actually hold a captured session. Scratch
    windows are auto-named by design and warning about them every run is how a
    warning gets trained into background noise — which is the failure this guard
    exists to prevent, not one to reproduce."""
    prior_names = {k: v.get("name") for k, v in
                   (prior.get("window_layouts") or {}).items() if v.get("name")}
    notes = []
    for key, w in meta.items():
        if not w["auto"] or key not in only:
            continue
        old = prior_names.get(key)
        if old and old != w["name"]:
            notes.append(f"{key}: tmux reports {w['name']!r} (automatic-rename is ON) — "
                         f"kept {old!r} from the previous manifest")
            w["name"], w["carried_forward"] = old, True
        else:
            notes.append(f"{key}: automatic-rename is ON, so {w['name']!r} is the running "
                         f"command, not a name. Fix it in tmux, then re-snap:\n"
                         f"        tmux rename-window -t {key} <name> && "
                         f"tmux set -w -t {key} automatic-rename off")
    return notes


def window_layouts(meta):
    """tmux's own layout serialization — restores geometry exactly, not approximately."""
    return {k: {"name": v["name"], "layout": v["layout"]} for k, v in meta.items()}

def pane_rows():
    fmt = "\t".join(["#{session_name}", "#{window_index}", "#{window_name}",
                     "#{pane_index}", "#{pane_id}", "#{@repo}", "#{@fleet}", "#{pane_title}",
                     "#{pane_current_path}", "#{pane_pid}", "#{pane_width}x#{pane_height}"])
    return [r.split("\t") for r in sh("tmux", "list-panes", "-a", "-F", fmt).strip().splitlines()]

def claude_proc(pane_pid):
    pids = [pane_pid] + sh("pgrep", "-P", pane_pid).split()
    for pid in pids:
        try:
            cmd = open(f"/proc/{pid}/cmdline", "rb").read().decode().split("\0")
        except OSError:
            continue
        if any("claude" in c for c in cmd if c):
            exe = os.path.realpath(f"/proc/{pid}/exe") if os.path.exists(f"/proc/{pid}/exe") else ""
            uuid = next((c for c in cmd if re.fullmatch(r"[0-9a-f-]{36}", c or "")), None)
            started = sh("ps", "-o", "lstart=", "-p", pid).strip()
            return {"pid": int(pid), "version": os.path.basename(exe),
                    "resume_uuid": uuid, "started": started,
                    "argv": [c for c in cmd if c]}
    return None

def corrected_label(repo, title, argv, cwd):
    """(label, note): the pane's @repo label, or the pane title where the label is stale.

    @repo is a hand-set label and goes stale on rename; pane_title is set by
    the app from `claude --name` and follows `/rename`. But a title is not always
    the app's: before claude draws, it is the shell's `user@host:path`, or tmux's
    bare hostname while the trust prompt is up. "No spaces, so it looks like a
    name" passed both -- OBSERVED 2026-09-13, a manifest named a session after a
    host and path. So the title replaces the label only on positive evidence that
    it IS this session's name: the process was launched `--name <title>`, or a
    transcript in its project self-reports it (a /rename since launch)."""
    t = title.lstrip("✳✴✵ ").strip()
    if not (t and repo and t != repo and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", t)):
        return repo, None
    launched = next((argv[i + 1] for i, x in enumerate(argv[:-1]) if x == "--name"), None)
    if launched == t:
        return t, f"pane label said {repo!r}; corrected from pane_title (= --name)"
    if newest_transcript(cwd, t)[1].startswith("verified"):
        return t, f"pane label said {repo!r}; corrected from pane_title (transcript self-reports it)"
    return repo, None

def shown(s):
    """A session's label for display: never a made-up name for an unnamed pane."""
    return s["label"] or f"(unnamed, pane {s['tmux']['pane_id']})"

def resolve_label(repo, title, proc, cwd, agents):
    """(label or None, note): what this session is called.

    `@repo` is the hand-set pane label and wins when it is there (corrected by the
    pane title, above). A pane launched as a bare `claude`, named later, has NO
    label -- OBSERVED 2026-09-18, when fleetsnap invented "(unlabeled %21)" for a
    session fleetupgrade resolved as `literature`, and then asked the reader to
    write a brief under that invented name. So fall back to the sources that carry
    a name the session answers to, and to None rather than to a fiction."""
    if repo:
        return corrected_label(repo, title, proc["argv"], cwd)
    a = next((x for x in agents or [] if x.get("pid") == proc["pid"] and x.get("name")), None)
    if a:
        return a["name"], f"no @repo on the pane; name from `claude agents` ({a['name']})"
    name = session_name(proc["pid"], cwd, proc["argv"])[0]
    if name:
        return name, f"no @repo on the pane; name from its transcript ({name})"
    t = title.lstrip("\u2733\u2734\u2735 ").strip()
    if t and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", t) \
            and newest_transcript(cwd, t)[1].startswith("verified"):
        return t, f"no @repo on the pane; name from pane_title, which a transcript self-reports ({t})"
    return None, None

def live_color(argv, uuid):
    """(colour, knowable) for a pane's session.

    A pane running `claude attach <id>` shows a session /exit moved to the
    background. Its fork transcript starts with no colour record, and a /color
    typed through the attach client is not written anywhere a tool can read --
    OBSERVED 2026-09-15 on 2.1.272: the pane showed cyan, the fork transcript held
    no agent-color record, and the session's metadata file has no colour field.
    Reporting "NONE" there would be an alarm nobody can clear, so it is unknown."""
    if argv[1:2] == ["attach"]:
        return None, False
    return agent_color(uuid), bool(uuid)

def stopped_problems(label, uuid):
    """A live session that fleet.toml says is parked or retired: [(kind, text, fix)].

    fleetrestore will not relaunch a listed transcript, so a session brought back
    without removing its entry is live now and gone after the next restore."""
    out = []
    by_uuid = fc.stopped_uuids(CFG)
    rec = fc.stopped(CFG).get(label)
    if uuid and uuid in by_uuid:
        name, state = by_uuid[uuid]
        out.append(("stopped", f"running, but [{state}.{name}] lists its transcript, so "
                    f"fleetrestore will not relaunch it",
                    f"remove [{state}.{name}] from fleet.toml if it was brought back on purpose"))
    elif rec:
        out.append(("stopped", f"name is [{rec['state']}] with transcript {rec['uuid'][:8]}, "
                    f"but this session resumes {(uuid or '?')[:8]}",
                    f"remove [{rec['state']}.{label}] if the name was reused on purpose"))
    return out

def durable_files(cwd, label=None):
    """Files the session should re-read after a restart. Its brief comes first: it
    is the only record of the session's ROLE, and it lives in configuration."""
    out = []
    brief = os.path.join(fc.config_dir(), "briefs", f"{label}.md") if label else None
    if brief and os.path.exists(brief):
        out.append(brief.replace(os.path.expanduser("~"), "~", 1))
    for name in ("CLAUDE.md", "ROADMAP.md", "CHECKPOINT.md", "SESSION-RESTART-STATE.md"):
        p = os.path.join(cwd, name)
        if os.path.exists(p):
            out.append(name)
    return out

def linger_units():
    """User services, flagged by whether they actually survive a reboot.

    A transient unit (systemd-run --user) lives in /run, which is tmpfs. Linger
    keeps the user manager alive without a login; it does NOT recreate transient
    units after a power cycle. Only a unit file on disk + `enable` does that.
    """
    txt = sh("systemctl", "--user", "list-units", "--type=service", "--no-legend", "--plain")
    out = []
    for line in txt.strip().splitlines():
        if not line.strip():
            continue
        name = line.split()[0]
        if name.startswith(("plasma-", "app-", "dbus-", "xdg-", "gvfs-", "pipewire",
                            "wireplumber", "kde-", "at-spi", "dconf", "obex")):
            continue
        info = sh("systemctl", "--user", "show", name, "-p", "Transient", "-p", "FragmentPath")
        transient = "Transient=yes" in info
        out.append({"unit": name, "transient": transient,
                    "survives_reboot": not transient,
                    "fragment": next((l.split("=", 1)[1] for l in info.splitlines()
                                      if l.startswith("FragmentPath=")), "")})
    return out

def main():
    # Takes no arguments. It used to ignore them, so `fleetsnap --help` wrote a
    # real snapshot (2026-09-13). A tool that writes state must not do so on a
    # request for its usage.
    if sys.argv[1:]:
        if sys.argv[1] in ("-h", "--help"):
            print(__doc__.strip())
            return
        print(f"fleetsnap: takes no arguments (got {' '.join(sys.argv[1:])}); see --help",
              file=sys.stderr)
        sys.exit(2)
    prior = prior_snapshot()
    agents = list_agents()          # claude's own names; None when it cannot be read
    meta = window_meta()
    layouts = window_layouts(meta)
    winnotes = []
    snap = {"captured": time.strftime("%Y-%m-%d %H:%M:%S %Z"),
            "host": os.uname().nodename,
            "installed_claude": os.path.basename(os.path.realpath(
                os.path.expanduser("~/.local/bin/claude"))),
            "sessions": [], "user_units": linger_units(),
            "window_layouts": layouts, "window_name_notes": winnotes,
            "tmux_conf": {"path": os.path.expanduser("~/.tmux.conf"),
                          "exists": os.path.exists(os.path.expanduser("~/.tmux.conf")),
                          "mtime": (time.strftime("%Y-%m-%d %H:%M",
                                    time.localtime(os.path.getmtime(os.path.expanduser("~/.tmux.conf"))))
                                    if os.path.exists(os.path.expanduser("~/.tmux.conf")) else None)},
            "note": "resume_uuid is the durable handle; session NAMES change on restart",
            # A CACHE OF THE HUMAN'S SENTENCE, NOT A SUBSTITUTE FOR IT. Stored as the
            # quote rather than as a conclusion drawn from it, because a conclusion
            # stored alone is indistinguishable from a quotation on re-reading.
            # Verify the binding rather than trusting this field: check which live
            # session resumes that transcript, via --resume in its process argv or
            # via a descendant executing from its scratchpad path.
            "authority": CFG.get("authority", {})}
    for r in pane_rows():
        if len(r) < 11:
            continue
        sess, win, winname, pidx, pane, repo, fleet, title, pane_path, ppid, size = r[:11]
        fleet = fleet or sess or "default"
        proc = claude_proc(ppid)
        if not proc:
            continue
        # The session's own cwd. pane_current_path follows whatever the pane runs,
        # so a `cd` in one of the session's shell calls would be snapshotted as its
        # directory and rebuilt there (fleet.procs.proc_cwd).
        cwd = proc_cwd(proc["pid"]) or pane_path
        repo, label_note = resolve_label(repo, title, proc, cwd, agents)
        snap["sessions"].append({
            "label": repo,
            "fleet": fleet,
            "label_note": label_note,
            "tmux": {"session": sess, "window": int(win),
                     "window_name": meta.get(f"{sess}:{win}", {}).get("name", winname),
                     "pane_index": int(pidx), "pane_id": pane, "size": size},
            "cwd": cwd,
            **dict(zip(("resume_uuid", "resume_uuid_source"),
                       resume_handle(proc, cwd, repo))),
            "version": proc["version"], "pid": proc["pid"], "started": proc["started"],
            "durable_files": durable_files(cwd, repo),
        })
        s = snap["sessions"][-1]
        live, known = live_color(proc["argv"], s["resume_uuid"])
        s["color"] = {"declared": fc.colors(CFG).get(s["label"]), "live": live, "known": known}
        if s["label"]:
            s["membership_problems"] = [
                {"kind": k, "problem": p, "fix": f} for k, p, f in fc.membership_problems(
                    CFG, s["label"], s["color"]["live"], color_known=known)]
            s["membership_problems"] += [
                {"kind": k, "problem": p, "fix": f} for k, p, f in stopped_problems(
                    s["label"], s["resume_uuid"])]
        else:
            # No name: say so against the PANE, and do not invent one. A restore
            # cannot relaunch this row, since --name and the brief both need a name.
            s["membership_problems"] = [{
                "kind": "name",
                "problem": f"pane {pane}: name unresolved -- no @repo, and neither "
                           f"`claude agents` nor its transcript names it",
                "fix": f"tmux set -p -t {pane} @repo <name>   (or relaunch it with --name <name>)"}]
    # Correct the window names only now: which windows are fleet windows is not
    # known until the sessions have been collected.
    fleet_wins = {f"{s['tmux']['session']}:{s['tmux']['window']}"
                  for s in snap["sessions"]}
    winnotes = keep_real_window_names(meta, prior, fleet_wins)
    snap["window_layouts"] = layouts = window_layouts(meta)
    snap["window_name_notes"] = winnotes
    for s in snap["sessions"]:
        key = f"{s['tmux']['session']}:{s['tmux']['window']}"
        s["tmux"]["window_name"] = meta.get(key, {}).get("name", s["tmux"]["window_name"])

    os.makedirs(STATE, exist_ok=True)
    rotate(f"{STATE}/manifest.json")
    rotate(f"{STATE}/manifest.md")
    with open(f"{STATE}/manifest.json", "w") as f:
        json.dump(snap, f, indent=2)

    fleets = {}
    for sess in snap["sessions"]:
        fleets.setdefault(sess["fleet"], []).append(sess)
    coord = next((x["label"] for x in snap["sessions"] if x["fleet"] == "coord"), None)
    for name, members in fleets.items():
        sub = dict(snap)
        sub["fleet"] = name
        sub["sessions"] = members
        sub["coordinator"] = coord
        sub["window_layouts"] = {k: v for k, v in layouts.items()
                                 if any(f"{m['tmux']['session']}:{m['tmux']['window']}" == k
                                        for m in members)}
        with open(f"{STATE}/{name}.json", "w") as f:
            json.dump(sub, f, indent=2)
    idx = [f"# Fleets on {snap['host']} — {snap['captured']}\n",
           "One manifest per fleet. `fleetrestore <fleet>` rebuilds one; "
           "`fleetrestore --all` rebuilds everything with exact geometry.\n",
           "| fleet | sessions | file |", "|---|---|---|"]
    for name, members in sorted(fleets.items()):
        idx.append(f"| **{name}** | {', '.join(shown(m) for m in members)} | "
                   f"`{name}.json` |")
    idx.append(f"\nCoordinator: **{coord or '_none_'}** — restore once, not per fleet.\n")
    idx.append("Fleet membership comes from the tmux pane option `@fleet` "
               "(falling back to the tmux session name). Change it with "
               "`tmux set -p -t <pane> @fleet <name>` and re-run `fleetsnap`.")
    with open(f"{STATE}/index.md", "w") as f:
        f.write("\n".join(idx) + "\n")

    L = []
    L.append(f"# Fleet manifest — {snap['captured']} on {snap['host']}\n")
    L.append(f"Claude Code installed: **{snap['installed_claude']}**. "
             f"{len(snap['sessions'])} sessions captured.\n")
    L.append("To rebuild after a power cycle, from a plain shell:\n")
    L.append("```\ntmux new-session -d -s 0\n"
             "# then per session below:\n"
             "#   tmux new-window / split-window -c <cwd>\n"
             "#   tmux set -p @repo <label>\n"
             "#   claude --resume <uuid>\n```\n")
    L.append("| fleet | label | window.pane | cwd | resume uuid | version |")
    L.append("|---|---|---|---|---|---|")
    for s in snap["sessions"]:
        t = s["tmux"]
        L.append(f"| {s['fleet']} | {shown(s)} | {t['window']}.{t['pane_index']} | `{s['cwd']}` | "
                 f"`{s['resume_uuid']}` | {s['version']} |")
    L.append("\n## Durable state each session should re-read\n")
    for s in snap["sessions"]:
        files = ", ".join(f"`{f}`" for f in s["durable_files"]) or "_none found_"
        L.append(f"- **{shown(s)}** — {files}")
    L.append("\n## Membership: every session needs a brief and a declared colour\n")
    incomplete = [s for s in snap["sessions"] if s["membership_problems"]]
    if not incomplete:
        L.append(f"All {len(snap['sessions'])} complete.")
    for s in incomplete:
        for p in s["membership_problems"]:
            L.append(f"- **{shown(s)}** — {p['problem']}; {p['fix']}")
    L.append("\n## tmux\n")
    tc = snap["tmux_conf"]
    L.append(f"`~/.tmux.conf` {'present' if tc['exists'] else 'MISSING'}"
             + (f", last modified {tc['mtime']}. " if tc['exists'] else ". ")
             + "It is a file on disk, so it survives a power cycle and is re-read when "
               "the tmux server next starts. The `@repo` pane-border logic lives there.")
    L.append("\nExact window layouts, restorable verbatim with `tmux select-layout`:\n")
    for k, v in sorted(snap["window_layouts"].items()):
        L.append(f"- `{k}` ({v['name']}): `{v['layout']}`")
    L.append("\n## What does NOT survive a power cycle\n")
    L.append("- tmux layout, pane ids, `@repo` labels — rebuilt by the restore script")
    L.append("- every local background job, including anything started with `setsid`")
    L.append("- every in-session Monitor/watcher — transcripts still *show* them being "
             "created, so nothing in a resumed session flags them as dead")
    L.append("- cross-session message subscriptions")
    L.append("\n## What DOES survive\n")
    L.append("- jobs on a remote cluster (they run there, not here)")
    L.append("- git repos, working trees, uncommitted changes")
    L.append("- all transcripts under `~/.claude/projects/`")
    L.append("- systemd `--user` units **only if they have a unit file on disk and are "
             "enabled**. A transient unit created with `systemd-run --user` lives in `/run`, "
             "which is tmpfs, and is GONE after a power cycle. Lingering keeps the user "
             "manager alive without a login; it does not recreate transient units.")
    for u in snap["user_units"]:
        mark = "survives reboot" if u["survives_reboot"] else "**TRANSIENT — dies at reboot**"
        L.append(f"  - `{u['unit']}` — {mark}  \n    `{u['fragment']}`")
    with open(f"{STATE}/manifest.md", "w") as f:
        f.write("\n".join(L) + "\n")
    for n in winnotes:
        print(f"    ! window name: {n}")
    stale = [x for x in snap["sessions"] if x.get("label_note")]
    for x in stale:
        print(f"    ! {shown(x)}: {x['label_note']}")
    print(f"captured {len(snap['sessions'])} sessions in {len(fleets)} fleets -> {STATE}/")
    for name, members in sorted(fleets.items()):
        print(f"    {name:<12} {len(members)}  {', '.join(shown(m) for m in members)}")
    incomplete = [s for s in snap["sessions"] if s["membership_problems"]]
    if incomplete:
        print(f"\n!! {len(incomplete)} of {len(snap['sessions'])} sessions incomplete "
              "(every member needs a brief and a declared colour, and none may be parked or retired):")
        for s in incomplete:
            for p in s["membership_problems"]:
                print(f"   {shown(s):<20} {p['problem']}\n   {'':<20} -> {p['fix']}")
    else:
        print(f"    membership: all {len(snap['sessions'])} have a brief and their declared colour")

if __name__ == "__main__":
    main()
