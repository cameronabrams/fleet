#!/usr/bin/env python3
"""fleetboard -- one screen: who is working, who is blocked, what is wrong.

  fleetboard              local sources only (~0.2 s)
  fleetboard --full       also refresh cluster work and context sizes (~6 s)
  fleetboard --parked     also list the parked sessions (counted by default)
  fleetboard --watch [N]  redraw every N seconds (default 15), refreshing the
                          slow sources whenever the cache is over 10 min old

It RENDERS state the fleet already derives. It declares nothing, registers no
probes and keeps no status of its own -- that design was refused on 2026-10-03
and this is not a way back to it. Sources:

  tmux            9 ms   panes, windows, silence flag (monitor-silence)
  claude agents 177 ms   name, status, pid, cwd -- the authority on names
  /proc + readlink 0 ms  which binary each session runs, and which is installed
  fleetwatch    3.6 s    cluster work and watcher liveness  (--full)
  fleetcontext  2.2 s    context size per session           (--full)

The two slow ones are cached and shown with their AGE, never as current: a value
on this screen is evidence as of a time. **Absence is rendered as `?`, never as a
pass** -- a board that shows green because a source failed is worse than no board.

Written outside this repository and moved in on 2026-10-04. It reads this app's
state layout and two of its tools, and that coupling had no test across it: when
`fleetsnap` changed its housekeeping on 2026-10-03 the board went blind, and only
one side of the dependency had CI.
"""
import json, os, shutil, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet import kernels
from fleet import version_flag
from fleet import versions
from fleet import snapshot
from fleet.panes import (LABELS, agent_label, belongs, fleet_label,
                         is_agent_pane)

# Read once, for the state directory only: where the cache lives is not something
# a human moves while a board is watching, and the path is resolved before any
# draw. Anything a human DOES change mid-run is re-read where it is used -- see
# `parked()`.
CFG = fc.load()
STATE = fc.state_dir(CFG)
# A SUBDIRECTORY, deliberately. The cache lived at `<state>/board-cache.json`
# until 2026-10-03, when `fleetsnap`'s housekeeping -- which globbed
# `<state>/*.json` and moved aside anything not named after a live fleet --
# renamed it, and every value here went to `?` for an hour before a human
# noticed. That glob is gone, but the rule it taught stands: the state directory
# root is shared, so a tool that wants files there owns a subdirectory.
CACHE = os.path.join(STATE, "cache", "board.json")
# Sibling tools resolved from this file, not from a symlink directory on PATH:
# `~/bin` is one person's install, and a board that reads whatever `fleetwatch`
# happens to be on PATH is reading a different version than it ships with.
BIN = os.path.dirname(os.path.realpath(__file__))
# In --watch, re-run the slow sources when the cache is older than this. Without
# it a watched board shows one measurement forever and ages it in the footer --
# which is how it survived its own data loss on 2026-10-03.
REFRESH = 600

C = {"dim":"\033[2m","b":"\033[1m","r":"\033[0m","red":"\033[31m","grn":"\033[32m",
     "yel":"\033[33m","blu":"\033[34m","cyn":"\033[36m"}
if not sys.stdout.isatty():
    C = {k:"" for k in C}

def run(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout if p.returncode == 0 else None
    except Exception:
        return None

def run_json(cmd, timeout=120):
    """A peer tool's `--json`, or None if it could not be read OR did not parse.

    Both failures mean the same thing to this board -- no data -- and both must
    reach the screen as `?`. Until 2026-10-04 these two sources were read by
    parsing their DISPLAY tables by column position, which is how the board came
    to have the defect it exists to report: see `jobs()` below."""
    out = run(cmd, timeout)
    if out is None:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None

# Filled by `panes()` each draw: sessions this fleet is NOT responsible for.
#
# There was a second list beside it, `unlabeled`, for panes whose membership was
# being ASSUMED rather than read -- `belongs` counted an unstamped pane as ours
# and this board put that assumption on the screen. Membership went strict on
# 2026-10-20, so an unstamped pane is now simply not ours and lands in `foreign`
# with an empty name; there is no assumption left to display.
foreign = []


def panes():
    out = run(["tmux","list-panes","-a","-F",
               "\t".join(["#{window_index}","#{window_name}","#{pane_id}", LABELS,
                          "#{?window_silence_flag,quiet,active}","#{?window_active,cur,}"])], 5)
    rows = {}
    del foreign[:]
    if out is None:
        return None
    # Re-read each draw, like the parked list and for the same reason: `--watch`
    # outlives the configuration, and a fleet that is given a name while a board
    # is up should start filtering on it without a restart.
    try:
        ours = fc.fleet_name(fc.load())
    except Exception:
        ours = None
    for line in out.splitlines():
        f = line.split("\t")
        # Membership through the shared helper, not a truthiness check on the
        # field: `list-panes -a` crosses tmux sessions, and which option carries
        # the name has already moved once. The test that caught this board for
        # keeping its own copy of the rule is exhaustive over bin/, which is why
        # it caught it on the day it arrived.
        if len(f) < 7 or not is_agent_pane(f[3]):
            continue
        # Another fleet's pane is not this fleet's business, and since the flip
        # an UNSTAMPED pane is not this fleet's business either: a pane no tool
        # has labeled is a pane no tool is known to own. Both land here, and the
        # label is rendered so the two can be told apart on the screen -- the
        # fixes differ, since an unstamped pane may be one of ours labeled by a
        # tool too old to say so.
        if not belongs(f[4], ours):
            foreign.append((agent_label(f[3]), fleet_label(f[4])))
            continue
        rows[agent_label(f[3])] = {"win":f[0], "winname":f[1], "pane":f[2],
                                   "fleet":f[4],
                                   "quiet":f[5] == "quiet", "current":f[6] == "cur"}
    return rows

def agents():
    d = run_json(["claude","agents","--json"], 30)
    if d is None:
        return None
    items = d if isinstance(d, list) else d.get("agents", [])
    return {a["name"]: a for a in items if a.get("name")}

def cluster_configured():
    """Whether fleet.toml declares any `[cluster.<name>]`. Re-read on every call,
    like `stopped`, because `--watch` outlives an edit to the file."""
    return bool(fc.load(required=False).get("cluster"))

def jobs_and_notes():
    """(jobs or None, [notes]) from `fleetwatch --json`.

    `None` means *not known*, and the caller renders it `?`. That distinction is
    the whole reason this reads JSON. The display table has no row for a failed
    cluster query -- `fleetwatch` prints a banner and exits 0 -- so the parse that
    used to read this by column found no rows and reported an EMPTY job list,
    which the board drew as a blank work column for every session. An unreachable
    cluster rendered as a calm fleet. `cluster_ok` is a field; a banner is not.
    """
    if not cluster_configured():
        # Nothing to ask, so nothing is unknown: there is no work on a cluster
        # that was never declared. Not a call that fails -- `fleetwatch` cannot
        # start without a cluster, and its traceback read as `?` in every row,
        # which says "could not tell" about a question with a known answer.
        # `fleetretire` already treats this case as a choice, not a failure.
        return [], []
    d = run_json([os.path.join(BIN, "fleetwatch"), "--json"])
    if d is None:
        return None, []
    notes = []
    if not d.get("cluster_ok"):
        # With a DURATION, which is the difference between ignoring the line and
        # looking into it: the sentence alone reads identically for a two-minute
        # blip, a two-day maintenance window, and a cluster nobody ever reached.
        # `None` is not zero -- a fleet with no recorded good read says so rather
        # than claiming an outage that began when its state file did.
        down = d.get("cluster_down_for_s")
        how_long = (" for %s" % short_duration(down)) if down else ""
        return None, ["cluster query failed%s -- live work is UNKNOWN, not none"
                      % how_long]
    jobs = [{"job": j.get("job"), "tasks": j.get("tasks") or 0,
             "owner": j.get("owner"),
             "watched": bool(j.get("watched_by"))} for j in d.get("jobs") or []]
    if any(not j["watched"] for j in jobs):
        notes.append("live work with no watcher")
    if d.get("dead_watchers"):
        notes.append("a registered watcher is dead")
    if d.get("stale_watchers"):
        notes.append("a watcher points at a job that is no longer live")
    if (d.get("delivery") or {}).get("silent"):
        notes.append("a nudge never arrived and no push went out")
    if len((d.get("clients") or {}).get("attached") or []) > 1:
        notes.append("more than one client is attached to the tmux server")
    # A job that ENDED badly is the thing a board exists to surface: it is over,
    # so it holds no watcher and appears in no live row. `_states` is computed by
    # fleetwatch and prefixed to keep it out of the registration file's own key
    # namespace -- it is part of the --json contract, not a private field.
    for r in d.get("finished_watchers") or []:
        st = r.get("_states") or ""
        if st and st != "COMPLETED":
            notes.append(f"{r.get('session')} job {r.get('job')} ended {st} -- not cleared")
    return jobs, notes

def context():
    """name -> thousands of tokens, or None if unknown."""
    d = run_json([os.path.join(BIN, "fleetcontext"), "--json"])
    if d is None:
        return None
    out = {}
    for s in d.get("sessions") or []:
        if s.get("name") and s.get("tokens"):
            out[s["name"]] = int(s["tokens"]) // 1000
    return out

def refresh_cache():
    jobs, notes = jobs_and_notes()
    c = {"at": time.time(), "jobs": jobs, "ctx": context(), "notes": notes,
         "cluster": cluster_configured()}
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE,"w") as fh: json.dump(c, fh)
    except OSError:
        pass
    return c

def load_cache():
    try:
        with open(CACHE) as fh: return json.load(fh)
    except (OSError, ValueError):
        return None

HOME = os.path.expanduser("~")

def short_path(path, width):
    """`path` with $HOME as `~`, cut from the LEFT to fit `width`.

    Paths are distinctive at the END -- two sessions under ~/site-project
    differ in their last component and agree in the first three -- so a right-hand
    truncation would make the column widest exactly where it stops telling them
    apart.
    """
    if not path:
        return ""
    p = path.replace(HOME, "~", 1) if path.startswith(HOME) else path
    return p if len(p) <= width else "…" + p[-(width - 1):]

def cwd_width(fixed, lo=14, hi=42):
    """How much room the cwd column gets, from the real terminal.

    Clamped at both ends: a column narrower than `lo` shows nothing a reader can
    use, and one wider than `hi` is paid for by every other row. `get_terminal_size`
    falls back to 80 columns when stdout is not a terminal -- a pipe or this tool's
    own tests -- which is the conservative direction.
    """
    return max(lo, min(hi, shutil.get_terminal_size((80, 24)).columns - fixed))

# The schema this understands. A file that declares a different one is a producer
# this board has not been taught to read, which is a PROBLEM and not an absence:
# rendering unknown fields as "nothing pending" is the failure this whole tool is
# written against. A file with no `schema` key at all is read as 1, because that
# is the contract the first producer was written to and treating its absence as a
# mismatch would break the feature on the day it arrives.
UPDATES_SCHEMA = 1


def read_updates(path, stale_hours, now=None):
    """(state, data) for the pending-updates file. State is one of:

      "ok"       -- read, current, and the check itself succeeded
      "stale"    -- read, but older than `stale_hours`; its numbers still shown
      "failed"   -- the check ran and reported `ok: false`
      "unknown"  -- missing, unreadable, unparseable, or an unknown schema

    **Never "up to date" by default.** Every failure here is a reason the board
    cannot say what is pending, and a board that answers "nothing" because its
    source went missing is worse than one that says it does not know.
    """
    now = time.time() if now is None else now
    try:
        with open(path) as f:
            d = json.load(f)
    except OSError as e:
        return "unknown", {"error": "cannot read %s (%s)" % (path, e.strerror or e)}
    except ValueError as e:
        return "unknown", {"error": "%s is not readable JSON (%s)" % (path, e)}
    if not isinstance(d, dict):
        return "unknown", {"error": "%s does not hold an object" % path}
    if int(d.get("schema", UPDATES_SCHEMA) or 0) != UPDATES_SCHEMA:
        return "unknown", {"error": "%s declares schema %s; this board reads %d"
                                    % (path, d.get("schema"), UPDATES_SCHEMA)}
    if not d.get("ok"):
        return "failed", d
    at = d.get("checked_epoch")
    try:
        age_h = (now - float(at)) / 3600.0
    except (TypeError, ValueError):
        return "unknown", dict(d, error="no readable checked_epoch in %s" % path)
    d = dict(d, _age_s=now - float(at))
    return ("stale" if age_h > stale_hours else "ok"), d


def updates():
    """(state, data) for this machine's pending updates, or (None, None) when no
    source is configured -- which is silence, not a failure.

    Re-read on every call for the same reason `parked` is: `--watch` outlives the
    file, which a daily timer rewrites underneath it.
    """
    try:
        cfg = fc.updates(fc.load())
    except Exception:
        return "unknown", {"error": "the fleet configuration could not be read"}
    if not cfg:
        return None, None
    return read_updates(cfg["status"], cfg["stale_hours"])


def parked():
    """name -> {cwd, since} for sessions DECLARED parked, or None if unreadable.

    Parked is a declaration, not an observation: it comes from `[parked.<name>]`
    in the configuration, which is the whole reason it can be shown for a session
    with no process and no pane. Retired sessions are deliberately absent -- they
    are not coming back, and a board is about what might.

    None, not {}, when the configuration cannot be read, so the caller can say so
    rather than draw an empty list that reads as "nothing is parked".
    """
    # Re-read on EVERY call, not from the module-level CFG. `--watch` redraws for
    # as long as the board is left up, and parking is a declaration a human
    # changes underneath it: a watcher 21h50m old was still listing `site-repo`
    # as parked hours after it was unparked, and flagged it ALSO RUNNING -- a
    # disagreement between a live reading of tmux and a 22-hour-old reading of a
    # file, both of them this board's. A check that reports its own staleness as
    # the fleet's is worse than no check, because it looks like evidence about
    # something else.
    #
    # The slow sources here are cached deliberately and shown with their age. A
    # small TOML file is neither slow nor observed, so it gets neither treatment.
    # Reading it costs nothing beside the `claude agents` call every draw makes.
    try:
        return {k: {"cwd": v.get("cwd", ""), "since": v.get("since", "")}
                for k, v in fc.stopped(fc.load()).items()
                if v.get("state") == "parked"}
    except Exception:
        # Includes a file caught half-saved. A watched board must survive a human
        # editing the configuration under it and say so, not exit on a parse error
        # and take the screen down.
        return None

def short_duration(seconds):
    """`1h 20m` for an outage. Hours and minutes from one hour, not from ninety
    minutes: `age` below is the age of a cached READING, where coarseness is
    right; the length of an outage is read at the moment someone decides whether
    to care, and "80m" makes them do the division first."""
    s = int(seconds)
    if s < 90:
        return "%ds" % s
    if s < 3600:
        return "%dm" % (s // 60)
    if s < 172800:
        return "%dh %dm" % (s // 3600, (s % 3600) // 60)
    return "%dd %dh" % (s // 86400, (s % 86400) // 3600)


def age(ts):
    s = int(time.time() - ts)
    if s < 90:  return f"{s}s"
    if s < 5400: return f"{s//60}m"
    return f"{s//3600}h"

def updates_line(u_state, u_data):
    """The pending-updates line, or None when no source is configured.

    Beside the other aged sources, and carrying its age for the same reason they
    do: a package count is evidence as of a time, and the producer is a daily
    timer. Nothing is printed when no source is configured -- that is silence by
    choice, which is the one absence here that is not a failure.

    Returned rather than printed, because this moved from the bottom of the board
    to the top on 2026-10-21 and a block that prints itself cannot be moved.
    """
    if u_state == "unknown":
        return f"  {C['red']}updates: UNKNOWN -- {u_data.get('error', 'no reason given')}{C['r']}"
    if u_state == "failed":
        return (f"  {C['red']}updates: THE CHECK FAILED -- "
                f"{u_data.get('error') or 'no reason given'}{C['r']}")
    if u_state in ("ok", "stale"):
        n = u_data.get("total")
        k = u_data.get("kernel_update") or []
        tgt = u_data.get("target_snapshot")
        # SUPERSEDED beats both the count and the age. A document written before
        # a human installed the updates it lists is not merely old -- its count
        # is about a state this machine has left, and printing "47 updates" for
        # the rest of the day advertises work that no longer exists. The machine
        # says which snapshot it is on; the document says which one it was aiming
        # at; reaching it is the document's own definition of done.
        #
        # None means it could not be told, and then nothing changes: the count
        # and its age are printed exactly as before.
        if snapshot.superseded(u_data):
            have = snapshot.current()
            was = ("%d update%s %s" % (n, "" if n == 1 else "s",
                                       "was" if n == 1 else "were")) if n \
                else "nothing was"
            return ("\n  %supdates: %s pending %s ago -- SUPERSEDED, this machine "
                    "is on %s now; the check has not re-run%s"
                    % (C['dim'], was, age(time.time() - u_data["_age_s"]),
                       have, C['r']))
        if n:
            what = "%s update%s" % (n, "" if n == 1 else "s")
            if k:
                what += " (kernel)"
            if tgt and tgt != u_data.get("snapshot"):
                what += " -> %s" % tgt
        else:
            what = "up to date (%s)" % (u_data.get("snapshot") or "?")
        when = "checked %s ago" % age(time.time() - u_data["_age_s"])
        # STALE is said, not implied by a large number: a reader who sees only an
        # age has to do the arithmetic, and the whole point is that a check which
        # stopped running must not read as a quiet machine.
        mark = f"  {C['red']}STALE{C['r']}" if u_state == "stale" else ""
        color = C['red'] if (n or u_state == "stale") else C['dim']
        return f"  {color}updates: {what}{C['r']}{C['dim']} - {when}{C['r']}{mark}"
    return None


def cache_lines(cache, full, auto):
    """The cluster/context provenance stamp, and the `!` warnings it carries.

    The warnings stay WITH the stamp rather than being hoisted above it: each one
    is true as of that moment and no later, and a red line with no age beside it
    invites being read as current when its source stopped hours ago.
    """
    if not cache:
        return [f"  {C['dim']}no cluster/context data yet -- fleetboard --full{C['r']}"]
    # `is False`, not falsy: a cache written before the field existed says
    # nothing about the cluster either way, and keeps the old wording.
    if cache.get("cluster") is False:
        stamp = (f"{C['dim']}context as of {age(cache['at'])} ago"
                 "; no [cluster] configured, work not checked")
    else:
        stamp = f"{C['dim']}cluster + context as of {age(cache['at'])} ago"
    if not full and not auto:
        stamp += "; fleetboard --full to refresh"
    out = ["  " + stamp + C['r']]
    for note in cache.get("notes", []):
        out.append(f"  {C['red']}! {note}{C['r']}")
    return out


def draw(full=False, auto=False, show_parked=False):
    p, a = panes(), agents()
    cache = load_cache() if not full else None
    if full or (auto and (cache is None or time.time() - cache["at"] > REFRESH)):
        cache, full = refresh_cache(), True
    u_state, u_data = updates()
    u_data = u_data or {}
    inst = versions.installed()
    # What the fleet SHOULD be on: the newest release that has soaked, which is
    # behind `installed` by design, every day. Staleness is measured against this
    # and not against `installed`, or a session rolled exactly right would read
    # stale forever -- a column that is wrong precisely when it is working.
    tgt = versions.target()[0]
    # Date as well as time. The board is usually read on a `--watch` pane that was
    # started some time ago and is looked at in passing, and a bare clock cannot
    # distinguish "this redrew a minute ago" from "this froze yesterday at the same
    # hour" -- which is a failure this board has actually had (see f5c7201). The
    # stamp is taken HERE, per draw, for the same reason.
    head = f"\n  {C['b']}FLEET{C['r']}  {time.strftime('%Y-%m-%d %H:%M %Z')}"
    # The installed version is what every session gets on its next restart, so it
    # is the thing the per-session column is read against. Unknown prints as `?`
    # like any other unreadable source; it is not omitted, because a missing line
    # reads as "nothing to say about versions" rather than "could not tell".
    head += f"   {C['dim']}claude {C['r']}{inst or '?'}{C['dim']} installed{C['r']}"
    # Both numbers, because they answer different questions and neither stands in
    # for the other: `installed` is what a bare `claude` gives, `target` is what a
    # roll aims at. Printing only one was how a closed gate stayed invisible.
    if tgt and tgt != inst:
        head += f"{C['dim']}, {C['r']}{tgt}{C['dim']} target{C['r']}"
    elif not tgt:
        head += f"{C['dim']}, {C['r']}?{C['dim']} target (nothing soaked){C['r']}"
    # A reboot ends every session on this machine, so it is the one fact here that
    # belongs beside the clock rather than in the footer with the aged sources: it
    # is true NOW, and it is about the fleet rather than about a package list.
    #
    # Raised even when the CHECK failed, which is the opposite of what this first
    # did. The reasoning for suppressing it -- "a failed check may still carry the
    # fields of its last good run" -- was about stale data and this field is not
    # that: the producer derives it independently of the package preview, outside
    # the branch that can fail, precisely so it survives one. Suppressing it would
    # hide a true, current, fleet-ending fact exactly when the other half of the
    # check broke. Found by reading the producer instead of my own fixture.
    #
    # Only an UNKNOWN source withholds it, because there the document could not be
    # interpreted at all -- a schema this board has not been taught may mean
    # something else by the same word.
    #
    # And the KERNEL half is read live, here, rather than taken from that
    # document. The document is written by a daily timer while this fact flips the
    # moment a `dup` unpacks a kernel: on 2026-10-19 one landed at 08:42 with the
    # next check due at 06:21 the following morning, twenty-two hours in which a
    # board reading only the document would have said nothing. It is also the
    # direction a stale document gets WRONG in the reassuring sense once the
    # reboot happens -- an alarm nothing can clear is how a true one gets missed.
    k_state, k_info = kernels.state()
    if u_state in ("ok", "stale", "failed") and u_data.get("reboot_needed") \
            or k_state == "pending":
        head += f"   {C['red']}REBOOT NEEDED{C['r']}"
        if k_state == "pending":
            # Both releases and the wait, because the owner reading this already
            # knows a reboot is owed -- what they do not know is how long they
            # have been putting it off, and that is the number that decides.
            # Only the part that differs: the `-1-default` tail is identical in
            # the ordinary case and this header already runs long enough to wrap a
            # narrow pane. A reminder that wraps is a reminder read as noise.
            was, now_ = kernels.differing(k_info["running"], k_info["newest"])
            waited = ""
            if k_info.get("since"):
                # `age` takes an EPOCH and subtracts it from now; passing it a
                # duration reconstructs an epoch in 1970 and prints the wait as
                # half a million hours. `since` is already an epoch.
                waited = ", waiting %s" % age(k_info["since"])
            head += f"{C['red']} (kernel {was} -> {now_}{waited}){C['r']}"
    elif k_state == "unknown" or not k_info.get("running"):
        # Said out loud rather than passed over. This is read live and locally, so
        # it failing means something odd about the machine itself, and a silent
        # omission here reads exactly like a machine with nothing to report.
        head += f"   {C['red']}kernel: ?{C['r']}"
    else:
        # The quiet case says something too, and it took a reader going to look
        # for the warning to find out why that matters: Cameron checked the board
        # for a pending reboot the day after this landed, saw nothing, and could
        # not tell "checked, and you are on the newest kernel" from "this board
        # does not report kernels". A silent pass is indistinguishable from an
        # absent feature, which is the same doctrine as rendering `?` seen from
        # its other side -- there the board cannot answer, here it can and the
        # answer happens to be good news.
        #
        # One dim field, and no second release to compare against, so the running
        # one prints as `uname -r` gives it. A state of "current" with no release
        # in it falls to the `?` branch above rather than printing `kernel ` with
        # an empty field, which would read as a bug in the board rather than in
        # what it was handed.
        head += f"   {C['dim']}kernel {k_info['running']}{C['r']}"
    print(head)
    if a is None:
        print(f"  {C['red']}claude agents could not be read -- every status below is ?{C['r']}")
    if p is None:
        print(f"  {C['red']}tmux could not be read -- panes and silence unknown{C['r']}")

    # EVERYTHING TIME-SENSITIVE, DIRECTLY UNDER THE HEADER. All of this used to
    # sit at the bottom, below a parked list that is fourteen lines long and grows
    # every time a session is parked -- so the board was 36 lines, eight of the
    # fleet's seventeen panes are under 40 rows, and the rows that change were the
    # ones that fell off. Cameron went looking for a kernel warning on 2026-10-21
    # and ran the comparison by hand rather than read it here.
    #
    # The ordering rule, which is the part worth keeping: ANYTHING THAT SCROLLS
    # OFF SHOULD BE THE THING THAT DOES NOT CHANGE. Fourteen lines saying a
    # session has been parked for a fortnight will say the same tomorrow; the
    # updates count, the cluster stamp and every `!` are the rows a glance is for.
    #
    # Same family as the permanent red line already in the catalog, one step
    # earlier: there a true alarm is read past, here it never reaches the reader.
    pk = parked()
    status = []
    if pk is None:
        status.append(f"  {C['red']}parked sessions could not be read from the "
                      f"configuration{C['r']}")
    line = updates_line(u_state, u_data)
    if line:
        status.append(line)
    status += cache_lines(cache, full, auto)
    if foreign:
        status.append(f"  {C['dim']}not this fleet ({len(foreign)}): "
                      + ", ".join("%s@%s" % (n, f or "(no @fleet)")
                                  for n, f in sorted(foreign))
                      + f"{C['r']}")
    for ln in status:
        print(ln)
    if status:
        print()

    names = sorted(set(list((a or {}).keys()) + list((p or {}).keys())))
    raw_jobs = (cache or {}).get("jobs")
    jobs_known = raw_jobs is not None
    jobs_by = {}
    for j in raw_jobs or []:
        jobs_by.setdefault(j["owner"], []).append(j)
    ctx = (cache or {}).get("ctx")

    # 2 (mark) + 21 + 14 + 9 + 9 + 6 + 2 fixed, then cwd, then the variable work
    # column. cwd sits before `work` and not after it: `work` has no fixed width,
    # and a column that follows a ragged one cannot be scanned down.
    cw = cwd_width(63 + 12)
    print(f"  {C['dim']}{'session':<22}{'win':<14}{'state':<9}{'ver':<9}"
          f"{'ctx':>6}  {'cwd':<{cw}}  work{C['r']}")
    for n in names:
        pa, ag = (p or {}).get(n), (a or {}).get(n)
        st = (ag or {}).get("status", "?")
        col = C['yel'] if st == "busy" else (C['dim'] if st == "idle" else C['red'])
        mark = "*" if pa and pa["current"] else " "
        win = f"{pa['win']}:{pa['winname']}" if pa else "?"
        k = f"{ctx[n]}k" if ctx and n in ctx else "?"
        # The binary this session is RUNNING, which is not what is installed and
        # not what it was launched with. `claude agents` is the only source for
        # the pid, so a session it could not report has an unknown version --
        # rendered `?`, never silently as current.
        sv = versions.of_pid((ag or {}).get("pid"))
        stale = versions.is_stale(sv, tgt)
        # Gentle on purpose: a session one release behind is a thing to do later,
        # not a fault. Current versions are dimmed so they recede and only the
        # ones worth acting on carry color; unknown stays dim too, because the
        # red in this palette is reserved for a source that failed.
        vcol = C['yel'] if stale else C['dim']
        if not jobs_known:
            work = f"{C['dim']}?{C['r']}"       # unknown, never an empty column
        else:
            js = jobs_by.get(n, [])
            work = ""
            if js:
                bad = [j for j in js if not j["watched"]]
                work = f"{len(js)} job(s), {sum(int(j['tasks']) for j in js)} tasks"
                if bad: work += f"  {C['red']}{len(bad)} UNWATCHED{C['r']}"
        # From `claude agents`, the only source here that knows it. A session it
        # could not report has no cwd to show -- blank, not `?`: `?` is this
        # board's word for a value a source failed to give, and an agent that is
        # not in the listing at all has already been reported as `?` in `state`.
        d = short_path((ag or {}).get("cwd", ""), cw)
        # rstrip: `work` is empty for most sessions, and the cwd column is padded
        # to its full width before it, so every quiet row would otherwise end in
        # a run of spaces -- which `git diff`, `grep` and a copy-paste all keep.
        print((f"  {mark}{n:<21}{win:<14}{col}{st:<9}{C['r']}"
               f"{vcol}{(sv or '?'):<9}{C['r']}{k:>6}  "
               f"{C['dim']}{d:<{cw}}{C['r']}  {work}").rstrip())

    # `if`, not the `elif` this was. The parked ROWS live in this block, so while
    # the branch above it was live, a single unstamped pane would have taken the
    # entire parked section off the board -- heading and all -- for a reason that
    # had nothing to do with parking. Never reached in practice, and wrong in the
    # way this board is least allowed to be wrong: a kind of thing vanishing in
    # silence because of an unrelated dim line.
    if pk:
        # A rule, not a blank line: the rows below are a different KIND of thing
        # -- declared, not observed -- and the two must not read as one list that
        # happens to have quiet entries at the bottom.
        print(f"  {C['dim']}{'─' * (63 + cw)}{C['r']}")
        # COUNTED BY DEFAULT, listed on request. Twelve parked sessions are
        # fourteen lines of a 36-line board, every one of them durable: the names
        # are declared in `fleet.toml`, nothing about them changes between draws,
        # and a `--watch` pane re-read them every fifteen seconds while the rows
        # that do change sat below the fold. One line here, the list behind
        # `--parked`.
        #
        # ALSO RUNNING is the exception and stays visible, because it is a
        # CONTRADICTION rather than an inventory: a session declared parked and
        # running at the same time means a human's decision and the machine
        # disagree, and that is exactly the kind of thing this board exists to
        # put in front of someone. Collapsing it into the count would hide the one
        # parked fact that is not durable.
        clash = sorted(n for n in pk if n in names)
        if show_parked:
            print(f"  {C['dim']}parked ({len(pk)}){C['r']}")
            # Its own narrow layout, not the live table's. A parked session has no
            # state, version, context or work -- those are runtime -- and borrowing
            # the columns to leave them blank draws a row of absences where there
            # is nothing absent. Printing `?` in them would be worse: `?` is this
            # board's word for a source that failed, and nothing failed here.
            pw = cwd_width(34, hi=46)   # the longest real parked path fits at 46
            for n in sorted(pk):
                also = f"  {C['red']}ALSO RUNNING{C['r']}" if n in names else ""
                print((f"   {C['dim']}{n:<21}{short_path(pk[n]['cwd'], pw):<{pw}}  "
                       f"since {pk[n]['since']}{C['r']}{also}").rstrip())
        else:
            print(f"  {C['dim']}parked ({len(pk)}){C['r']}"
                  f"{C['dim']} -- fleetboard --parked to list{C['r']}")
            if clash:
                print(f"  {C['red']}! parked and ALSO RUNNING: "
                      f"{', '.join(clash)}{C['r']}")

def main():
    version_flag()
    args = sys.argv[1:]
    full = "--full" in args
    show_parked = "--parked" in args
    if "--watch" in args:
        i = args.index("--watch")
        every = int(args[i+1]) if len(args) > i+1 and args[i+1].isdigit() else 15
        try:
            while True:
                print("\033[2J\033[H", end=""); draw(full, auto=True, show_parked=show_parked); full = False
                time.sleep(every)
        except KeyboardInterrupt:
            pass
    else:
        draw(full, show_parked=show_parked)

if __name__ == "__main__":
    main()
