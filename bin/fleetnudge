#!/usr/bin/env python3
"""fleetnudge - a detached watcher wakes its idle session with one tagged line.

  fleetnudge SESSION JOB "TEXT"          plan: the checks, and the line it would type
  fleetnudge SESSION JOB "TEXT" --go     type it when SESSION is idle; retry while busy

One nudge types into a session at a time: a second one waits for the first rather
than interleaving keystrokes with it.

The line typed is always

  [watcher: SESSION job JOB] TEXT

The tag is added here and cannot be left out. It marks the line as a watcher's
report that a job changed state, never as the human's instruction; each session's
brief says to check the job and report, and to take no other action on the tag's
authority. TEXT is one line of printable text, at most 200 characters.

It types only into a pane that is idle, shows no dialog, and has an empty input
line, and presses Enter only when the input line reads back exactly the tagged
line. It then waits for the line to appear in the session's transcript. While the
session is busy or not typeable it retries (every --every seconds, for up to
--wait seconds); it never queues a line behind a draft.

With `--mail-from FLEET/SESSION` the line is tagged `[mail: FLEET/SESSION -> SESSION]`
instead, for mail relayed by fleetmail; no watcher registration is required, and JOB
is the message id.

Refused, and not retried: a session that is not a fleet member (no [colors] entry)
or is parked or retired; the coordinator; a background (`claude attach`) session;
the session running this tool; a JOB with no registration for SESSION
(fleetregister); an unverified transcript; bad TEXT.

When the line is not delivered, it sends a phone push through [notify] in
fleet.toml (ntfy) unless the mute file exists, and exits non-zero. Every attempt
and outcome is appended to <state>/nudges.log.

Built to run from a systemd unit or a setsid'd script: call it by absolute path.
A unit's PATH lacks ~/.local/bin (where claude lives), so the tool adds it and the
system directories to its own PATH before calling `claude` or `tmux`.

Exit codes: 0 delivered (or a plan with no blocks), 2 refused, 3 the typed line did
not read back (cleared), 4 not delivered in time (busy throughout, or never seen
in the transcript).
"""
import argparse, contextlib, fcntl, glob, json, os, re, subprocess, sys, time, urllib.request
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet import nudgelog
from fleet import pending
from fleet import version_flag
from fleet.agents import list_agents
from fleet.panes import (is_agent_pane, ours_agent_pane, CAPTURE, reconcile, screen_state,
                         shells_running, state_problem, type_line)
from fleet.procs import ancestors, claude_procs, ppid
from fleet.transcripts import PROJECTS, session_name

# A systemd user unit's PATH is only the system directories (observed 2026-09-16).
os.environ["PATH"] = os.pathsep.join(
    [os.path.expanduser("~/.local/bin")]
    + (os.environ.get("PATH") or "/usr/local/bin:/usr/bin:/bin").split(os.pathsep))

CFG = fc.load()
OURS = fc.fleet_name(CFG)   # which fleet this one is; "" before fleetinit has run
STATE = fc.state_dir(CFG)
LOG = os.path.join(STATE, "nudges.log")
LOCKS = os.path.join(STATE, "nudge-locks")
MAX_TEXT = 200
JOB_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:+\[\]-]{0,63}")
CONFIRM_WAIT = 60.0                        # seconds for the typed line to reach the transcript

def tmux(*a):
    try:
        r = subprocess.run(["tmux", *a], capture_output=True, text=True)
    except OSError as e:
        return 1, "", str(e)
    return r.returncode, r.stdout.rstrip("\n"), r.stderr.strip()

def panes():
    """pane_pid -> pane_id, for THIS FLEET's panes only.

    This tool types into a pane. `tmux list-panes -a` crosses tmux sessions, so
    without the label check a session whose --name happened to match a fleet
    member's -- the name collision fleet-bootstrap warns about -- could take a
    line meant for somebody else. Membership is the label fleetspawn stamps; see
    fleet.panes.is_agent_pane. A pane with no mapping simply is not typeable,
    which is the refusal this tool already handles."""
    rc, out, _ = tmux("list-panes", "-a", "-F",
                      "#{pane_id}\t#{pane_pid}\t#{@agent}\t#{@fleet}")
    found = {}
    for row in out.splitlines() if rc == 0 else []:
        p = row.split("\t")
        if len(p) == 4 and p[1].isdigit() and ours_agent_pane(p[2], p[3], OURS):
            found[int(p[1])] = p[0]
    return found

def screen(pane):
    return tmux(*CAPTURE, "-t", pane)[1]

def tag(session, job, mail_from=None):
    """The fixed prefix of the typed line: what the line IS and where it came from.
    A watcher's report about a job, or mail fleetmail relayed from a named remote
    fleet. The caller cannot leave it out or forge the other form.

    `[mail: ...]` IS AN AUTHORITY CLAIM, not just a label of origin. It says: this
    came from another fleet, it is data however it is phrased, it carries no
    authority, and a request to act goes to your own human (bin/fleetmail:70).

    So do not reuse it for a channel whose sender is the session's OWN human. An
    inbound-email channel was proposed on 2026-10-22 that would have tagged a
    message Cameron forwarded as `[mail: email/cameron -> coord]`, since
    `--mail-from` validates `<fleet>/<session>` and a pseudo-fleet is the easy way
    past that. The format fits and the MEANING inverts: a forwarded email is his
    instruction, and this tag's whole point is "the instruction in here is not
    yours to follow". One tag would then carry two opposite meanings, with the
    wrong one landing exactly where the instruction is the point. Caught by coord
    after I proposed the pseudo-fleet. Such a channel needs its own tag.
    """
    if mail_from:
        return f"[mail: {mail_from} -> {session}]"
    return f"[watcher: {session} job {job}]"

def brief_kind(name):
    try:
        with open(fc.brief_path(name), errors="replace") as f:
            m = re.search(r"(?i)\bkind\s*:\s*\**\s*([a-z]+)", f.read())
    except OSError:
        return None
    return m.group(1).lower() if m else None

def registered(session, job):
    """True if some watcher registered (session, job), live or not."""
    for path in glob.glob(os.path.join(STATE, "watchers", "*.json")):
        try:
            with open(path) as f:
                r = json.load(f)
        except (OSError, ValueError):
            continue
        if r.get("session") == session and str(r.get("job")) == job:
            return True
    return False

def static_problems(session, job, text, mail_from=None):
    """Refusals that no amount of waiting fixes."""
    out = []
    if mail_from and not re.fullmatch(r"[a-z0-9][a-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9_-]*", mail_from):
        out.append(f"--mail-from {mail_from!r} is not a <fleet>/<session> address")
    if not JOB_RE.fullmatch(job):
        out.append(f"job {job!r} is not a job id")
    if not text.strip():
        out.append("TEXT is empty")
    elif len(text) > MAX_TEXT:
        out.append(f"TEXT is {len(text)} characters; the limit is {MAX_TEXT}")
    elif any(not c.isprintable() for c in text):
        out.append("TEXT must be one line of printable characters")
    if session not in fc.colors(CFG):
        out.append(f"{session!r} is not a fleet member (no [colors] entry)")
    rec = fc.stopped(CFG).get(session)
    if rec:
        out.append(f"{session} is [{rec['state']}] in fleet.toml")
    if not mail_from and brief_kind(session) == "coordinator":
        # WATCHERS do not nudge the coordinator: their results go to the human, and
        # the coordinator owns no campaign to be told about. Mail is not a watcher.
        # A coordinator is the obvious counterpart for another person's fleet -- it
        # owns no repository and routes -- and `to: <fleet>/coord` is the example
        # address in fleetmail's own documentation. Refusing it wrote the drop and
        # never delivered the line: mail that reads as broken rather than as refused.
        out.append("the coordinator is not nudged; its watchers report to the human directly")
    if not mail_from and not registered(session, job):
        # Relayed mail has no watcher: fleetmail checks its own allowlist before it
        # calls this, and the tag says the line came from another fleet.
        out.append(f"no watcher registration for {session} job {job} (fleetregister {session} {job} <pid>)")
    return out

def resolve(session):
    """(row, problem): the live session, or why it cannot be typed into now.
    problem is (kind, text) with kind "refuse" (final) or "wait" (retry)."""
    agents = list_agents()
    by_pid = {a.get("pid"): a for a in agents or [] if a.get("pid")}
    hits = []
    for pid, cwd, argv in claude_procs():
        if argv[1:2] == ["attach"]:
            continue
        a = by_pid.get(pid)
        if a:
            name, uuid, how = a.get("name"), a.get("sessionId"), "verified: claude agents"
        else:
            name, uuid, how = session_name(pid, cwd, argv)
        if name == session:
            hits.append({"pid": pid, "uuid": uuid, "how": how, "agent": a or {}})
    if agents is not None:
        for a in agents:
            if a.get("name") == session and a.get("kind") == "background":
                return None, ("refuse", f"{session} is a background session; nudge it by hand "
                                        f"in its `claude attach` pane")
    if not hits:
        return None, ("wait", f"no live session answers to {session!r}")
    if len(hits) > 1:
        return None, ("refuse", f"{len(hits)} sessions answer to {session!r}: "
                                + ", ".join(f"pid {h['pid']}" for h in hits))
    r = hits[0]
    # By ancestry only. A setsid'd watcher still carries its session's
    # CLAUDE_CODE_SESSION_ID although it was reparented to init (all three live
    # watchers checked 2026-09-17), so that variable would refuse exactly the
    # callers this tool exists for.
    if r["pid"] in ancestors(os.getpid()):
        # "informed", not "refuse". Both end the attempt, and the difference is the
        # whole point: the content reaches its reader anyway, by the in-session task
        # that is running this. Nothing was lost, so nothing is missing -- and
        # `fleetwatch` read these as delivery holes until 2026-10-15 because the log
        # recorded only `outcome: not delivered` and an exit code that this shares
        # with caller errors that ARE holes (TEXT over the limit, a malformed job
        # id). The distinction is semantic and belongs here, where it is known,
        # rather than in a reader guessing from the sentence below.
        return None, ("informed", "this is running inside the session itself; an in-session "
                                  "task already notifies it")
    if not r["uuid"] or not str(r["how"]).startswith("verified"):
        return None, ("refuse", f"transcript not verified ({r['how']}); delivery could not be confirmed")
    pane_pids = panes()
    r["pane"] = pane_pids.get(r["pid"]) or pane_pids.get(ppid(r["pid"]))
    text = screen(r["pane"]) if r["pane"] else ""
    seen = screen_state(text) if r["pane"] else "no-pane"
    # "At the prompt while holding runtime" is typeable, and the statuses `shell`
    # and `monitor` were the whole of how that was recognized. They are not how
    # this version says it: a session sitting at its prompt with a background shell
    # running reports plain `busy`, indistinguishably from one that is mid-turn
    # (measured across every pane 2026-10-26). So the count comes off the status
    # bar, where the two differ, and `reconcile` uses it to resolve exactly that
    # disagreement. Until 2026-10-26 the rule below could not fire for the
    # sessions it was written for: a watcher's work IS a long background shell, so
    # it read as mid-turn for that shell's whole life and its nudge never landed.
    r["shells"] = shells_running(text) if r["pane"] else None
    r["state"], r["disagree"] = reconcile(seen, r["agent"].get("status"), r["shells"])
    why = state_problem(r["state"], session, r["pane"])
    if why:
        # Say it on the refusal. A screen and a status that disagree is what a
        # moved TUI marker looks like, and a silent refusal is how it stays hidden.
        return r, ("wait", why + (f" [{r['disagree']}]" if r["disagree"] else ""))
    return r, None

@contextlib.contextmanager
def pane_lock(session):
    """Hold the right to type into `session`'s pane, or yield False.

    Two watchers nudged one session in the same second on 2026-09-17: their
    keystrokes interleaved, so NEITHER line read back and both fell through to the
    push. One typist at a time per session. The lock is held only while typing, not
    while waiting for a busy session, so a second nudge is delayed rather than lost."""
    os.makedirs(LOCKS, exist_ok=True)
    path = os.path.join(LOCKS, re.sub(r"[^A-Za-z0-9_.-]", "_", session) + ".lock")
    fh = open(path, "w")
    try:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            yield False
            return
        yield True
    finally:
        fh.close()

def tag_count(uuid, marker):
    """How many times `marker` appears in the session's transcript."""
    n = 0
    for f in glob.glob(f"{PROJECTS}/*/{uuid}.jsonl"):
        try:
            with open(f, errors="replace") as fh:
                n += sum(line.count(marker) for line in fh)
        except OSError:
            pass
    return n

def log(**rec):
    rec = dict(time=time.strftime("%Y-%m-%dT%H:%M:%S%z"), **rec)
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(LOG, "a") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError as e:
        print(f"  could not write {LOG}: {e}", file=sys.stderr)

def push(title, body):
    """Send the phone push. Returns what happened, for the log."""
    n = fc.notify(CFG)
    if not n:
        return "no [notify] in fleet.toml: no push sent"
    if n["mute_file"] and os.path.exists(n["mute_file"]):
        return f"push muted ({n['mute_file']} exists)"
    topic = fc.ntfy_topic(n["ntfy_topic_file"])
    if not topic:
        return f"no ntfy topic readable in {n['ntfy_topic_file']}: no push sent"
    req = urllib.request.Request(f"{n['ntfy_server']}/{topic}", data=body.encode(),
                                 headers={"Title": title}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return f"push sent (HTTP {resp.status})"
    except OSError as e:
        return f"push FAILED: {e}"

# What the log records in place of a push result when no push was warranted. It is
# a sentence, not an absence: `fleetwatch` reads a missing push field as "a human
# was not told", which would be the same false alarm one field along.
NO_PUSH_INFORMED = "not pushed: the session was notified by its own in-session task"


# An outcome only a human or a session writes. `fleetnudge` itself never produces
# it: it says the result reached its reader by a route this tool did not take.
INFORMED_OUTCOME = "informed"


def do_delivered(a, session, job, text):
    """Record that a result reached its session by some route other than a nudge.

    The gap this fills: `fleetmail` has had both halves since 2026-10-15 -- a
    record that the content arrived another way, and a retry -- and nudges had
    neither, so a nudge that gave up stayed an alarm until it aged out of the
    window. The news had in fact arrived; nothing could say so.

    **Appended, never edited.** The old record keeps saying the nudge failed,
    because it did. This is a new fact beside it, carrying WHO said so and why,
    so a reader can weigh it: it is weaker evidence than a delivery and stronger
    than the inference `fleetwatch` already refuses to draw from a later nudge.
    """
    if not text:
        print("\n  REFUSED: say how you know. --delivered writes an assertion "
              "into the log\n  and silences an alarm; an unexplained one is worse "
              "than the alarm.\n")
        return 2
    # The SAME rule the report uses, imported rather than restated. A tool that
    # offers to clear a line must show the lines the report shows; a second
    # implementation would drift and the dry run would then lie about what it is
    # silencing. Restating it here listed thirty ordinary retry records as though
    # each were a hole, when two were.
    recs, _bad = nudgelog.read(LOG)
    open_ = nudgelog.open_trouble(recs or [], session, job)
    # The pending record is checked INDEPENDENTLY of the log hole, not as a
    # consequence of it. They are written together, so they are normally both
    # here -- but a hole cleared by hand, or aged past the report's window, would
    # otherwise leave the content file behind for ever with nothing offering to
    # remove it, and the directory a session reads on reorientation would fill
    # with news that had already arrived.
    pend = pending.path(STATE, session, job)
    has_pending = os.path.exists(pend)
    print(f"\n  record: {session} job {job} was told another way")
    print(f"  how:    {text}")
    if not open_ and not has_pending:
        print(f"\n  NOTHING TO CLEAR: no failed or stalled nudge for {session} "
              f"job {job}, and nothing pending.\n  Writing this anyway would assert "
              f"something about nothing.\n")
        return 3
    for r in open_:
        print("  clears: %s  %s -- %s" % (r.get("time"), r.get("outcome"),
                                          str(r.get("reason"))[:60]))
    if has_pending:
        print(f"  removes: {pend}")
    if not a.go:
        print("\n  plan only -- re-run with --go\n")
        return 0
    log(session=session, job=job, text=text, outcome=INFORMED_OUTCOME,
        notified_otherwise=True, reason=text,
        by=os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("USER") or "?")
    # The log is appended to and the pending record is removed, and the asymmetry
    # is the point: the log is the history of what happened, which this does not
    # get to edit, while the pending file is a piece of undelivered mail, which
    # has now been delivered.
    pending.clear(STATE, session, job)
    print(f"\n  written to {LOG}\n")
    return 0


def do_pending(only=None):
    """Print the undelivered content, which is the whole reason it is on disk.

    `fleetwatch` reports that a nudge was lost; this prints what was lost. The
    two are deliberately different: a session reorienting after a restart needs
    the text, not a count, and a count is what it had before.
    """
    recs, bad = pending.for_session(STATE, only) if only else pending.read_all(STATE)
    where = pending.pending_dir(STATE)
    if recs is None:
        print(f"\n  ? {where} could not be read, so whether anything is pending is "
              f"UNKNOWN.\n    Not the same as nothing pending.\n")
        return 1
    if bad:
        print(f"\n  !! {bad} unreadable file(s) in {where} -- undelivered news "
              f"could be in any of them.")
    if not recs:
        print(f"\n  nothing pending{f' for {only}' if only else ''} in {where}\n")
        return 0 if not bad else 1
    print(f"\n  {len(recs)} undelivered result(s) in {where}:\n")
    for r in recs:
        mail = f"  mail from {r['mail-from']}" if r.get("mail-from") else ""
        print(f"  {r.get('written')}  {r.get('session')} job {r.get('job')}  "
              f"(exit {r.get('code')}){mail}")
        print(f"      {r.get('text')}")
        print(f"      not delivered: {r.get('reason')}")
        print(f"      clear: fleetnudge {r.get('session')} {r.get('job')} "
              f"--delivered \"<how>\" --go\n")
    return 0

def give_up(code, session, job, text, reason, mail_from=None, informed=False):
    # ONE value, both channels. The phone push and the log field are the same claim
    # made to two audiences -- "nobody was told" -- so they are decided here, from
    # this, and never derived twice. Two derivations of one fact agreeing for a
    # reason nobody wrote down is the family this repository keeps finding, and the
    # classifier fixed on 2026-10-15 was that fact's first channel.
    notified_otherwise = bool(informed)
    # The push said `fleetnudge: <session> not reached` for a session that WAS
    # reached -- by the in-session task running this, whose own output lands in
    # that session's transcript. Latent since 2026-09-14 only because the mute file
    # has existed since then, which is why it is pinned by a test rather than left
    # to be noticed.
    pushed = NO_PUSH_INFORMED if notified_otherwise else push(
        f"fleetnudge: {session} not reached",
        f"{tag(session, job, mail_from)} {text}\nNot delivered: {reason}")
    # mail_from travels with the FAILURE too, not only with the success: a piece of
    # mail that never arrived is the case a reader most needs to identify as mail,
    # and fleetwatch reads these records to find it.
    #
    # `notified_otherwise` is written on EVERY not-delivered record, true or false,
    # rather than only when true. A reader can then tell "this nudge predates the
    # field" from "this nudge lost the news", which an absent key cannot say.
    log(session=session, job=job, text=text, outcome="not delivered", code=code,
        reason=reason, push=pushed, mail_from=mail_from,
        notified_otherwise=notified_otherwise)
    print(f"\n  NOT DELIVERED: {reason}\n  {pushed}\n")
    # The log says a nudge failed; this says WHAT failed to arrive, addressed to
    # the session that was owed it. Written on every give-up, not only the ones
    # where the caller has exited: a preflight refusal is correctable by a live
    # caller, but only if there IS one, and nothing here can tell. Skipped when the
    # content reached its reader another way -- there is nothing pending then, and
    # a record asserting otherwise is the false alarm one field along.
    if not notified_otherwise:
        where = pending.write(STATE, session, job, text, reason, code, mail_from)
        print(f"  left for {session} to read: {where}\n"
              f"  clear it with: fleetnudge {session} {job} --delivered \"<how>\" --go\n")
    sys.exit(code)

def deliver(r, session, job, text, mail_from=None):
    """Type, Enter, confirm. Returns (code, detail)."""
    marker = tag(session, job, mail_from)
    line = f"{marker} {text}"
    before = tag_count(r["uuid"], marker)
    err = type_line(tmux, r["pane"], line)
    if err:
        return 3, err
    tmux("send-keys", "-t", r["pane"], "Enter")
    t_end = time.time() + CONFIRM_WAIT
    while time.time() < t_end:
        time.sleep(2)
        if tag_count(r["uuid"], marker) > before:
            return 0, f"delivered to {session} in {r['pane']} (seen in its transcript)"
    return 4, (f"typed into {r['pane']} and entered, but the line did not appear in "
               f"{session}'s transcript within {CONFIRM_WAIT:.0f}s")

def main():
    version_flag()
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("session", nargs="?")
    ap.add_argument("job", nargs="?")
    ap.add_argument("text", nargs="?", default="")
    ap.add_argument("--go", action="store_true")
    ap.add_argument("--pending", action="store_true",
                    help="do not nudge: print what never reached a session, newest "
                         "last. With SESSION, only that session's. Read-only.")
    ap.add_argument("--delivered", action="store_true",
                    help="do not nudge: record that this result reached SESSION by "
                         "another route, clearing it from fleetwatch's holes. TEXT "
                         "is how you know.")
    ap.add_argument("--wait", type=int, default=1800, help="seconds to keep retrying (default 1800)")
    ap.add_argument("--every", type=int, default=60, help="seconds between attempts (default 60)")
    ap.add_argument("--mail-from", metavar="FLEET/SESSION",
                    help="relayed mail: tag the line as coming from that remote address "
                         "(fleetmail's use; no watcher registration is required)")
    a = ap.parse_args()
    if a.pending:
        sys.exit(do_pending(a.session))
    # The positionals are optional only so that --pending can stand alone. A plain
    # misuse must still say what is missing, in the words argparse would have used.
    missing = [n for n, v in (("session", a.session), ("job", a.job)) if v is None]
    if missing:
        ap.error("the following arguments are required: " + ", ".join(missing))
    session, job, text = a.session, a.job, a.text.strip()
    mail_from = a.mail_from
    if a.delivered:
        sys.exit(do_delivered(a, session, job, text))
    print(f"\n  nudge {session}: {tag(session, job, mail_from)} {text}")

    problems = static_problems(session, job, text, mail_from)
    if problems:
        for p in problems:
            print(f"  REFUSED: {p}")
        if a.go:
            give_up(2, session, job, text, "; ".join(problems), mail_from)
        print()
        sys.exit(2)

    if not a.go:
        r, problem = resolve(session)
        if problem and problem[0] != "wait":
            print(f"  REFUSED: {problem[1]}\n")
            sys.exit(2)
        now = f"now: {problem[1]}" if problem else f"now: idle in {r['pane']}"
        print(f"  {now}")
        print(f"\n  --go would type the line when {session} is idle (retrying every {a.every}s "
              f"for up to {a.wait}s), press Enter, and confirm it in the transcript;")
        print("  otherwise send the [notify] push and exit non-zero.\n\n  plan only -- re-run with --go\n")
        return

    t_end = time.time() + a.wait
    attempt = 0
    while True:
        attempt += 1
        with pane_lock(session) as mine:
            if not mine:
                problem = ("wait", f"another fleetnudge is typing into {session}'s pane")
                r = None
            else:
                r, problem = resolve(session)
                if problem is None:
                    code, detail = deliver(r, session, job, text, mail_from)
                    if code == 0:
                        # The disagreement travels with a SUCCESS too, not only
                        # with a refusal. This is the one case where a line is
                        # typed into a session that `claude agents` called busy,
                        # on the strength of a parse of the status bar -- so the
                        # reason has to be in the record, where a reader looking
                        # at a nudge that should not have landed will find it.
                        # Printed as well as logged, because the caller is often
                        # a detached watcher whose stdout is the only thing a
                        # human reads.
                        log(session=session, job=job, text=text, outcome="delivered",
                            attempt=attempt, pane=r["pane"], detail=detail,
                            shells=r.get("shells"), why_typeable=r.get("disagree"),
                            mail_from=mail_from)
                        if pending.clear(STATE, session, job):
                            print("  (cleared the pending record this job left earlier)")
                        print(f"  {detail}\n")
                        if r.get("disagree"):
                            print(f"  typed although `claude agents` reports "
                                  f"{r['agent'].get('status')!r}: {r['disagree']}\n")
                        return
                    give_up(code, session, job, text, detail, mail_from)
        kind, why = problem
        log(session=session, job=job, text=text,
            outcome="waiting" if kind == "wait" else "refused",
            attempt=attempt, reason=why, mail_from=mail_from)
        if kind in ("refuse", "informed"):
            give_up(2, session, job, text, why, mail_from, informed=(kind == "informed"))
        if time.time() + a.every > t_end:
            give_up(4, session, job, text, f"still not typeable after {a.wait}s: {why}",
                    mail_from)
        print(f"  attempt {attempt}: {why}; retrying in {a.every}s")
        time.sleep(a.every)

if __name__ == "__main__":
    main()
