#!/usr/bin/env python3
"""fleetinit - create a fleet's configuration directory so the other tools can run.

  fleetinit                      show the plan; change nothing (the default)
  fleetinit --go                 set this machine up: fleet.toml, briefs/,
                                 conventions.md, and the symlinks `install` makes
  fleetinit --from HOST --go     take the shareable parts of another MACHINE's
                                 configuration, over ssh
  fleetinit --from PATH --go     the same, from a file on this machine
  fleetinit --no-link --go       write the configuration but do not symlink
  fleetinit --save-profile PATH  write the shareable parts out, and stop

Everything up to the tmux server, in one command. The configuration was only ever
the first of four things a clean machine needs, and leaving the other three in a
docs page makes a setup that is performed from memory and got wrong. What is left
afterwards is a tmux server -- which server a human is attached to is theirs to
choose -- a brief, and the spawn.

On a fresh machine nothing else can run: `install` exits 2 without a fleet.toml,
so this is the step that blocks every other step. That is why it exists and why
it comes first.

**The repository ships the schema and the questions, never the answers.** A name,
a cluster, an ssh host and an account code are a person's and a site's; this
package may not contain them (CLAUDE.md), so defaults cannot live here. They
travel one of two ways:

  --from <an existing fleet.toml>   copies the parts that are about how someone
                                    likes fleets to work -- [human], [paths],
                                    [spawn], [context], [notify], [mail] and every
                                    [cluster.*] -- and drops the parts that are
                                    about one particular fleet.
  the prompts                       asked when a value is missing and there is a
                                    terminal to ask at; `--name` and friends
                                    answer them non-interactively.

So the fresh-machine path is: clone this repository and point `--from` at the
machine that already has a fleet -- `fleetinit --from <host> --fleet <name> --go`,
which reads `~/.config/fleet/fleet.toml` there over ssh. `host:/other/path` names
a different file. With nothing to hand, the prompts and the example file still
produce a working configuration.

A local path still works and is tried first: a file that EXISTS is never treated
as a hostname.

**Copied as TEXT, not parsed and re-emitted.** There is no comment-preserving TOML
writer in the standard library, and the comments are the reason a configuration is
worth reading: they say why each value is what it is. Whole sections are deleted
by line; nothing else is touched; and the result is parsed before it replaces
anything.

It never overwrites an existing fleet.toml. A configuration that is already there
is somebody's work.
"""
import argparse, os, re, shutil, subprocess, sys, tomllib
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet import panes as panes_mod
from fleet import version_flag

APP = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
EXAMPLE = os.path.join(APP, "examples", "fleet.example.toml")
BRIEF_EXAMPLE = os.path.join(APP, "examples", "brief.example.md")
CONVENTIONS_EXAMPLE = os.path.join(APP, "examples", "conventions.example.md")
INSTALL = os.path.join(APP, "install")

# With --label-panes: which tmux server to label on. None is the default one.
SOCKET = None

# What belongs to ONE fleet rather than to how a person likes fleets to work --
# and it divides in two, which an end-to-end run found and no unit test would
# have.
#
# EMPTIED, header and comments kept: every fleet HAS a roster, so `[colors]` and
# `[owners]` are per-fleet in their CONTENTS, not in their existence. Deleting
# the header outright left a config that `fleetspawn --color` then refused to
# add to -- correctly, since it will not guess where a missing section goes.
EMPTY = ("colors", "owners")
# DROPPED outright: `[parked.*]` and `[retired.*]` are history a new fleet has
# none of; `[authority]` is a statement about one grant to one set of sessions;
# `[updates]` names a host; `[fleet]` is the source fleet's own NAME, and a copy
# that kept it would label its panes as the fleet it was copied from -- the exact
# confusion the name exists to prevent. A copy carrying any of them describes a fleet that
# does not exist on the new machine -- twelve parked entries naming transcripts
# that are not on that disk.
DROP = ("parked", "retired", "authority", "updates", "fleet")
PER_FLEET = EMPTY + DROP

# A per-fleet KEY inside a section that otherwise travels. `[mail]` is a
# preference -- which mailbox, how often to poll -- but `fleet` inside it is this
# fleet's own name in that mailbox, so a copy keeping it would address peers as
# the fleet it was copied from. Dropping the section instead would lose the
# mailbox; dropping the line keeps the useful part and discards the identity.
#
# Found by a test, not by the manual run: the mirror corrects it when a NEW name
# is supplied, and `--keep` supplies none -- so a kept copy carried the old name
# silently.
PER_FLEET_KEYS = (("mail", "fleet"),)

# Asked in this order, and each says what it is for rather than naming a key.
QUESTIONS = [
    ("human", "name", "Your name, as sessions should address you", None),
    ("human", "timezone", "Your timezone (e.g. America/New_York)", None),
    # Asked before [mail].fleet and separately from it. A fleet's NAME is a
    # property of the fleet; it lived under [mail] only because mail was the
    # first thing that needed a namespace, and membership needs the same name --
    # two fleets can share a machine, and until 2026-10-20 nothing could tell.
    ("fleet", "name", "A short name for THIS fleet (it labels its panes)", None),
]

# One identity, two readers. `fleet.config.fleet_name` prefers `[fleet].name`, but
# `fleetmail` reads `[mail].fleet` directly for its address namespace -- so an
# answer has to land in both or the fleet is called one thing by its panes and
# another by its mail. A derived config carried the SOURCE fleet's `[mail].fleet`
# until this was noticed: a new fleet addressing peers under the old one's name.
MIRROR = {("fleet", "name"): ("mail", "fleet")}


# The remote half of `--from`. Keeping a fleet.toml somewhere to copy is itself a
# step to remember, and the machine that HAS one is the obvious place to point at:
# `fleetinit --from otherbox --go`.
REMOTE_DEFAULT = "~/.config/fleet/fleet.toml"
SSH_TIMEOUT = "10"          # ConnectTimeout, so a dead host fails instead of hanging


def looks_remote(spec):
    """Whether `spec` names another machine rather than a file on this one.

    A local file that EXISTS always wins, checked by the caller before this is
    asked. What is left is ambiguous, so the rules are narrow and say why:

    * a `:` makes it a host spec -- `host:/path`, the scp spelling.
    * a `/` makes it a path that does not exist, which is an error worth
      reporting as a missing file rather than as an unreachable host.
    * a name ending `.toml` is a file someone meant to point at and mistyped;
      `ssh fleet.toml` would report that as a DNS failure, which sends the
      reader looking in the wrong place entirely.
    * anything else is a hostname.
    """
    if ":" in spec:
        return True
    if "/" in spec or spec.endswith(".toml"):
        return False
    return bool(spec)


def fetch_remote(spec):
    """`(text, label)` for a fleet.toml on another machine, over ssh.

    `cat` rather than `scp`: only the text is wanted, there is no temporary file
    to clean up afterwards, and the failure arrives on stderr where it can be
    quoted back. No `BatchMode` -- a human running this may well need to answer a
    passphrase prompt -- but a `ConnectTimeout`, so an unreachable host fails in
    seconds rather than hanging a command that looks like it is working.
    """
    host, _, path = spec.partition(":")
    path = path or REMOTE_DEFAULT
    label = "%s:%s" % (host, path)
    argv = ["ssh", "-o", "ConnectTimeout=" + SSH_TIMEOUT, host, "cat -- " + path]
    try:
        r = subprocess.run(argv, capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit("\n  could not run ssh: %s\n" % e)
    if r.returncode != 0:
        why = r.stderr.strip() or "ssh exited %d" % r.returncode
        sys.exit("\n  could not read %s\n    %s\n" % (label, why))
    if not r.stdout.strip():
        # An empty file is not a configuration, and silently proceeding would
        # write a fleet.toml with nothing in it but the answers to the prompts.
        sys.exit("\n  %s is empty -- refusing to build a configuration from it\n"
                 % label)
    return r.stdout, label


def read_source(spec):
    """`(text, label)` for `--from`, local or remote, or exit saying why not."""
    if spec and os.path.isfile(spec):
        with open(spec) as f:
            return f.read(), spec
    if spec and looks_remote(spec):
        return fetch_remote(spec)
    sys.exit("\n  no such file: %s\n" % spec)


def kind_of(name):
    """"empty", "drop" or None for a section name."""
    top = name.split(".")[0]
    if top in EMPTY:
        return "empty"
    return "drop" if top in DROP else None


def strip_per_fleet(text):
    """(text, emptied, dropped) with per-fleet content removed, by line.

    An emptied section keeps its header and the comment paragraph above it: that
    paragraph says what the section is for, which a fresh fleet needs more than
    an established one does.

    A dropped section takes that paragraph with it -- otherwise the copy keeps
    prose explaining a section that is no longer there, which is worse than
    keeping both or dropping both.
    """
    lines = text.splitlines(keepends=True)
    keep, emptied, dropped, i = [], [], [], 0
    while i < len(lines):
        m = re.match(r"\s*\[\[?([^\]]+)\]\]?\s*$", lines[i].rstrip("\n"))
        k = kind_of(m.group(1)) if m else None
        if k == "empty":
            emptied.append(m.group(1))
            keep.append(lines[i])                 # the header stays, its entries do not
            i += 1
            while i < len(lines) and not re.match(r"\s*\[", lines[i]):
                i += 1
            keep.append("\n")
            continue
        if k == "drop":
            dropped.append(m.group(1))
            while keep and keep[-1].lstrip().startswith("#"):
                keep.pop()
            while keep and not keep[-1].strip():
                keep.pop()
            i += 1
            while i < len(lines) and not re.match(r"\s*\[", lines[i]):
                i += 1
            continue
        keep.append(lines[i])
        i += 1
    text = "".join(keep)
    for table, key in PER_FLEET_KEYS:
        text, gone = drop_key(text, table, key)
        if gone:
            dropped.append("%s.%s" % (table, key))
    return text.rstrip("\n") + "\n", emptied, dropped


def drop_key(text, table, key):
    """(text, True) with `key` removed from `[table]`, by line."""
    lines = text.splitlines(keepends=True)
    head = [i for i, l in enumerate(lines) if l.strip() == "[%s]" % table]
    if not head:
        return text, False
    start = head[0] + 1
    end = start
    while end < len(lines) and not re.match(r"\s*\[", lines[end]):
        end += 1
    for i in range(start, end):
        if re.match(r"\s*%s\s*=" % re.escape(key), lines[i]):
            del lines[i]
            return "".join(lines), True
    return text, False


def set_value(text, table, key, value):
    """Set `key` under `[table]`, by line, whether or not it is already there.

    Only ever touches the one line. A key that is absent is appended under its
    header; one that is present has its value replaced and its comment kept.
    """
    lines = text.splitlines(keepends=True)
    head = [i for i, l in enumerate(lines) if l.strip() == "[%s]" % table]
    if not head:
        return text + '\n[%s]\n%s = "%s"\n' % (table, key, value)
    start = head[0] + 1
    end = start
    while end < len(lines) and not re.match(r"\s*\[", lines[end]):
        end += 1
    for i in range(start, end):
        m = re.match(r"(\s*)%s(\s*)=\s*(.*?)(\s*#.*)?$" % re.escape(key),
                     lines[i].rstrip("\n"))
        if m:
            lines[i] = '%s%s%s= "%s"%s\n' % (m.group(1), key, m.group(2) or " ",
                                             value, m.group(4) or "")
            return "".join(lines)
    lines.insert(start, '%s = "%s"\n' % (key, value))
    return "".join(lines)


def ask(prompt, default):
    """Ask, or return the default when there is nobody to ask."""
    if not sys.stdin.isatty():
        return default
    shown = " [%s]" % default if default else ""
    try:
        got = input("  %s%s: " % (prompt, shown)).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return default
    return got or default


def build(a, source_text, source_name):
    """(text, notes) for the fleet.toml this would write."""
    notes = []
    text, emptied, dropped = strip_per_fleet(source_text)
    if emptied:
        notes.append("emptied (kept the header, dropped the entries): %s"
                     % ", ".join(sorted(set(emptied))))
    if dropped:
        notes.append("dropped %d per-fleet section(s) from %s: %s"
                     % (len(dropped), source_name, ", ".join(sorted(set(dropped)))))
    try:
        have = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        have = {}
    for table, key, prompt, fallback in QUESTIONS:
        given = getattr(a, "name_of_fleet" if table == "fleet" else
                        key.replace("-", "_"), None)
        current = (have.get(table) or {}).get(key)
        value = given or (current if a.keep else None)
        if value is None:
            value = ask(prompt, current or fallback)
        if value:
            text = set_value(text, table, key, value)
            notes.append("[%s] %s = %r" % (table, key, value))
            also = MIRROR.get((table, key))
            # Keyed on the SECTION existing, not the key: the key has just been
            # stripped as per-fleet, so requiring it would mean the mirror never
            # fires. A fleet with a mailbox configured gets its name there; one
            # with no `[mail]` at all is left alone, since inventing the section
            # would declare a mailbox nobody asked for.
            if also and also[0] in have:
                text = set_value(text, also[0], also[1], value)
                notes.append("[%s] %s = %r  (the same name, for mail)"
                             % (also[0], also[1], value))
        elif current is None:
            notes.append("[%s] %s left unset -- edit it before spawning" % (table, key))
    return text, notes


def tmux(*a):
    argv = ["tmux"] + (["-L", SOCKET] if SOCKET else []) + list(a)
    env = dict(os.environ)
    env.pop("TMUX", None)          # never inherit the caller's server
    r = subprocess.run(argv, capture_output=True, text=True, env=env)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def label_panes(a, ours):
    """Stamp `@fleet` on this fleet's existing panes. The one-time adoption step.

    `fleetspawn` labels a pane when it creates one, so only panes that predate
    that need this -- which, when it landed, was all of them: zero carried
    `@fleet`, and that is why the tools include the unlabeled rather than
    excluding them. **Label first, then the exclusion can be made strict**; a
    correct end state reached in the wrong order empties every tool at once.

    It refuses to touch a pane already labeled with ANOTHER fleet's name. That is
    the one case where the label is doing its job, and overwriting it would be
    this fleet claiming somebody else's session.
    """
    rc, out, err = tmux("list-panes", "-a", "-F",
                        "#{pane_id}\t" + panes_mod.LABELS)
    if rc != 0:
        print("\n  could not list panes: %s\n" % (err or "tmux failed"))
        return 4
    todo, already, theirs = [], [], []
    for row in out.splitlines():
        f = (row.split("\t") + ["", ""])[:3]
        pane, agent, fleet = f[0], panes_mod.agent_label(f[1]), panes_mod.fleet_label(f[2])
        if not agent:
            continue
        if not fleet:
            todo.append((pane, agent))
        elif fleet == ours:
            already.append(agent)
        else:
            theirs.append((agent, fleet))
    print("\n  fleet %r" % ours)
    print("  already labeled: %d" % len(already))
    if theirs:
        print("  ANOTHER FLEET'S, left alone: "
              + ", ".join("%s@%s" % (n, f) for n, f in sorted(theirs)))
    if not todo:
        print("  nothing to label.\n")
        return 0
    for pane, agent in todo:
        print("  %s %s -> @fleet=%s" % (pane, agent, ours))
    if not a.go:
        print("\n  plan only -- re-run with --go\n")
        return 0
    bad = 0
    for pane, agent in todo:
        rc, _, err = tmux("set-option", "-p", "-t", pane, "@fleet", ours)
        if rc != 0:
            print("  FAILED on %s (%s): %s" % (pane, agent, err or "tmux failed"))
            bad += 1
    print("\n  labeled %d pane(s)%s\n"
          % (len(todo) - bad, "" if not bad else ", %d failed" % bad))
    return 4 if bad else 0


def main():
    version_flag()
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--from", dest="source", metavar="PATH",
                    help="an existing fleet.toml to take the shareable parts from")
    ap.add_argument("--name", help="[human] name")
    ap.add_argument("--timezone", help="[human] timezone")
    ap.add_argument("--fleet", dest="name_of_fleet",
                    help="[fleet] name -- this fleet's own short name, which labels "
                         "its panes and namespaces its mail")
    ap.add_argument("--keep", action="store_true",
                    help="with --from: keep the source's answers; ask nothing")
    ap.add_argument("--save-profile", metavar="PATH",
                    help="write the shareable parts of --from to PATH and stop")
    ap.add_argument("--label-panes", action="store_true",
                    help="stamp @fleet on this fleet's existing panes and stop -- "
                         "the one-time step for a fleet older than the label")
    ap.add_argument("--socket", metavar="NAME",
                    help="with --label-panes: the tmux server to label on")
    ap.add_argument("--no-link", dest="link", action="store_false",
                    help="do not run `install --go` afterwards (it is run by "
                         "default, so one command sets the machine up)")
    ap.add_argument("--go", action="store_true")
    a = ap.parse_args()
    global SOCKET
    SOCKET = a.socket

    cfg = fc.config_dir()
    if a.label_panes:
        ours = fc.fleet_name(fc.load())
        if not ours:
            sys.exit("\n  this fleet has no name. Declare one first:\n"
                     "    [fleet]\n    name = \"<short name>\"\n"
                     "  in %s/fleet.toml\n" % cfg)
        sys.exit(label_panes(a, ours))
    target = os.path.join(cfg, "fleet.toml")
    briefs = os.path.join(cfg, "briefs")

    if a.source:
        source_text, src = read_source(a.source)
    else:
        src = EXAMPLE
        with open(src) as f:
            source_text = f.read()

    # --save-profile is about the SOURCE, not about this machine's configuration,
    # so it neither reads nor writes <config>/ at all.
    if a.save_profile:
        text, emptied, dropped = strip_per_fleet(source_text)
        print("\n  profile from %s -> %s" % (src, a.save_profile))
        print("  empties: %s" % (", ".join(sorted(set(emptied))) or "nothing"))
        print("  drops:   %s" % (", ".join(sorted(set(dropped))) or "nothing"))
        if not a.go:
            print("\n  plan only -- re-run with --go\n")
            return
        ok, why = fc.write_verified(a.save_profile, text)
        print("\n  %s\n" % (why or "written"))
        sys.exit(0 if ok else 4)

    print("\n  config   %s" % cfg)
    print("  from     %s%s" % (src, "" if a.source else "  (the shipped example)"))
    if os.path.exists(target):
        print("\n  REFUSED: %s already exists. A configuration that is already there"
              "\n  is somebody's work; this tool will not overwrite it.\n" % target)
        sys.exit(2)

    text, notes = build(a, source_text, os.path.basename(src))
    for n in notes:
        print("  %s" % n)
    # EVERYTHING UP TO THE TMUX SERVER, in one command. The configuration was
    # only ever the first of four things a clean machine needed, and the other
    # three -- the conventions file this fleet.toml points at, the symlinks, and
    # knowing what order to do them in -- were left in a docs page. A setup whose
    # steps live in prose is a setup someone performs from memory and gets wrong.
    conventions = os.path.join(cfg, "conventions.md")
    make_conventions = not os.path.exists(conventions)
    print("\n  would create:")
    print("    %s" % target)
    print("    %s/" % briefs)
    if make_conventions:
        print("    %s   (from the example; fleet.toml points at it)" % conventions)
    else:
        print("    (conventions.md is already there -- left alone)")
    if a.link:
        print("    symlinks: %s --go   (tools -> ~/bin, skills -> ~/.claude/skills)"
              % INSTALL)
    if not a.go:
        print("\n  plan only -- re-run with --go\n")
        return

    try:
        os.makedirs(briefs, exist_ok=True)
    except OSError as e:
        sys.exit("\n  could not create %s: %s\n" % (briefs, e.strerror or e))
    ok, why = fc.write_verified(target, text)
    if not ok:
        sys.exit("\n  %s\n" % why)
    print("\n  created %s" % target)
    print("  created %s/" % briefs)

    # Copied, never overwritten. The file is the fleet's accumulated lessons once
    # it has any, and a second `fleetinit` on a machine that already has one must
    # not replace them with the shipped example.
    if make_conventions:
        try:
            shutil.copyfile(CONVENTIONS_EXAMPLE, conventions)
            print("  created %s" % conventions)
        except OSError as e:
            print("  !! could not create %s: %s" % (conventions, e.strerror or e))
            print("     cp %s %s" % (CONVENTIONS_EXAMPLE, conventions))

    if a.link:
        print("\n  linking (%s --go):" % INSTALL)
        # FLEET_CONFIG pinned to the directory just written, not left to the
        # environment: `fleetinit --go` may have been pointed somewhere else
        # entirely, and an install that linked against a DIFFERENT configuration
        # than the one just created is the kind of mismatch nobody re-checks.
        env = dict(os.environ, FLEET_CONFIG=cfg)
        try:
            r = subprocess.run([INSTALL, "--go"], env=env, capture_output=True,
                               text=True)
        except (OSError, subprocess.SubprocessError) as e:
            print("  !! could not run install: %s" % e)
            r = None
        if r is not None:
            for ln in (r.stdout or "").splitlines():
                print("    " + ln)
            # Propagated, not swallowed. `install` exits non-zero when a link
            # could not be made, and a fleetinit that reported success over it
            # would recreate the silent-success bug one layer up.
            if r.returncode != 0:
                sys.exit("\n  install failed (exit %d) -- the setup is INCOMPLETE\n"
                         % r.returncode)

    print("\n  next, and these are the only steps left --")
    print("    tmux new-session -d -s main          # which server is yours to choose")
    print("    cp %s %s/<name>.md" % (BRIEF_EXAMPLE, briefs))
    print("    $EDITOR %s/<name>.md" % briefs)
    print("    fleetspawn <name> <dir> --window <title> --color <color> --go\n")


if __name__ == "__main__":
    main()
