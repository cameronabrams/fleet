#!/usr/bin/env python3
"""fleetwatch - DERIVE which live cluster work has a local watcher, and which does not.

The re-arm ledgers record what a session *believes* it has armed. That record is a
second copy of state kept by hand, so it inherits the defect it exists to fix: a
session cannot tell from inside that its ledger is stale, for the same reason it
cannot tell its monitors are gone. Arming writes an entry; finishing writes nothing.
Between 2026-09-04 and 2026-09-11 a ledger was wrong five times, in three ways, and
every one was caught by an external check rather than by the ledger working.

So: do not record the inventory. Derive it.

  live SLURM work   <- squeue/sacct, keyed by array-parent job id and WorkDir
  local watchers    <- /proc, any claude child whose cmdline names a job id

and report the disagreements. The case that matters most is the one no ledger can
ever catch: a job that was never watched at all, because you cannot record the
monitor you forgot to create. Observed twice, 2026-09-10 and 2026-09-11.

What the LEDGER is still for, and what this does not replace: the re-arm RECIPE
(the actual poll loop) and the RATIONALE (why the campaign matters). Neither is
recoverable by inspecting a process that no longer exists.

It also reports the other half of that question. A watcher can run perfectly and
its RESULT still never reach the session: fleetnudge falls back to a phone push
when it cannot type into a pane, and [notify] mute_file silences that push by
design. Then nobody was told and <state>/nudges.log is the only trace -- while the
job here reads as WATCHED, which is the reassuring direction.

  fleetwatch            report
  fleetwatch <session>  only that session's work -- what a ledger should point AT
                        instead of hand-syncing job ids and task counts
  fleetwatch --json     machine-readable
"""
import datetime, json, os, re, subprocess, sys, glob
from zoneinfo import ZoneInfo
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet.nudgelog import (DANGLING_AFTER, INFORMED_LEGACY, informed_times,
                            last_nudge_word, lost_the_news, resolved_by_hand)
from fleet import version_flag
from fleet.procs import alive
from fleet import reach
from fleet.panes import is_agent_pane, ours_agent_pane
from fleet.transcripts import session_name

CFG     = fc.load()
OURS    = fc.fleet_name(CFG)   # which fleet this one is; "" before fleetinit has run
# No `[cluster.<name>]` at all is a configuration, not a failure: a machine with
# no scheduler has no cluster work, and that is known rather than unknown. It
# used to raise here, at import, and take the rest of this report down with it --
# watcher liveness, nudge delivery, attached clients, none of which needs a
# cluster -- while every consumer read the traceback as "runtime unknown":
# `fleetupgrade` refused every session and the board drew `?` in every row.
# Several clusters with none named still raises; that one IS a mistake.
CLUSTER = fc.cluster(CFG) if CFG.get("cluster") else None
JOB_RE  = re.compile(r"\b(" + CLUSTER["job_id_re"] + r")\b") if CLUSTER else None
# The same pattern anchored, for the opposite question. `JOB_RE` pulls an id OUT
# of a command line, so it is deliberately unanchored; deciding whether a
# registration's job IS a job of this cluster needs the whole string, or
# `crawl-26568445` reads as cluster work and goes to sacct under a name it has
# never heard. Configured, not guessed: `job_id_re` is the fleet's own statement
# of what a job id looks like here (`2[0-9]{7}` on one cluster, `[0-9]{6,9}` on
# another) and nothing else in this tool is entitled to invent one.
# Grouped before anchoring, because an alternation would otherwise bind the
# anchor to its last branch alone: `a|b\Z` would match a bare "a".
JOB_ID  = re.compile(r"(?:" + CLUSTER["job_id_re"] + r")\Z") if CLUSTER else None
HELD    = tuple((CLUSTER or {}).get("held_reasons", ["JobHeldUser", "JobHeldAdmin"]))

# WorkDir -> owning session. Explicit rather than heuristic: an unmatched path is
# reported as UNATTRIBUTED, never guessed. Add rows as campaigns appear.
OWNERS = fc.owners(CFG)   # WorkDir fragment -> session, from fleet.toml

MYTREE = os.getpid()
def _ancestors():
    out, pid = set(), os.getpid()
    for _ in range(8):
        try:
            ppid = open(f"/proc/{pid}/stat").read().split(") ", 1)[1].split()[1]
        except Exception:
            break
        out.add(ppid); pid = ppid
        if ppid == "1":
            break
    return out
ANCESTORS = _ancestors()

def sh(*a, **kw):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=kw.get("t", 240)).stdout
    except Exception:
        return ""

def owner_of(workdir):
    for frag, who in OWNERS:
        if frag in workdir:
            return who
    return "UNATTRIBUTED"

def live_jobs():
    """Array-parent job id -> {tasks, states, workdir}. One ssh round trip.

    With no cluster configured: no jobs, and that answer is GOOD (`ok` True) --
    there is nothing a query could have found. No ssh is attempted.
    """
    if CLUSTER is None:
        return {}, True, ""
    # `scontrol show reservation` rides the SAME round trip. coord proposed it as
    # "one ssh call on a schedule that already exists"; folding it into the call
    # that is already being made is cheaper still, and it cannot add a failure
    # mode of its own -- `2>&1` means its complaint is just more text to record,
    # and it sits before `--END--` so a cluster that cannot run it still produces
    # the marker that says the query worked.
    remote = ("squeue -u __USER__ -h -o '%F|%T|%r' | sort | uniq -c | "
             "awk '{print $2\"|\"$1}'; echo '--WD--'; "
             "for j in $(squeue -u __USER__ -h -o '%F' | sort -u); do "
             "printf '%s|%s\\n' \"$j\" \"$(sacct -j $j -X -n -P --format=WorkDir%%80 2>/dev/null | head -1)\"; done; "
             "echo '--RES--'; scontrol show reservation 2>&1; "
             "echo '--END--'"
             ).replace("__USER__", CLUSTER["user"])
    out = sh("ssh", "-o", "ConnectTimeout=20", CLUSTER["ssh_host"], remote)
    # An empty squeue and a failed ssh both produce no job lines. Without a marker
    # the second reads as "no live work" -- and every dead watcher as FINISHED.
    ok = "--END--" in out.splitlines()
    jobs, wd, phase, res = {}, {}, 0, []
    for line in out.splitlines():
        if line.strip() == "--END--":
            break
        if line.strip() == "--WD--":
            phase = 1; continue
        if line.strip() == "--RES--":
            phase = 2; continue
        if phase == 2:
            # Collected, never parsed. See fleet.reach: whether this site uses
            # MAINT reservations at all is the open question, and a parser
            # written against a guess would answer it with its own assumptions.
            res.append(line.rstrip())
            continue
        p = line.strip().split("|")
        if phase == 0 and len(p) == 4:
            jid, state, reason, n = p[0], p[1], p[2], p[3]
            j = jobs.setdefault(jid, {"tasks": 0, "states": {}, "reasons": {}})
            j["tasks"] += int(n)
            j["states"][state] = j["states"].get(state, 0) + int(n)
            j["reasons"][reason] = j["reasons"].get(reason, 0) + int(n)
        elif phase == 1 and len(p) == 2:
            wd[p[0]] = p[1]
    for jid, j in jobs.items():
        j["workdir"] = wd.get(jid, "")
        j["owner"] = owner_of(j["workdir"])
        # HELD work cannot produce a result, so there is nothing a watcher could
        # observe and "no watcher" is correct by construction -- not an oversight.
        # Only reasons requiring a HUMAN to release count. `Dependency`, `Resources`
        # and `Priority` all start on their own, so they DO need a watcher.
        # Derived rather than taken from a ledger note: the moment the reason stops
        # being a held one, this flips to needing a watcher with no file to update.
        # (2026-09-09: two tasks held pending a human decision were flagged as
        # unwatched two days later; this is the derived answer.)
        j["held"] = bool(j["reasons"]) and all(
            r in HELD for r in j["reasons"])
    return jobs, ok, "\n".join(res).strip()

TERMINAL = ("COMPLETED", "FAILED", "CANCELLED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL",
            "PREEMPTED", "BOOT_FAIL", "DEADLINE", "REVOKED")

def final_states(jids):
    """job id -> set of sacct states, for jobs no longer in squeue. None if the
    query itself failed. A job id sacct has never heard of maps to an empty set."""
    if not jids:
        return {}
    remote = "".join(
        "printf '%s|%s\\n' " + j + " \"$(sacct -j " + j + " -X -n -P --format=State 2>/dev/null "
        "| awk '{print $1}' | sort -u | tr '\\n' ,)\"; " for j in sorted(jids)) + "echo '--END--'"
    out = sh("ssh", "-o", "ConnectTimeout=20", CLUSTER["ssh_host"], remote)
    if "--END--" not in out.splitlines():
        return None
    res = {}
    for line in out.splitlines():
        p = line.split("|", 1)
        if len(p) == 2:
            res[p[0]] = {x for x in p[1].split(",") if x}
    return res

WATCHDIR = os.path.join(fc.state_dir(CFG), "watchers")
CLUSTER_NAME = (CLUSTER or {}).get("name", "cluster")
REACHFILE = reach.reach_path(fc.state_dir(CFG))
RESFILE   = reach.reservations_path(fc.state_dir(CFG))

# Delivery, not watching. Both are "is my work being seen?", so both belong here.
NUDGELOG  = os.path.join(fc.state_dir(CFG), "nudges.log")
MAILINDEX = os.path.join(fc.state_dir(CFG), "mail-delivered.json")
NUDGE_DAYS = 7              # window for the delivery section; named in its output

def work_kind(r):
    """What KIND of work a registration is on: "local", "cluster" or "unclassified".

    Every registration used to be read as cluster work, so the single question
    asked of it -- "is this job still in squeue" -- had only one possible answer
    for anything else. A watch on a local process is never in squeue, and its
    absence was reported as the monitor's work having died while the process was
    alive and well (2026-10-27).

    "local" is DECLARED, by `fleetregister --local`: the registered pid is the
    work itself rather than a poller of work running elsewhere, so its liveness
    is the whole answer and no scheduler can add to it.

    "cluster" is decided against `job_id_re`, which the fleet already configures
    to say what a job id looks like here. That is a statement in the
    configuration, not an inference about intent -- the distinction this tool
    cares about, since inferring watcher-ness from text is the family it exists
    to catch.

    "unclassified" is the honest remainder: a job that cannot be an id of the
    configured cluster and was not declared local. Nothing here can say whether
    that work is still running, and cannot-tell is not clear. Every registration
    written before `--local` existed lands here, which is the point: the alarm
    has to stop for records already on disk, not only for ones written next.
    """
    if str(r.get("work", "")) == "local":
        return "local"
    if JOB_ID is not None and JOB_ID.match(str(r.get("job", ""))):
        return "cluster"
    return "unclassified"


def registered():
    """AUTHORITATIVE: watchers that registered themselves, filtered by liveness.

    No cmdline parsing. A registration claims {pid, job}; `kill -0` falsifies it
    the moment the watcher dies. Contrast a ledger, which claims "I am watching X"
    in prose that nothing can check.

    Returns (live, dead, by_job, kinds): live maps session -> {job ids}; dead
    lists registrations whose pid is gone -- a watcher that DIED, which no other
    check here detects; by_job maps (session, job) -> pid; kinds maps the same
    key to `work_kind`.

    `by_job` exists because one watcher may poll several jobs, which the registry
    already models as several rows sharing a pid. Without it the only question
    that could be asked of a registration was "is this job still in squeue", and
    the first job of a set to finish read as a fault while its watcher was alive
    and correctly polling the rest.

    `kinds` is read HERE, from the same pass over the same files, rather than by
    a second reader of the directory: two readers of one fact each with its own
    fallback are how they quietly stop agreeing.
    """
    live, dead, by_job, kinds = {}, [], {}, {}
    for f in glob.glob(WATCHDIR + "/*.json"):
        try:
            r = json.load(open(f))
        except Exception:
            continue
        r["_kind"] = work_kind(r)
        # No starttime -> pre-2026-09-12 registration, identity unverifiable.
        # Read it as DEAD rather than trusting it: fail toward alarm.
        if r.get("starttime") and alive(r.get("pid"), r["starttime"]):
            live.setdefault(r["session"], set()).add(str(r["job"]))
            by_job[(r["session"], str(r["job"]))] = r.get("pid")
            kinds[(r["session"], str(r["job"]))] = r["_kind"]
        else:
            r["_file"] = f; dead.append(r)
    return live, dead, by_job, kinds


def split_stale(live, by_job, jobs, kinds=None):
    """(stale, partway, other) for registrations whose job is no longer in squeue.

    `kinds` says which registrations squeue is entitled to answer for. It
    defaults to None, meaning every row is cluster work -- the answer this
    function gave before it could ask, so an untaught caller is no worse off than
    it was. `other` collects the rows squeue cannot speak to: "local", where the
    registered pid IS the work and `registered` has already found it alive, and
    "unclassified", where nothing here knows what the work was.

    A registration is PARTWAY, not stale, when the same PID still watches a job
    that is live: the watcher is working through a set and will exit when the set
    is done, and the registration goes with it.

    Keyed on the pid rather than the session on purpose. Two watchers in one
    session are two watchers; letting a healthy one vouch for a dead-ended one
    would hide exactly the case this check exists for.

    A pid that is None (an old registration without one) can vouch for nothing --
    it is not an identity, and matching Nones to each other would let any two such
    rows cover for one another. Those stay stale, which is the alarming direction.
    """
    stale, partway, other = [], [], []
    for sess, ids in live.items():
        for j in ids:
            if j in jobs:
                continue
            pid = by_job.get((sess, j))
            kind = (kinds or {}).get((sess, j), "cluster")
            if kind != "cluster":
                other.append({"session": sess, "job": j, "pid": pid, "kind": kind})
                continue
            siblings = sorted(
                j2 for (s2, j2), p2 in by_job.items()
                if s2 == sess and j2 in jobs and pid is not None and p2 == pid)
            if siblings:
                partway.append({"session": sess, "job": j, "pid": pid,
                                "still_watching": siblings})
            else:
                stale.append({"session": sess, "job": j, "pid": pid})
    for bucket in (stale, partway, other):
        bucket.sort(key=lambda r: (r["session"], r["job"]))
    return stale, partway, other

def watchers():
    """session name -> set of job ids its live child processes reference."""
    out = {}
    # `list-panes -a` crosses tmux sessions; only this fleet's panes count, or a
    # stranger's poll loop is advertised as an unregistered watcher of our work.
    panes = [r.split("\t")[0] for r in
             sh("tmux", "list-panes", "-a", "-F",
                "#{pane_pid}\t#{@agent}\t#{@fleet}").splitlines()
             if len(r.split("\t")) == 3
             and ours_agent_pane(r.split("\t")[1], r.split("\t")[2], OURS)]
    for sp in panes:
        for c in sh("pgrep", "-P", sp).split():
            try:
                cmd = open(f"/proc/{c}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
            except OSError:
                continue
            m = re.match(r"\s*claude\b.*?--name\s+(\S+)", cmd)
            if not m:
                continue
            # the name it answers to now: /rename changes the transcript, not argv
            try:
                argv = [x for x in open(f"/proc/{c}/cmdline", "rb").read().decode(errors="replace").split("\0") if x]
                name = session_name(int(c), os.readlink(f"/proc/{c}/cwd"), argv)[0] or m.group(1)
            except OSError:
                name = m.group(1)
            found = set()
            for k in sh("pgrep", "-P", c).split():
                if k == str(MYTREE) or k in ANCESTORS:
                    continue          # never count the process running this check
                try:
                    kc = open(f"/proc/{k}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
                except OSError:
                    continue
                found |= polled_jobs(kc)
            if found:
                out.setdefault(name, set()).update(found)
    return out

def polled_jobs(cmdline):
    """Job ids a command line polls in a loop; empty for anything else.

    A job id in a cmdline is NOT evidence of watching it -- a one-shot
    `sacct -j <id>`, a grep, or this very tool's own check command all mention
    one. Observed 2026-09-12: the coordinator ran a verification command naming a
    job and fleetwatch reported it as a watcher -- the self-match family this tool
    exists to help catch, committed by the tool itself. It failed toward "fine":
    a job looks watched because somebody merely looked at it.
    Require positive evidence of a POLL LOOP -- a monitor sleeps between polls; a
    transient command does not."""
    if JOB_RE is None or not re.search(r"\bsleep\s+\d", cmdline):
        return set()
    return set(JOB_RE.findall(cmdline))

def parse_clients(listed, who_out):
    """[{tty, user, created, idle, origin}] from `tmux list-clients` and `who`.

    Pure, so it can be tested without a tmux server or a login session.

    `who` prints the login source in parentheses for a remote terminal and
    nothing for a local console, and names the tty as `pts/0` where tmux says
    `/dev/pts/0`."""
    origin = {}
    for line in who_out.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        host = re.search(r"\(([^)]*)\)\s*$", line)
        origin["/dev/" + parts[1]] = host.group(1) if host else "local console"
    out = []
    for line in listed.splitlines():
        f = line.split("\t")
        if len(f) < 4 or not f[0]:
            continue
        out.append({"tty": f[0], "user": f[1],
                    "created": int(f[2]) if f[2].isdigit() else None,
                    "activity": int(f[3]) if f[3].isdigit() else None,
                    "origin": origin.get(f[0], "unknown")})
    return out

def clients():
    """Who is attached to the tmux server right now, and from where.

    Attaching hands a person every pane in the fleet: sessions already past the
    folder-trust prompt, weeks of context, and peers that treat a line from one
    of them as a teammate's request. Worth SEEING.

    Not worth authenticating here. Whoever can attach can equally read
    `~/.claude/.credentials.json`, the gh token and the ssh key -- they sit in
    the same account and need no tmux -- so a second lock on this one door
    defends nothing that is not already open. This reports; it does not guard.

    Returns (clients, error). An error is NOT "nobody is attached": a failed
    `tmux list-clients` and an unattached server both produce no rows, and only
    one of them means what an empty list looks like."""
    try:
        r = subprocess.run(["tmux", "list-clients", "-F",
                            "#{client_tty}\t#{client_user}\t#{client_created}\t#{client_activity}"],
                           capture_output=True, text=True, timeout=20)
    except Exception as e:
        return [], str(e)
    if r.returncode != 0:
        return [], (r.stderr.strip() or "tmux exited %d" % r.returncode)
    return parse_clients(r.stdout, sh("who")), None

def _when(rec):
    """The record's own timestamp, offset and all. None if it has none worth trusting."""
    try:
        return datetime.datetime.strptime(rec["time"], "%Y-%m-%dT%H:%M:%S%z")
    except (KeyError, TypeError, ValueError):
        return None

def _stamp(rec):
    t = str(rec.get("time", ""))
    # keep the recorded offset: these are wall-clock times from whatever zone the
    # host was in, and a bare "16:08" is the wrong answer in the other one.
    return f"{t[:10]} {t[11:16]} {t[19:]}" if len(t) >= 20 else t or "?"

def _reached_phone(rec):
    """Did the fallback push actually go out? fleetnudge writes what happened --
    'push sent (HTTP 200)', 'push muted (<file> exists)', 'push FAILED: ...', or
    'no [notify] in fleet.toml'. Only a 2xx means a human was told by some channel.
    A record with NO push field is unknown, and unknown reads as NOT told: an
    alarm that turns out to be nothing costs a look, the reverse costs the run."""
    return bool(re.match(r"push sent \(HTTP 2\d\d\)", str(rec.get("push", ""))))

def nudge_holes(only=None, days=NUDGE_DAYS):
    """Lines that never reached a session, from <state>/nudges.log.

    Nothing else in this tool sees these. A job whose watcher ran, fired, and
    failed to hand over its result reads as WATCHED above -- the reassuring
    direction (docs/checks-that-reassure.md B), and with the push muted there is
    no second channel to notice from.

    An ABSENT log is genuinely "no nudge was ever sent": fleetnudge creates it on
    first use. An unreadable or unparseable one is not, and is reported as itself,
    because "no rows" must never be something the check produced by failing.
    """
    res = {"silent": [], "pushed": [], "dangling": [], "older": 0, "resolved": 0,
           "bad_lines": 0,
           "unreadable": None, "days": days, "mail_stuck": 0, "mail_error": None,
           "log": NUDGELOG}
    if os.path.exists(MAILINDEX):
        # Mail that was quarantined, or written to a drop and never nudged, is a
        # delivery hole this log cannot see -- it never became a nudge. Count it so
        # an empty section below is not read as "everything got through"; the rows
        # themselves belong to `fleetmail status`, which owns that index.
        try:
            with open(MAILINDEX) as f:
                res["mail_stuck"] = sum(1 for v in json.load(f).values()
                                        if v.get("outcome") == "quarantined"
                                        or v.get("nudged") is False)
        except (OSError, ValueError) as e:
            res["mail_error"] = str(e)
    if not os.path.exists(NUDGELOG):
        return res
    try:
        with open(NUDGELOG) as f:
            raw = f.read().splitlines()
    except OSError as e:
        res["unreadable"] = str(e); return res

    recs = []
    for line in raw:
        if not line.strip():
            continue
        try:
            r = json.loads(line)
        except ValueError:
            res["bad_lines"] += 1; continue
        if _when(r) is None:
            res["bad_lines"] += 1; continue
        recs.append(r)

    now = datetime.datetime.now(datetime.timezone.utc)
    cut = now - datetime.timedelta(days=days)
    # the last word on each session/job, for the dangling check below. Shared
    # with the clearing tool, and it ignores `informed` records: those are
    # assertions about a nudge, not outcomes of one.
    last = last_nudge_word(recs)

    informed = informed_times(recs)
    for r in recs:
        if only and r.get("session") != only:
            continue
        t, out = _when(r), r.get("outcome")
        if t < cut:
            res["older"] += int(out == "not delivered" and lost_the_news(r)
                                and not resolved_by_hand(r, informed))
            continue
        if out == "not delivered" and lost_the_news(r) and resolved_by_hand(r, informed):
            res["resolved"] += 1
        elif out == "waiting" and resolved_by_hand(r, informed) and last.get(
                (r.get("session"), str(r.get("job")))) is r:
            res["resolved"] += 1
        elif out == "not delivered" and lost_the_news(r):
            # A later nudge for the same session and job may have carried the news
            # anyway (seen 2026-09-17, 13:22 lost and 14:44 delivered). Annotate;
            # do NOT suppress -- a different message about the same job is not this
            # message, and suppressing would make the check fail toward fine.
            later = sorted(_when(x) for x in recs
                           if x.get("session") == r.get("session")
                           and str(x.get("job")) == str(r.get("job"))
                           and x.get("outcome") == "delivered" and _when(x) > t)
            row = dict(r, _later=_stamp({"time": later[0].strftime("%Y-%m-%dT%H:%M:%S%z")})
                       if later else None)
            (res["pushed"] if _reached_phone(r) else res["silent"]).append(row)
        elif (out == "waiting"
              and last.get((r.get("session"), str(r.get("job")))) is r
              and (now - t).total_seconds() > DANGLING_AFTER):
            # fleetnudge logs every retry, then always logs an outcome -- delivered
            # or not delivered -- before it exits. A 'waiting' that is the last word
            # means it never got to either: killed mid-retry, so it neither delivered
            # nor pushed, and no other record of the attempt exists.
            res["dangling"].append(r)
    return res

def print_hole(r):
    who = r.get("session") or "?"
    if r.get("mail_from"):
        who += f" (mail from {r['mail_from']})"
    print("   %s  %s / %s" % (_stamp(r), who, r.get("job", "?")))
    reason = str(r.get("reason") or "no reason recorded")
    print("      %s" % (reason[:140] + " ..." if len(reason) > 140 else reason))
    print("      push: %s" % r.get("push", "not recorded -- assume nobody was told"))
    if r.get("_later"):
        print("      a later nudge to this session/job landed %s -- confirm it carried this"
              % r["_later"])

def _stamp_epoch(t):
    """A wall-clock time in the human's zone, labeled. An unlabeled time in the
    wrong zone reads as right, which is why fc.display_zone makes the caller
    label it."""
    if not t:
        return "?"
    tz, _ = fc.display_zone(CFG)
    try:
        return datetime.datetime.fromtimestamp(t, ZoneInfo(tz)).strftime("%Y-%m-%d %H:%M %Z")
    except Exception:
        return datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d %H:%M ?")

def _ago(t):
    if not t:
        return "?"
    n = max(0, int(datetime.datetime.now().timestamp() - t))
    return "%dm" % (n // 60) if n < 5400 else "%dh" % (n // 3600)

def print_clients(attached, err):
    """Who can see and type into every pane in this fleet, right now."""
    if err:
        print("\n!! COULD NOT LIST TMUX CLIENTS (%s)." % err)
        print("   This is NOT \"nobody is attached\": a failed query and an unattached")
        print("   server look identical from here, and only one of them is reassuring.")
        return
    if not attached:
        print("\n   no tmux client attached (the fleet runs; nobody is watching a pane).")
        return
    label = "!! MORE THAN ONE CLIENT IS ATTACHED" if len(attached) > 1 else "   attached"
    print("\n%s to the tmux server (%d):" % (label, len(attached)))
    for c in sorted(attached, key=lambda c: c["created"] or 0):
        print("   %-12s %-10s since %s   idle %-5s from %s" % (
            c["tty"], c["user"], _stamp_epoch(c["created"]),
            _ago(c["activity"]), c["origin"]))
    if len(attached) > 1:
        print("   Each of these sees and can type into every pane. If one is not you:")
        print("   the fleet is not the boundary, the account is -- whoever holds it also")
        print("   reads the Claude credentials, the gh token and the ssh key, none of")
        print("   which need tmux. Detach the stranger, then rotate those three.")

def print_delivery(h):
    """The delivery half of the report. Prints nothing when there is nothing to
    say AND the log could be read; says so when it could not."""
    if h["unreadable"]:
        print("\n!! CANNOT READ %s (%s)." % (h["log"], h["unreadable"]))
        print("   Nothing below about delivery is a clean result; it is no result.")
    if h["bad_lines"]:
        print("\n!! %d unparseable line(s) in %s -- a hole could be in any of them."
              % (h["bad_lines"], h["log"]))
    if h["silent"]:
        print("\n!! NUDGE NEVER ARRIVED AND NO PUSH WENT OUT (last %d days) -- the session"
              % h["days"])
        print("   was not told, the phone was not told, and this log is the only trace.")
        for r in h["silent"]:
            print_hole(r)
    if h["pushed"]:
        print("\n   not delivered, but the phone push did go out (last %d days) -- a human"
              % h["days"])
        print("   was told; the session still never got the line:")
        for r in h["pushed"]:
            print_hole(r)
    if h["dangling"]:
        print("\n!! FLEETNUDGE STOPPED MID-RETRY -- it logged 'waiting' and then nothing.")
        print("   It exits through an outcome, so it was killed before it could deliver,")
        print("   give up, or push. Nothing else recorded the attempt.")
        for r in h["dangling"]:
            print("   %s  %s / %s   last said: %s" % (_stamp(r), r.get("session", "?"),
                  r.get("job", "?"), r.get("reason", "?")))
    if h["older"]:
        print("\n   (%d undelivered nudge(s) older than %d days, not shown)"
              % (h["older"], h["days"]))
    # Dim and counted, not silent. Somebody asserting that a result arrived is
    # weaker evidence than a delivery, so it leaves a mark a reader can audit in
    # the log -- and it ages out of the window like everything else here rather
    # than becoming a line that is always on the screen.
    if h["resolved"]:
        print("\n   (%d cleared by hand -- someone recorded that the result arrived"
              " another way; see `informed` in %s)" % (h["resolved"], h["log"]))
    if h["mail_error"]:
        print("\n!! cannot read %s (%s) -- undelivered mail is not counted below."
              % (MAILINDEX, h["mail_error"]))
    if h["mail_stuck"]:
        print("\n   %d piece(s) of mail need a human -- quarantined, or written to a drop"
              % h["mail_stuck"])
        print("   and never nudged. Those never became nudges, so they are not above:")
        print("   run `fleetmail status`.")

def known_sessions():
    """Names this tool will accept as a filter. Derived, never a hand-kept list.

    `[colors]` is the fleet's membership roster -- fleetnudge refuses a name with
    no entry for the same reason -- plus anything named as an owner in `[owners]`
    and anything holding a watcher registration, since a session can watch work
    without owning a directory."""
    out = set(fc.colors(CFG)) | {who for _, who in OWNERS}
    for f in glob.glob(WATCHDIR + "/*.json"):
        try:
            with open(f) as fh:
                out.add(str(json.load(fh).get("session") or ""))
        except Exception:
            continue
    return {n for n in out if n and n != "UNATTRIBUTED"}

def parse_args(argv, known):
    """(session or None, want_json), or exit 2. Pure, so it can be tested.

    AN UNKNOWN ARGUMENT IS REFUSED, NOT ANSWERED. `fleetwatch list` -- an invented
    subcommand -- used to be taken as a session filter: it matched nothing, the
    job table came back empty, and the tool printed "no live cluster work", which
    reads as a quiet cluster rather than as a typo. Reported 2026-09-25 after that
    line was quoted as this tool's verdict while a live 8-task array was running.

    This is the failure this tool exists to catch, committed by the tool itself
    for the second time. A false all-clear is worse than an error, because nobody
    investigates a reassurance."""
    session, want_json = None, False
    for a in argv:
        if a == "--json":
            want_json = True
        elif a in ("-h", "--help"):
            print(__doc__)
            raise SystemExit(0)
        elif a.startswith("-"):
            print("fleetwatch: unknown option %r. Run with --help." % a, file=sys.stderr)
            raise SystemExit(2)
        elif session is not None:
            print("fleetwatch: unexpected second argument %r -- one session at a time."
                  % a, file=sys.stderr)
            raise SystemExit(2)
        elif a not in known:
            print("fleetwatch: %r is not a session this fleet knows, so there is nothing\n"
                  "  to filter by and no answer to give. Refused rather than answered:\n"
                  "  as a filter it would match nothing and print \"no live cluster work\",\n"
                  "  which reads as a quiet cluster rather than a typo.\n"
                  "  Known: %s\n"
                  "  For the whole fleet, run fleetwatch with no arguments."
                  % (a, ", ".join(sorted(known)) or "(none)"), file=sys.stderr)
            raise SystemExit(2)
        else:
            session = a
    return session, want_json

def down_line(down, entry):
    """One line saying how long the cluster has been unreachable.

    `None` is NOT zero. A fleet whose state directory was just created has not
    observed a cluster that has been down for no time at all, and saying so would
    invent an outage that started when the file did.

    The absolute time is shown in the human's own zone and LABELED, because an
    unlabeled time in the wrong zone reads as right -- the same rule this
    repository applies to every other timestamp a person reads.
    """
    if down is None:
        return ("no successful query has ever been recorded, so there is no "
                "duration to give -- this is the first failure seen, or the "
                "state directory is new")
    zone, _why = fc.display_zone(CFG)
    try:
        when = datetime.datetime.fromtimestamp(entry["last_good"], ZoneInfo(zone))
    except Exception:
        # The host's zone, still labeled by %Z. `time` is not imported in this
        # module, and the first version of this fallback used it -- it would have
        # raised precisely when the zone lookup had already failed, turning a
        # cosmetic problem into a crash in the middle of an outage report.
        when = datetime.datetime.now().astimezone().fromtimestamp(
            entry["last_good"]).astimezone()
    stamp = when.strftime("%Y-%m-%d %H:%M %Z")
    return "unreachable for %s -- last good %s" % (duration(down), stamp)


def duration(seconds):
    """`1h 20m`, `3d 4h`, `45s`. Coarse on purpose: nobody acts on the seconds of
    a two-day outage, and a bare count of them has to be divided by the reader."""
    s = int(seconds)
    if s < 90:
        return "%ds" % s
    if s < 3600:
        return "%dm" % (s // 60)
    # Hours and minutes from one hour, not from ninety: this threshold was
    # borrowed from `fleetboard.age`, where it suits the age of a cached reading.
    # An OUTAGE is read differently -- "80m" makes the reader do the division at
    # the moment they are deciding whether to care.
    if s < 172800:
        return "%dh %dm" % (s // 3600, (s % 3600) // 60)
    return "%dd %dh" % (s // 86400, (s % 86400) // 3600)


def main():
    version_flag()
    only, want_json = parse_args(sys.argv[1:], known_sessions())
    jobs, cluster_ok, reservations = live_jobs()
    # Stamped on EVERY run, success or not: only a success moves `last_good`, but
    # `last_checked` moving either way is what distinguishes "down since 08:35"
    # from "nobody has looked since 08:35".
    # Not stamped at all without a cluster: there is nothing to have reached, and
    # a `last_good` recorded for a cluster named by default would be invented.
    reach_entry = (reach.record(REACHFILE, CLUSTER_NAME, cluster_ok)
                   if CLUSTER else {})
    # None while the cluster is READABLE. The elapsed time since the last good
    # read is ~0 on a successful run, and "down_for: 0.0005" invites a consumer
    # to render "down for 0s" on a cluster that is perfectly fine.
    down = None if cluster_ok else reach.down_for(reach_entry)
    if cluster_ok:
        # With no cluster this is a no-op: the table is "", which `reach`
        # refuses to record as an observation.
        # Only when the query worked -- an empty string from a failed ssh is not
        # an observation that the reservation table was empty.
        reach.record_reservations(RESFILE, CLUSTER_NAME, reservations)
    reg, dead_reg, by_job, kinds = registered()
    # A registration the scheduler cannot speak to is separated BEFORE the sacct
    # classification below, not after. `final_states` interpolates each job id
    # into a remote shell command, so sending it a name that was never a job id
    # asked the cluster about `crawl` and read the inevitable "sacct has never
    # heard of it" back as "wrong id in the registration?" -- a second false
    # alarm on the same record, fired the moment the local work finished.
    # With no cluster at all the existing sentence below already says the true
    # thing for every non-local row, so only `local` is pulled out here: two
    # wordings for one situation is how a reader learns to stop reading them.
    ended, unclassified_dead, keep_dead = [], [], []
    for r in dead_reg:
        if r.get("_kind") == "local":
            ended.append(r)
        elif r.get("_kind") == "unclassified" and CLUSTER is not None:
            r["_why"] = ("%s is not a job id of %s (job_id_re) and was not "
                         "registered with --local, so nothing here can say "
                         "whether its work ended" % (r.get("job"), CLUSTER_NAME))
            unclassified_dead.append(r)
        else:
            keep_dead.append(r)
    dead_reg = keep_dead
    # A registered watcher whose pid is gone is either DEAD (its job is still live:
    # alarm) or FINISHED (it exited because its job ended: the normal end of every
    # watcher). Crying DEAD after every campaign trains everyone to ignore it, so
    # FINISHED is reported separately -- but only when the scheduler PROVES the job
    # ended. Not-in-squeue alone is not proof: a failed query looks the same.
    # Raised 2026-09-13 by a production session whose watcher exited as designed.
    finished = []
    if CLUSTER is None:
        # A registration with no cluster to have run its job on. Kept as dead
        # rather than dropped, because something registered it: that is worth a
        # look, and sacct is not there to say it finished.
        for r in dead_reg:
            r["_why"] = "no cluster configured -- cannot tell dead from finished"
    elif cluster_ok:
        gone = {str(r.get("job")) for r in dead_reg if str(r.get("job")) not in jobs}
        fs = final_states(gone)
        keep = []
        for r in dead_reg:
            j = str(r.get("job"))
            st = (fs or {}).get(j)
            if j in jobs:
                r["_why"] = "its job is STILL LIVE"
                keep.append(r)
            elif fs is None:
                r["_why"] = "job not in squeue, but sacct query failed -- cannot tell dead from finished"
                keep.append(r)
            elif st and all(x in TERMINAL for x in st):
                r["_states"] = ",".join(sorted(st)); finished.append(r)
            else:
                r["_why"] = ("sacct does not know job %s -- wrong id in the registration?" % j
                             if not st else "job not in squeue yet sacct says %s" % ",".join(sorted(st)))
                keep.append(r)
        dead_reg = keep
    else:
        for r in dead_reg:
            r["_why"] = "cluster query failed -- cannot tell dead from finished"
    inferred = watchers()          # ADVISORY ONLY -- see fleetregister
    holes = nudge_holes(only)      # local; independent of the cluster query
    attached, attach_err = clients()
    w = reg
    if only:
        # a session asking "what is MY live state?" -- the answer a ledger should
        # defer to rather than duplicate. Match derived owner OR actual watcher,
        # so a session still sees work it watches that is attributed elsewhere.
        jobs = {k: v for k, v in jobs.items()
                if v["owner"] == only or only in [s for s, i in w.items() if k in i]}
        w = {k: v for k, v in w.items() if k == only}
    watched = {j for s in w.values() for j in s}
    rows = []
    for jid, j in sorted(jobs.items()):
        by = [s for s, ids in w.items() if jid in ids]
        rows.append({"job": jid, "tasks": j["tasks"], "states": j["states"],
                     "workdir": j["workdir"], "owner": j["owner"],
                     "reasons": j["reasons"], "held": j["held"],
                     "watched_by": by})
    # monitors pointing at jobs that are no longer live -- minus the ones whose
    # watcher is simply part way through a set it is still polling
    stale, partway, offcluster = (split_stale(w, by_job, jobs, kinds)
                                  if cluster_ok else ([], [], []))

    if want_json:
        # `cluster_ok` is True with no cluster configured: the job list is
        # empty and that emptiness can be trusted, which is all a consumer
        # branching on it has ever asked. `cluster_configured` is for one that
        # wants to say WHY there is no work.
        print(json.dumps({"cluster_ok": cluster_ok,
                          "cluster_configured": CLUSTER is not None,
                          "cluster_last_good": reach_entry.get("last_good"),
                          "cluster_down_for_s": down,
                          "jobs": rows, "stale_watchers": stale,
                          "watchers_partway": partway,
                          "watchers_offcluster": offcluster,
                          "dead_watchers": dead_reg, "finished_watchers": finished,
                          "ended_local": ended,
                          "unclassified_watchers": unclassified_dead,
                          "delivery": holes,
                          "clients": {"attached": attached, "error": attach_err}},
                         indent=1, default=str)); return

    if CLUSTER is None:
        print("no [cluster] configured in fleet.toml -- no cluster work to watch.")
    elif not cluster_ok:
        print("!! CLUSTER QUERY FAILED (ssh %s) -- no job table. This is NOT \"no live"
              " work\";\n   nothing below about live work or watcher coverage can be trusted."
              % CLUSTER["ssh_host"])
        # How LONG, which is the whole difference between a blip and an outage.
        # The sentence above is honest and carries no duration, so a two-minute
        # hiccup and a two-day maintenance window read identically -- and so does
        # a cluster that has never been reachable at all. Three states a reader
        # has to tell apart.
        print("   %s" % down_line(down, reach_entry))
    elif not rows:
        # Naming the filter matters: "no live cluster work for <cluster user>"
        # under a session filter reads as a statement about the whole cluster.
        print("no live cluster work owned or watched by %s." % only if only
              else "no live cluster work for %s." % CLUSTER["user"])
    else:
        print("%-11s %6s  %-28s %-18s %s" % ("JOB", "TASKS", "STATES", "OWNER (derived)", "WATCHED BY"))
        for r in rows:
            st = ",".join(f"{k}:{v}" for k, v in sorted(r["states"].items()))
            print("%-11s %6d  %-28s %-18s %s" % (
                r["job"], r["tasks"], st[:28], r["owner"],
                ", ".join(r["watched_by"]) if r["watched_by"]
                else ("held - nothing to watch" if r["held"] else "*** NOBODY ***")))

    un = [r for r in rows if not r["watched_by"] and not r["held"]]
    held = [r for r in rows if r["held"]]
    if un:
        print("\n!! LIVE WORK WITH NO WATCHER -- no ledger can catch this, because you")
        print("   cannot record the monitor you forgot to create.")
        for r in un:
            print("   %s  %d task(s)  %s" % (r["job"], r["tasks"], r["workdir"]))
        print("   Ask the derived owner to arm one, or confirm it is deliberate.")

    if stale:
        print("\n!! WATCHER ON WORK THAT IS NO LONGER LIVE -- the monitor will not exit")
        print("   if its completion test cannot close. Check it.")
        for s in stale:
            print("   %s watches %s, which is not in squeue" % (s["session"], s["job"]))

    local_live = [r for r in offcluster if r["kind"] == "local"]
    unclassified_live = [r for r in offcluster if r["kind"] != "local"]
    if local_live:
        print("\n   local work, not cluster work (nothing to do): the registered pid")
        print("   IS the work and it is running, which is the whole test. squeue was")
        print("   never asked, because it has nothing to say about a local process.")
        for r in local_live:
            print("   %s / %s  pid %s" % (r["session"], r["job"], r["pid"]))

    if unclassified_live:
        print("\n   registered against something that is not a job id of %s, and not"
              % CLUSTER_NAME)
        print("   declared local -- so NOTHING HERE KNOWS whether the work is still")
        print("   running. The watcher's own pid is alive; that is all this can say.")
        for r in unclassified_live:
            # The command on its own line: a session name and a job name on one
            # line with the whole command ran past 100 columns, and half this
            # fleet's panes are narrower than that.
            print("   %s / %s  pid %s" % (r["session"], r["job"], r["pid"]))
            print("      -> if it is local: fleetregister --local %s %s %s"
                  % (r["session"], r["job"], r["pid"]))

    if partway:
        print("\n   part way through a set (not a fault, and nothing to do): the")
        print("   watcher has finished one job and is still polling others. The")
        print("   registration clears itself when the watcher exits.")
        for s in partway:
            print("   %s / %s done; pid %s still watches %s" %
                  (s["session"], s["job"], s["pid"], ", ".join(s["still_watching"])))
        print("   Do NOT `fleetregister --clear` these: it refuses while the pid is")
        print("   alive, and stopping the watcher would forfeit the jobs above.")

    unreg = sorted({(sess, j) for sess, ids in inferred.items() for j in ids
                    if j not in reg.get(sess, set()) and j in jobs})
    if unreg:
        print("\n   looks like a watcher but is NOT REGISTERED (advisory -- inference,")
        print("   so it may just be a command that mentioned the job):")
        for sess, j in unreg:
            print("   %s / %s   -> fleetregister %s %s <pid>" % (sess, j, sess, j))

    if dead_reg:
        print("\n!! REGISTERED WATCHER IS DEAD -- its pid is gone. Nothing else here")
        print("   detects a watcher that died rather than never existing.")
        for r in dead_reg:
            print("   %s watched %s as pid %s, armed %s" %
                  (r.get("session"), r.get("job"), r.get("pid"), r.get("armed", "?")))
            print("      %s" % r.get("_why", ""))
            print("      registration: %s" % r["_file"])

    if unclassified_dead:
        # Deliberately NOT in the `!!` block. That block means live work may be
        # going unwatched right now, and an unclassified row cannot be that: the
        # test that classified it said its job is not an id of this cluster, so
        # there is no cluster work behind it to be unwatched. What is left is a
        # record to tidy -- most often local work whose owner forgot `--local` --
        # and alarming on a forgotten flag would rebuild, one transition later,
        # the false positive this whole branch removed. Settled 2026-10-27.
        print("\n   a dead registration nothing here can account for: its pid is gone")
        print("   and its job is not an id %s can be asked about, so neither this" % CLUSTER_NAME)
        print("   tool nor the scheduler can say what became of the work.")
        for r in unclassified_dead:
            print("   %s / %s  pid %s, armed %s" %
                  (r.get("session"), r.get("job"), r.get("pid"), r.get("armed", "?")))
            print("      registration: %s" % r["_file"])
        # Both readings, because they want opposite things done. Local work
        # registered without the flag is tidied away; a job id written down wrong
        # means cluster work that has been running with nobody watching it.
        print("   If it was local work, the flag was missed -- re-arm with")
        print("   `fleetregister --local`, or `fleetregister --clear <session> <job>`")
        print("   if it is over. If that was meant to be a job id, it is wrong, and")
        print("   the work it names has had no watcher.")

    if ended:
        print("\n   local work whose process has exited (the normal end of a local job,")
        print("   not a failure). There is no scheduler to say whether it SUCCEEDED, so")
        print("   this is not a claim that it did. Clear when the owner has read the")
        print("   result:")
        for r in ended:
            print("   %s / %s  pid %s   -> fleetregister --clear %s %s" %
                  (r.get("session"), r.get("job"), r.get("pid"),
                   r.get("session"), r.get("job")))

    if finished:
        print("\n   finished (watcher exited, and sacct shows its job ended -- the normal end")
        print("   of a watcher, not a failure). Clear when the owner has read the result:")
        for r in finished:
            print("   %s / %s  %s   -> fleetregister --clear %s %s" %
                  (r.get("session"), r.get("job"), r["_states"], r.get("session"), r.get("job")))

    ua = [r for r in rows if r["owner"] == "UNATTRIBUTED"]
    if ua:
        print("\n!! WorkDir not in [owners] -- add a row to fleet.toml:")
        for r in ua:
            print("   %s  %s" % (r["job"], r["workdir"]))

    if held:
        print("\n   held (no watcher needed -- a held task never starts, so it")
        print("   produces nothing to observe; this flips automatically if released):")
        for r in held:
            print("   %s  %d task(s)  %s" % (r["job"], r["tasks"],
                  ",".join(sorted(r["reasons"]))))

    print_delivery(holes)
    print_clients(attached, attach_err)

    undelivered = (holes["silent"] or holes["pushed"] or holes["dangling"]
                   or holes["unreadable"] or holes["bad_lines"] or holes["mail_stuck"])
    if cluster_ok and not (un or stale or ua or unreg or dead_reg
                           or unclassified_dead or unclassified_live or undelivered):
        print("\nAll live work is watched, every watcher has live work, all owners known,")
        print("and every nudge of the last %d days landed." % holes["days"])

if __name__ == "__main__":
    main()
