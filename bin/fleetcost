#!/usr/bin/env python3
"""fleetcost - what inter-agent chatter actually costs.

Cost of a peer message is not its size. It is size x the number of assistant
turns it then sits through in the receiver's context. Measured on this fleet:
~107x. This script re-measures it.

The bill is not an estimate: every assistant turn carries `message.usage`, so the
tokens actually read are read off the transcript. It used to be guessed at four
characters per token with each turn capped at a 200k-token window, which
UNDER-counted by about half once contexts outgrew that cap -- 88% of turns were
hitting it -- while the output still called itself an over-count (reported
2026-09-30).

Survival is still a model, and now a defensible one: a message is re-read on every
assistant turn until the context holding it is COMPACTED, which is what actually
evicts it. The old byte window modelled a sliding cap that does not exist --
compaction summarizes rather than slides -- and put survival at a third of what
the compaction boundaries in the same transcripts show.

  fleetcost            summary
  fleetcost --senders  per-sender volume
  fleetcost --worst    most expensive individual messages
"""
import json, glob, os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from collections import defaultdict
from fleet import version_flag
from fleet import transcripts

# No character cap any more. One stale constant produced two wrong numbers: it
# truncated the bill AND cut survival short. The bill comes from usage; survival
# ends at a compaction boundary.
ROOT = os.path.expanduser("~/.claude/projects")
# Scan EVERY project dir, not just -home-<user>*. A session whose cwd is outside
# $HOME (e.g. /data/...) lands in its own project dir; globbing
# -home-<user>* skipped it entirely, so its traffic was visible only where a
# scanned peer happened to receive it. Found 2026-08-28 by the session that
# was being undercounted. Never narrow this glob to make a scan cheaper.
PAT = os.path.join(ROOT, "*", "*.jsonl")

def is_boundary(d):
    """A compaction boundary: past it, the message is a summary, not itself.

    A `/clear` needs no case of its own -- it starts a new transcript, so the file
    simply ends."""
    return d.get("subtype") == "compact_boundary" or "compactMetadata" in d

def usage_of(d):
    """(read, written) tokens for one assistant turn, as BILLED, or None.

    Read is input + cache reads + cache writes: every token the model had to be
    given. Cache reads dominate (about 97% here) and are billed at a fraction of
    the input rate, so this is a token count, not a price."""
    m = d.get("message") or {}
    if m.get("role") != "assistant" or not isinstance(m.get("usage"), dict):
        return None
    u = m["usage"]
    return (u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0)
            + u.get("cache_creation_input_tokens", 0),
            u.get("output_tokens", 0))

def scan():
    # Deduped before anything is summed. One session can have its transcript in
    # two project directories after its working directory is renamed, and this
    # sums per FILE: it read 101 transcripts where there were 98, and reported
    # 2,528 peer messages where there were 2,353. Every figure this tool prints
    # was inflated by it, unequally -- the counts by ~7%, the amplification ratio
    # by ~2x, because that ratio's two sums inflate together.
    files = [f for f in transcripts.dedupe_paths(glob.glob(PAT))
             if os.path.getsize(f) > 10_000]
    msgs, turns = [], 0
    bill = {"read": 0, "written": 0, "cache_read": 0, "fresh": 0}
    for f in files:
        try:
            with open(f, errors="ignore") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        recs, is_a, is_b = [], [], []
        for line in lines:
            try:
                d = json.loads(line)
            except ValueError:
                recs.append(None); is_a.append(0); is_b.append(0); continue
            recs.append(d)
            is_a.append(1 if (d.get("message") or {}).get("role") == "assistant" else 0)
            is_b.append(1 if is_boundary(d) else 0)
        for d in recs:
            if not d:
                continue
            u = usage_of(d)
            if u is None:
                continue
            turns += 1
            bill["read"] += u[0]; bill["written"] += u[1]
            cache = (d["message"]["usage"].get("cache_read_input_tokens", 0))
            bill["cache_read"] += cache
            bill["fresh"] += u[0] - cache
        for i, d in enumerate(recs):
            if not d or d.get("type") == "queue-operation":
                continue
            c = d.get("content") or (d.get("message") or {}).get("content")
            if isinstance(c, list):
                c = " ".join(b.get("text", "") if isinstance(b, dict) else str(b) for b in c)
            c = str(c)
            if "cross-session-message" not in c:
                continue
            rr = 0
            for j in range(i, len(lines)):
                if is_b[j]:
                    break              # compacted: what follows re-reads a summary
                rr += is_a[j]
            sender = "unknown"
            k = c.find('from-name=')
            if k >= 0:
                seg = c[k+10:k+80].lstrip('\\"')
                sender = seg.split('"')[0].split('\\')[0]
            msgs.append((sender, len(c), rr, os.path.basename(f)[:8]))
    return files, msgs, bill, turns

def main():
    version_flag()
    files, msgs, bill, turns = scan()
    if not msgs:
        print("no cross-session messages found"); return
    w = sum(m[1] for m in msgs)
    r = sum(m[1] * m[2] for m in msgs)
    surv = sorted(m[2] for m in msgs)
    sizes = sorted(m[1] for m in msgs)
    print("transcripts %d   assistant turns %d" % (len(files), turns))
    # Read off message.usage, not estimated: this is what was given to the model.
    # The cache share matters because those tokens are billed at a fraction of the
    # input rate, so this is a token count and not a price.
    print("tokens READ    %8.2f G   (%.0f%% of them cache reads)"
          % (bill["read"] / 1e9, 100 * bill["cache_read"] / max(bill["read"], 1)))
    print("  fresh + cache writes %6.2f G" % (bill["fresh"] / 1e9))
    print("tokens WRITTEN %8.2f G" % (bill["written"] / 1e9))
    print()
    print("peer messages   %d   mean %d chars   median %d   max %d"
          % (len(msgs), w // len(msgs), sizes[len(sizes)//2], sizes[-1]))
    print("written once    ~%d tok" % (w / 4))
    print("re-read         ~%d tok" % (r / 4))
    print("AMPLIFICATION   %.0fx   median msg survives %d turns to compaction, p90 %d"
          % (r / w, surv[len(surv)//2], surv[int(len(surv)*.9)]))
    print("                (survival is a model: re-read every assistant turn until")
    print("                 the context is compacted. The message sizes either side")
    print("                 of it are characters at 4/token, so the ratio is sound")
    print("                 and the absolutes are approximate.)")
    med = surv[len(surv)//2]
    print()
    print("a 4,000-char peer message costs ~%d tok; at 800 chars, ~%d tok"
          % (1000 * med, 200 * med))
    if "--senders" in sys.argv:
        by = defaultdict(lambda: [0, 0])
        for s, n, _, _ in msgs:
            by[s][0] += 1; by[s][1] += n
        print("\nby sender:")
        for s, (c, n) in sorted(by.items(), key=lambda x: -x[1][1])[:15]:
            print("  %-26s %3d msgs %8d chars  mean %5d" % (s[:26], c, n, n // c))
    if "--worst" in sys.argv:
        print("\nmost expensive single messages:")
        for s, n, rr, fn in sorted(msgs, key=lambda m: -m[1]*m[2])[:10]:
            print("  %6d chars x %4d turns = ~%8d tok  from %-18s [%s]"
                  % (n, rr, n*rr/4, s[:18], fn))

if __name__ == "__main__":
    main()
