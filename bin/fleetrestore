#!/usr/bin/env python3
"""fleetrestore - rebuild the agent fleet from the last fleetsnap manifest.

Prints the plan and does nothing unless given --go. Restores tmux layout, @agent
labels, working directories, and resumes each session by transcript UUID.

It deliberately does NOT restart any compute. Local jobs died with the power cycle
and whether to rerun them is a judgement call, not a recovery step.

  fleetrestore              plan the whole fleet (default; changes nothing)
  fleetrestore NAME...      plan only these sessions
  fleetrestore --go         build it
  fleetrestore --brief      write each session's recovery brief, then show the plan
"""
import json, os, subprocess, sys, argparse, time, shlex
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from fleet import config as fc
from fleet import version_flag
from fleet.panes import LABELS, agent_label
CFG = fc.load()

STATE = fc.state_dir(CFG)

# window index AND the id of the pane it came with, in one query
WIN_FMT = "#{window_index} #{pane_id}"
RECOVERY_DIR = os.path.join(STATE, "recovery")


BRIEF = """# Recovery brief — {label}

Written by `fleetrestore` at {now}. The machine power-cycled; this session was
resumed from its transcript, so your CONTEXT is intact but your RUNTIME is not.

**Assume dead until you have re-armed or re-verified it:**

- every Monitor or watcher you started. Your transcript still shows you creating
  them, and nothing in it will tell you they are gone.
- every local background job, including anything started with `setsid`.
- every cross-session subscription.

**Assume alive:** jobs on a remote cluster, this repo and its working tree, and any
`systemd --user` unit with lingering enabled.

**Do first:** re-read your durable state files ({durable}), re-arm what they say
needs re-arming, then verify cluster state with `sacct`/`squeue` rather than from
memory. Report what you found to the coordinator.

**Before you tell anyone you have not been restarted, call `ListAgents`.** Its
header reports this session's own name. That is the single identity fact
observable from inside a session: a resumed transcript has no seam, so
introspection returns "no restart" with complete confidence and nothing in your
context can contradict it. Three sessions asserted their own continuity wrongly
in two days, including one that had spent that day building identity-verification
tooling. Expertise about a blind spot does not remove the blind spot.

**Audit old records, not just new ones.** Grep your durable files for every claim
attributed to the user. A conclusion stored alone is indistinguishable from a
quotation on re-reading, which is why it survives every later review by its own
author. Where the source sentence is gone and cannot be reconstructed, mark the
entry *paraphrase of unknown fidelity: do not cite it back; confirm if it
becomes load-bearing* rather than leaving it looking like testimony or deleting a
probably-true fact.

**Address peers by what `ListAgents` returns, never by what a manifest assigns.**
The manifest records the name a session is *supposed* to have; `ListAgents` reports
the name it *answers to*. During any partial rename those differ, and a message to
an assigned-but-not-yet-adopted name fails to resolve. That failure is loud, which
makes it the safe one - but only if you never paper over it by guessing.

**And check when your last verification was, not just what it said.** A state you
confirmed clean an hour ago may have been superseded by a scheduled job you never
saw run. "Verified" carries a timestamp whether or not you wrote one down.
"""

# Which tmux server this tool builds on. `$TMUX` is set inside any pane, so a
# fleetrestore run from a pane on ANOTHER server would silently build the fleet
# there. Clearing it makes tmux use the socket it would use from a plain shell,
# which is where the fleet lives; TMUX_TMPDIR still selects a directory, so a test
# can point the whole tool at a throwaway server. `--socket` names one explicitly.
SOCKET = None

def tmux_argv(args):
    return ["tmux"] + (["-L", SOCKET] if SOCKET else []) + list(args)

def tmux_env():
    e = dict(os.environ)
    e.pop("TMUX", None)          # never inherit the caller's server
    return e

def tmux_run(args, **kw):
    """Every tmux call in this tool goes through here, so the server is decided
    once rather than nineteen times."""
    return subprocess.run(tmux_argv(args), env=tmux_env(), **kw)

def run(cmd, go, capture=False):
    argv = tmux_argv(cmd[1:]) if cmd and cmd[0] == "tmux" else cmd
    print(("  $ " if go else "    ") + " ".join(f"'{c}'" if " " in c else c for c in argv))
    if go:
        r = subprocess.run(argv, check=False, env=tmux_env(),
                           capture_output=capture, text=capture)
        return (r.stdout or "").strip() if capture else None
    return None


def windows_by_name(sess):
    """{window_name: [window_id, ...]} for one tmux session, or {} if it has none.

    A restore that creates a window per manifest group is right only when nothing
    is there yet. After liveness filtering, the usual restore is PARTIAL -- one
    session died and its window is still on screen holding its neighbours -- and
    the group must be split into that window instead of templated beside it.
    """
    r = tmux_run(["list-windows", "-t", sess, "-F", "#{window_name}\t#{window_id}"],
                 capture_output=True, text=True)
    if r.returncode != 0:
        return {}
    out = {}
    for line in r.stdout.splitlines():
        name, _, wid = line.partition("\t")
        if name and wid:
            out.setdefault(name, []).append(wid)
    return out


def verify(sessions):
    """[(label, what is wrong)] comparing what tmux now HAS against the manifest.

    The run used to end by telling the human to go and check. It built the thing;
    it can say whether what it built is what was asked for. On 2026-09-30 every
    session came up one pane to the left and nothing in the output said so -- the
    only check that caught it was a human comparing panes by hand afterwards.

    Compares the two facts a restore is responsible for: the agent label on each
    pane, and the directory that pane is in."""
    r = tmux_run(["list-panes", "-a", "-F",
                  LABELS + "\t#{pane_current_path}\t#{pane_id}"],
                 capture_output=True, text=True)
    if r.returncode != 0:
        return [("(all)", "could not list panes to check the restore: "
                          + (r.stderr.strip() or "tmux failed"))]
    have = {}
    for row in r.stdout.splitlines():
        f = row.split("\t")
        if len(f) == 3 and agent_label(f[0]):
            have[agent_label(f[0])] = (f[1], f[2])
    out = []
    for s_ in sessions:
        got = have.get(s_["label"])
        if not got:
            out.append((s_["label"], "no pane carries this @agent label"))
        elif got[0] != s_["cwd"]:
            out.append((s_["label"], f"pane {got[1]} is in {got[0]!r}, "
                                     f"manifest says {s_['cwd']!r}"))
    return out

def main():
    version_flag()
    ap = argparse.ArgumentParser()
    ap.add_argument("sessions", nargs="*", metavar="NAME",
                    help="restore only these sessions (default: all of them)")
    ap.add_argument("--go", action="store_true", help="actually build it")
    ap.add_argument("--brief", action="store_true",
                    help="write each session's recovery brief to "
                         "<state>/recovery/<name>.md")
    ap.add_argument("--socket", metavar="NAME",
                    help="build on the tmux server at this socket (tmux -L NAME) "
                         "instead of the default one")
    ap.add_argument("--stagger", type=float, default=3.0,
                    help="seconds between launches (default 3; avoids a load spike)")
    # `--all` was the whole-fleet path until it was retired: it stood in for
    # "everything is being rebuilt", which the bare command now derives from the
    # manifest instead. argparse would answer it with `unrecognized arguments`
    # and a usage line -- correct, and no help at all to someone whose machine
    # has just come back and who is typing the command they remember. The
    # coordinator typed it on 2026-10-05 preparing a reboot, from a drop written
    # before the flag was removed. Keyed on the flag, so a session LABELLED
    # `all` is still an ordinary positional.
    if "--all" in sys.argv[1:]:
        sys.exit("fleetrestore: --all was retired; the bare command is the "
                 "whole-fleet path and applies each window's exact layout.\n"
                 "  fleetrestore          plan every session in the manifest\n"
                 "  fleetrestore --go     build it\n"
                 "  fleetrestore --brief --go   ... and write each session's "
                 "recovery brief")
    a = ap.parse_args()
    global SOCKET
    SOCKET = a.socket

    path = f"{STATE}/manifest.json"
    if not os.path.exists(path):
        sys.exit(f"no manifest at {path} — run fleetsnap while the fleet is healthy")
    m = json.load(open(path))
    MANIFEST = path

    # Whether the ORIGINAL layout can be reapplied is a fact about what is being
    # rebuilt, not a flag: an exact layout needs every pane that was in the window.
    # `--all` used to stand in for it, and `--all` with three sessions already live
    # still applied a layout that no longer fit. Counted here, BEFORE any filtering,
    # so a named subset is partial too.
    full = len(m["sessions"])

    # A name given on the command line that the manifest does not hold is a typo or
    # a session that was never snapshotted, and silently restoring the rest would
    # read as success. Refuse, the way fleetwatch refuses an unknown session.
    if a.sessions:
        known = {x.get("label") for x in m["sessions"]}
        unknown = [n for n in a.sessions if n not in known]
        if unknown:
            sys.exit(f"not in the manifest: {', '.join(unknown)}\n"
                     f"  it holds: {', '.join(sorted(x for x in known if x))}")
        m["sessions"] = [x for x in m["sessions"] if x.get("label") in set(a.sessions)]

    # liveness: never rebuild a session that is already running
    live = set()
    try:
        out = tmux_run(["list-panes", "-a", "-F", LABELS],
                       capture_output=True, text=True, timeout=5).stdout
        live = {agent_label(l) for l in out.splitlines()}
        live.discard("")
    except Exception:
        pass
    # Parked and retired sessions are declared in fleet.toml by transcript. An older
    # manifest, or a .bak, still lists them; relaunching one would undo a decision
    # the human made. Keyed by uuid, so a new session that reuses the name restores.
    held = fc.stopped_uuids(CFG)
    gone = [x for x in m["sessions"] if x.get("resume_uuid") in held]
    if gone:
        print("\n  not relaunched (fleet.toml): " + ", ".join(
            f"{x['label']} is {held[x['resume_uuid']][1]}" for x in gone))
        m["sessions"] = [x for x in m["sessions"] if x.get("resume_uuid") not in held]
        if not m["sessions"]:
            print("  nothing to restore.\n")
            return
    already = [x["label"] for x in m["sessions"] if x["label"] in live]
    if already:
        print(f"\n  already running, will be skipped: {', '.join(already)}")
        m["sessions"] = [x for x in m["sessions"] if x["label"] not in live]
        if not m["sessions"]:
            print("  nothing to restore.\n")
            return
    age = time.time() - os.path.getmtime(MANIFEST)
    print(f"\n  coordinator: {m.get('coordinator','?')}")
    print(f"  manifest captured {m['captured']}  ({age/3600:.1f} h ago)")
    print(f"  {len(m['sessions'])} sessions, claude {m['installed_claude']}\n")

    # A session the snapshot could not name cannot be relaunched: --name and its
    # brief both need the name, and a made-up one would pin the wrong identity.
    unnamed = [s for s in m["sessions"] if not s.get("label")]
    if unnamed:
        print("  !! not relaunched -- the snapshot could not name these panes; "
              "name them and re-run fleetsnap:")
        for s in unnamed:
            print(f"     pane {s['tmux'].get('pane_id')} in {s['cwd']}  "
                  f"(tmux set -p -t {s['tmux'].get('pane_id')} @agent <name>)")
        print()
        m["sessions"] = [s for s in m["sessions"] if s.get("label")]

    unver = [s for s in m["sessions"] if s["resume_uuid_source"].startswith("UNVER")]
    if unver:
        print("  !! unverified resume targets — check these before --go:")
        for s in unver:
            print(f"     {s['label']}: {s['resume_uuid']}  ({s['resume_uuid_source']})")
        print()

    if a.brief:
        for s in m["sessions"]:
            # NOT the session's cwd: for a repo session that is the repo root,
            # so the brief landed untracked in a work tree -- a public one in at
            # least one case -- and `git add -A` is how most commits are made.
            # Raised independently by four sessions within minutes of the
            # 2026-09-30 restore. The state directory already holds ledgers and
            # watcher registrations; a recovery brief belongs with them.
            os.makedirs(RECOVERY_DIR, exist_ok=True)
            path = os.path.join(RECOVERY_DIR, s["label"] + ".md")
            txt = BRIEF.format(label=s["label"], now=time.strftime("%Y-%m-%d %H:%M"),
                               durable=", ".join(s["durable_files"]) or "none recorded")
            print(f"    write {path}")
            if a.go:
                try:
                    with open(path, "w") as f:
                        f.write(txt)
                except OSError as e:
                    print(f"      ! {e}")
                    continue


    if not a.go:
        print("  PLAN (nothing executed; pass --go to run):\n")

    # group panes by window; create in original pane order, then apply the exact
    # layout tmux itself recorded. Geometry is restored verbatim, not approximated.
    by_win = {}
    for s_ in m["sessions"]:
        by_win.setdefault(s_["tmux"]["window"], []).append(s_)
    sess = m["sessions"][0]["tmux"]["session"]
    # Read ONCE, before anything is built, so a window this run creates is never
    # mistaken for one that was already there.
    on_screen = windows_by_name(sess)
    first = True
    for w in sorted(by_win):
        panes = sorted(by_win[w], key=lambda x: x["tmux"]["pane_index"])
        wname = panes[0]["tmux"].get("window_name")
        # Does a window of this name already exist? Then this group belongs IN it.
        # Keyed on the name and not the manifest's window index, which shifts.
        # `claude` is excluded: automatic-rename writes it over any window whose
        # real name was lost, so it is a collision waiting to happen rather than
        # an identity. The code below already refuses to apply it as a name.
        here = on_screen.get(wname, []) if wname and wname != "claude" else []
        if len(here) > 1:
            # Two windows already carry this name -- which is what this very bug
            # produced before it was fixed. Guessing between them would put a
            # session beside the wrong neighbours; say so and leave it.
            print(f"    !! {len(here)} windows are already named {wname!r} "
                  f"({', '.join(here)}). NOT restoring "
                  f"{', '.join(x['label'] for x in panes)} into any of them -- "
                  f"rename or close all but one, then re-run.")
            continue
        joined = bool(here)
        if joined:
            key = here[0]
            who = ", ".join(x["label"] for x in panes)
            print(f"    (window {wname!r} is already open as {key} — {who} "
                  f"{'joins' if len(panes) == 1 else 'join'} it rather than "
                  f"opening a second window of that name)")
            first_id = None
        elif first:
            exists = tmux_run(["has-session", "-t", sess],
                              capture_output=True).returncode == 0
            if exists:
                print(f"    (tmux session '{sess}' already exists — adding a window to it)")
                got = run(["tmux", "new-window", "-P", "-F", WIN_FMT,
                           "-t", f"{sess}:", "-c", panes[0]["cwd"]], a.go, capture=True)
            else:
                got = run(["tmux", "new-session", "-d", "-P", "-F", WIN_FMT,
                           "-s", sess, "-c", panes[0]["cwd"]], a.go, capture=True)
            first = False
        else:
            got = run(["tmux", "new-window", "-P", "-F", WIN_FMT,
                       "-t", f"{sess}:", "-c", panes[0]["cwd"]], a.go, capture=True)
        if not joined:
            # tmux is the authority on where the window landed; the manifest index
            # is only a fallback for the dry run, which creates nothing to ask about.
            win_s, _, first_id = (got or "").partition(" ")
            win = int(win_s) if win_s.isdigit() else w
            key = f"{sess}:{win}"
        # Pane IDS, captured as each pane is made. Targets used to be computed as
        # "<window>.<index + pane-base-index>", and pane_base_index() asked tmux for
        # that setting BEFORE the first new-session -- so with no server running it
        # got nothing and fell back to 0, while ~/.tmux.conf sets 1. Every session
        # then went one pane to the left: on 2026-09-30 five never started and seven
        # launched in another session's directory. The function existed to fix that
        # exact failure after the 2026-09-09 restore, and could not hold in the one
        # case this tool is for -- a machine that just came back with no server.
        # A %N id cannot be off by one, and survives renumbering too.
        # A created window arrives holding one pane, so the group's first session
        # takes it; a joined window holds other people's panes, so every session
        # in the group needs one of its own.
        pane_ids = [] if joined else [first_id.strip()]
        for extra in panes[len(pane_ids):]:
            pane_ids.append((run(["tmux", "split-window", "-P", "-F", "#{pane_id}",
                                  "-t", key, "-c", extra["cwd"]],
                                 a.go, capture=True) or "").strip())
        # Name the window, then pin it. automatic-rename is ON by default, so a
        # window left unnamed gets renamed to the running command — "claude" —
        # within seconds, and the next fleetsnap records THAT as the window name.
        # The --all path did neither until 2026-09-09, which is how three window
        # names were lost. Restoring names is not cosmetic: it is what
        # stops the next snapshot from overwriting them with the command name.
        if joined:
            # Someone else's window: it already has the right name, and its layout
            # belongs to the sessions living in it. Re-tiling would rearrange panes
            # this restore is not responsible for; tmux has already made room.
            pass
        elif wname and wname != "claude":
            run(["tmux", "rename-window", "-t", key, wname], a.go)
        elif wname == "claude":
            print(f"    ! window {w}: manifest name is 'claude' — automatic-rename "
                  f"had already eaten the real name before that snapshot. "
                  f"Rename it by hand after the restore.")
        if not joined:
            run(["tmux", "set", "-w", "-t", key, "automatic-rename", "off"], a.go)
            lay = m.get("window_layouts", {}).get(f"{sess}:{w}", {})
            partial = len(m["sessions"]) != full
            if lay.get("layout") and not partial:
                run(["tmux", "select-layout", "-t", key, lay["layout"]], a.go)
            else:
                run(["tmux", "select-layout", "-t", key, "tiled"], a.go)   # partial fleet: exact layout would not fit
        for i, s_ in enumerate(panes):
            target = pane_ids[i] if a.go else f"{key}.<pane {i}>"
            if a.go and not target.startswith("%"):
                print(f"    !! no pane id for {s_['label']} -- tmux did not report one. "
                      f"NOT launching it; nothing is typed into a pane this tool "
                      f"cannot name.")
                continue
            if a.go:
                here = (run(["tmux", "display", "-p", "-t", target,
                             "#{pane_current_path}"], a.go, capture=True) or "").strip()
                if here != s_["cwd"]:
                    # Issue 2: a tmux failure never stopped the run, so seven
                    # `claude --resume` lines were typed into the wrong panes.
                    # This catches a pane-mapping bug whatever its cause.
                    print(f"    !! {s_['label']}: pane {target} is in {here!r}, "
                          f"manifest says {s_['cwd']!r}. NOT launching it.")
                    continue
            run(["tmux", "set", "-p", "-t", target, "@agent", s_["label"]], a.go)
            # --name pins the peer-visible session name to the role label, so a
            # restart no longer changes how other sessions address this one.
            # Verified 2026-08-26: `claude --name X` appears verbatim in ListAgents.
            env = fc.launch_env(CFG)
            run(["tmux", "send-keys", "-t", target,
                 (f"{env} " if env else "") +
                 f"claude --name {shlex.quote(s_['label'])} "
                 f"--resume {s_['resume_uuid']}", "Enter"], a.go)
            if a.go and a.stagger:
                time.sleep(a.stagger)

    if a.go:
        bad = verify(m["sessions"])
        if bad:
            print("\n  !! THE RESTORE DID NOT MATCH THE MANIFEST:")
            for label, why in bad:
                print(f"     {label}: {why}")
            print("     Fix these before asking the sessions to do anything.")
        else:
            print("\n  verified: every session's pane carries its @agent label and sits "
                  "in its manifest directory.")
    print(f"\n  After restore: run `fleetsnap` to re-capture, and ask each session to "
          f"confirm it re-armed what its state files require.\n")

if __name__ == "__main__":
    main()
