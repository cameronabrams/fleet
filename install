#!/bin/bash
# install -- link the fleet APPLICATION into place, and this machine's
# CONFIGURATION skills alongside it.
#
#   ./install          show the plan; change nothing (default)
#   ./install --go     do it
#
# Symlinks, not copies: one source of truth, so an edit in the repo is live at
# once. Verified 2026-09-12 that Claude Code discovers a skill whose directory is
# a symlink (a probe skill appeared in the skill listing).
#
# Never silently replaces a REAL file. Anything displaced is moved to
# ~/.local/state/fleet/displaced-<stamp>/ so it can be restored.
set -u

# One version for everything in this repository, read from the one place it is
# written. Answered before argument handling: the tools that follow take a
# positional, and one of them refuses an argument it does not recognize.
case "${1:-}" in
  --version|-V)
    HERE_V=$(dirname "$(readlink -f "$0")")
    echo "$(basename "$0") (fleet $(PYTHONPATH="$HERE_V/.." python3 -c 'import fleet; print(fleet.__version__)'))"
    exit 0 ;;
esac
GO=0; [ "${1:-}" = "--go" ] && GO=1
APP=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CFG=${FLEET_CONFIG:-$HOME/.config/fleet}
BIN=$HOME/bin
SK=$HOME/.claude/skills
STAMP=$(date +%Y%m%d-%H%M%S)
AWAY=$HOME/.local/state/fleet/displaced-$STAMP

# The fresh-machine blocker: nothing else can run without a configuration, so say
# the command that makes one rather than the file to copy. Naming a file to copy
# leaves the human to edit TOML by hand, which is the step `fleetinit` exists to
# remove.
if [ ! -f "$CFG/fleet.toml" ]; then
  echo "no $CFG/fleet.toml yet. Create one:"
  echo
  echo "    $APP/bin/fleetinit --go                       # from the shipped example"
  echo "    $APP/bin/fleetinit --from <a fleet.toml> --go  # from a fleet you already have"
  echo
  echo "  The second carries your own defaults -- name, clusters, thresholds -- and"
  echo "  leaves out the other fleet's roster and history. Run it, then run this again."
  exit 2
fi

# Counted, because `ln` failing used to be printed and then forgotten. On a
# machine with no ~/.claude/skills, every skill link failed and this script still
# exited 0 -- six errors on screen and a success to any caller reading the status,
# which is the one direction an installer must not be wrong in. Found by running
# the fresh-machine path end to end on 2026-10-21, not by a test.
FAILED=0

plan() {   # plan <target> <source>
  local tgt=$1 src=$2
  if [ -L "$tgt" ] && [ "$(readlink -f "$tgt")" = "$(readlink -f "$src")" ]; then
    printf "  ok        %s\n" "$tgt"; return
  fi
  if [ -e "$tgt" ] || [ -L "$tgt" ]; then
    printf "  REPLACE   %s   (existing moved to %s)\n" "$tgt" "$AWAY"
  else
    printf "  link      %s\n" "$tgt"
  fi
  [ $GO = 1 ] || return
  if [ -e "$tgt" ] || [ -L "$tgt" ]; then mkdir -p "$AWAY"; mv "$tgt" "$AWAY/"; fi
  if ! ln -s "$src" "$tgt"; then
    printf "  !! FAILED %s\n" "$tgt"
    FAILED=$((FAILED + 1))
  fi
}

echo "application : $APP"
echo "config      : $CFG"
[ $GO = 1 ] && echo "MODE        : INSTALLING" || echo "MODE        : plan only (./install --go to apply)"
echo
echo "tools -> $BIN"
# Only with --go. A plan that creates directories is not a plan, and this script
# claims to be read-only without it like every tool in bin/. It made ~/bin on a
# dry run for as long as it has existed; adding a second mkdir for the skills
# directory is what made that visible.
[ $GO = 1 ] && mkdir -p "$BIN"
# Executable files only: a __pycache__ left by running a tool is not a tool.
for t in "$APP"/bin/*; do [ -f "$t" ] && [ -x "$t" ] && plan "$BIN/$(basename "$t")" "$t"; done
echo
echo "application skills -> $SK"
# `mkdir -p`, like $BIN above, and for the same reason gated on --go. ~/.claude/skills
# does not exist on a machine where Claude Code has never written a skill, which is
# precisely the fresh machine this script is for -- so the one case it most needed
# to handle was the one it did not.
[ $GO = 1 ] && mkdir -p "$SK"
for s in "$APP"/skills/*/; do [ -d "$s" ] && plan "$SK/$(basename "$s")" "${s%/}"; done
echo
echo "configuration skills -> $SK"
for s in "$CFG"/skills/*/; do [ -d "$s" ] && plan "$SK/$(basename "$s")" "${s%/}"; done
[ $GO = 1 ] && [ -d "$AWAY" ] && echo && echo "displaced originals kept in: $AWAY"

if [ "$FAILED" -gt 0 ]; then
  echo
  echo "!! $FAILED link(s) failed -- the install is INCOMPLETE."
  exit 1
fi

exit 0
